  "paths": {
    "/api/v1/projects/{project_id}/telemetry": {
      "post": {
        "operationId": "publishTelemetry",
        "summary": "完整替换一个主体的遥测观测",
        "description": "需 telemetry:write。指标 observed_at 不得晚于主体 observed_at；未知指标必须填 null（models=[]）。同主体同时间不同数据或同 event_id 不同内容返回 409。迟到观测记入幂等表但 applied=false。",
        "security": [
          {
            "ProjectBearer": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "maxLength": 128
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "maxLength": 128
            },
            "description": "若提供必须与 body.event_id 一致。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Observation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "内容相同的幂等重试，created=false。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "accepted": {
                      "const": true
                    },
                    "created": {
                      "type": "boolean"
                    },
                    "applied": {
                      "type": "boolean"
                    },
                    "project_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "subject_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                    }
                  },
                  "required": [
                    "accepted",
                    "created",
                    "applied",
                    "project_id",
                    "subject_id",
                    "event_id",
                    "observed_at"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "新事件，检查 applied 判断是否更新当前观测。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "accepted": {
                      "const": true
                    },
                    "created": {
                      "type": "boolean"
                    },
                    "applied": {
                      "type": "boolean"
                    },
                    "project_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "subject_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                    }
                  },
                  "required": [
                    "accepted",
                    "created",
                    "applied",
                    "project_id",
                    "subject_id",
                    "event_id",
                    "observed_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "错误响应；客户端只记录 code 与 request_id，不记录凭据。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",

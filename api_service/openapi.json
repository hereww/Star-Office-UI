{
  "openapi": "3.1.0",
  "info": {
    "title": "Star Office Team Telemetry API",
    "version": "1.0.0",
    "description": "公司项目直接上报遥测，无 Sub2API 依赖。读写凭据绑定项目；请求上限 16 KiB，项目最多 500 个稳定主体；每 5 秒重新观测，默认 15 秒过期。重复投递复用完整事件，幂等记录保留 7 天。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:19100",
      "description": "本机开发，生产替换为已部署 HTTPS 地址"
    }
  ],
  "components": {
    "securitySchemes": {
      "ProjectBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "由服务维护者提供的项目写入或读取凭据。"
      }
    },
    "schemas": {
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
          },
          "service_state": {
            "enum": [
              "ready",
              "degraded",
              "offline",
              "unknown"
            ]
          },
          "identity": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "fresh"
                    ]
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "name"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "unavailable",
                      "untracked"
                    ]
                  },
                  "observed_at": {
                    "type": "null"
                  },
                  "name": {
                    "type": "null"
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "name"
                ]
              }
            ]
          },
          "concurrency": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "fresh"
                    ]
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                  },
                  "current": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "current",
                  "limit"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "unavailable",
                      "untracked"
                    ]
                  },
                  "observed_at": {
                    "type": "null"
                  },
                  "current": {
                    "type": "null"
                  },
                  "limit": {
                    "type": "null"
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "current",
                  "limit"
                ]
              }
            ]
          },
          "today_usage": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "fresh"
                    ]
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                  },
                  "total": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "maxLength": 80
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "timezone": {
                    "const": "Asia/Shanghai"
                  },
                  "window_end": {
                    "type": "string",
                    "format": "date-time",
                    "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "total",
                  "date",
                  "timezone",
                  "window_end"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "unavailable",
                      "untracked"
                    ]
                  },
                  "observed_at": {
                    "type": "null"
                  },
                  "total": {
                    "type": "null"
                  },
                  "date": {
                    "type": "null"
                  },
                  "timezone": {
                    "type": "null"
                  },
                  "window_end": {
                    "type": "null"
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "total",
                  "date",
                  "timezone",
                  "window_end"
                ]
              }
            ]
          },
          "active_models": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "fresh",
                      "partial"
                    ]
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "带时区的 ISO 8601 时间；服务端统一为 UTC，最多微秒精度。"
                  },
                  "models": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "requested_model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "upstream_model": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "requests": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,18}$",
                          "description": "正整数字符串，不超过 int64。"
                        }
                      },
                      "required": [
                        "requested_model",
                        "upstream_model",
                        "requests"
                      ]
                    }
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "models"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quality": {
                    "enum": [
                      "unavailable",
                      "untracked"
                    ]
                  },
                  "observed_at": {
                    "type": "null"
                  },
                  "models": {
                    "type": "array",
                    "maxItems": 0
                  }
                },
                "required": [
                  "quality",
                  "observed_at",
                  "models"
                ]
              }
            ]
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "subject_id",
          "observed_at",
          "service_state",
          "identity",
          "concurrency",
          "today_usage",
          "active_models"
        ]
      },

# Standalone provider-neutral API service
API_BIND=127.0.0.1
API_PORT=19100
API_DATA_FILE=/var/lib/star-office-api/state.sqlite3
API_AUTH_MODE=key
# Generated by api-service/bootstrap.py; never commit the real file.
API_PROJECT_KEYS_FILE=/etc/star-office-api/api-project-keys.json
API_TELEMETRY_STALE_SECONDS=15
API_TELEMETRY_RETENTION_DAYS=7
# API_SERVICE_KEY / API_KEY_FILE are only for the older state-event endpoints.
API_ALLOWED_ORIGINS=
API_SNAPSHOT_STALE_SECONDS=30

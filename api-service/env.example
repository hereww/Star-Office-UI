# Standalone provider-neutral API service
API_BIND=127.0.0.1
API_PORT=19100
API_DATA_FILE=/var/lib/star-office-api/state.sqlite3
API_AUTH_MODE=key
# Set exactly one of API_SERVICE_KEY and API_KEY_FILE in deployment.
# API_SERVICE_KEY=replace-with-a-random-value-at-least-24-chars
# API_KEY_FILE=/etc/star-office-api/api-key
API_ALLOWED_ORIGINS=
API_SNAPSHOT_STALE_SECONDS=30

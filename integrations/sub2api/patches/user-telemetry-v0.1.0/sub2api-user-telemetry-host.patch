+}
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+func tokenCategory(s string) string {
+	if s == "" {
+		return "absent"
+	}
+	if strings.HasPrefix(s, "sk-") {
+		return "model key"
+	}
+	if strings.HasPrefix(s, "ui-") {
+		return "UI token"
+	}
+	return "admin token"
+}
+func redactError(w *httptest.ResponseRecorder) string {
+	if w.Code < 400 {
+		return ""
+	}
+	var e struct {
+		Message string `json:"message"`
+	}
+	_ = json.Unmarshal(w.Body.Bytes(), &e)
+	return e.Message
+}
+func tamper(raw []byte) []byte {
+	zr, err := zip.NewReader(bytes.NewReader(raw), int64(len(raw)))
+	must(err)
+	var out bytes.Buffer
+	zw := zip.NewWriter(&out)
+	changed := false
+	for _, f := range zr.File {
+		r, e := f.Open()
+		must(e)
+		b, e := io.ReadAll(r)
+		must(e)
+		r.Close()
+		if !changed && strings.HasPrefix(f.Name, "runtimes/") && len(b) > 0 {
+			b[0] ^= 1
+			changed = true
+		}
+		w, e := zw.Create(f.Name)
+		must(e)
+		_, e = w.Write(b)
+		must(e)
+	}
+	must(zw.Close())
+	if !changed {
+		panic("no runtime to tamper")
+	}
+	return out.Bytes()
+}

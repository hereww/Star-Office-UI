+	return false
+}
+func hasEnabledPluginBinding(bindings []PluginBinding) bool {
+	for _, b := range bindings {
+		if b.Enabled {
+			return true
+		}
+	}
+	return false
+}
+func (m *PluginManager) telemetryAllowedUsers(i *PluginInstallation) ([]string, error) {
+	raw, err := m.decryptConfig(i)
+	if err != nil {
+		return nil, err
+	}
+	config, err := decodePluginTelemetryConfig(raw)
+	if err != nil {
+		return nil, err
+	}
+	return append([]string(nil), config.AllowedUserIDs...), nil
+}
+
+// GetTelemetryAllowedUsers returns the persisted administrator allowlist; never
+// plugin-normalized runtime state. The endpoint/credential layer owns auth.
+func (m *PluginManager) GetTelemetryAllowedUsers(ctx context.Context, id int64) ([]string, error) {
+	i, err := m.repo.GetByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if !telemetryInstallationEnabled(i) {
+		return nil, errors.New("用户 telemetry 插件未启用")
+	}
+	return m.telemetryAllowedUsers(i)
+}
+func (m *PluginManager) UserTelemetry(ctx context.Context, id int64, raw json.RawMessage) (json.RawMessage, error) {
+	readCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	installation, err := m.repo.GetByID(readCtx, id)
+	if err != nil {
+		return nil, err
+	}
+	if !telemetryInstallationEnabled(installation) {
+		return nil, errors.New("用户 telemetry 插件未启用")
+	}
+	configRaw, err := m.decryptConfig(installation)
+	if err != nil {
+		return nil, err
+	}
+	approved, err := decodePluginTelemetryConfig(configRaw)
+	if err != nil {
+		return nil, err
+	}
+	allowed := approved.AllowedUserIDs
+	if len(raw) > pluginConfigMaxBytes {
+		return nil, errors.New("telemetry query 超过大小限制")
+	}
+	query, err := usertelemetry.DecodeQuery(raw)
+	if err != nil {
+		return nil, err
+	}
+	query, err = query.Restrict(allowed)
+	if err != nil {
+		return nil, err
+	}
+	if query.Timezone == "" {
+		query.Timezone = approved.Timezone
+	}
+	if query.PageSize == 0 {
+		query.PageSize = approved.Page
+	}
+	query, _, _, err = query.Normalize(time.Now())
+	if err != nil {
+		return nil, err
+	}
+	m.mu.Lock()
+	runtime := m.runtimes[id]
+	m.mu.Unlock()
+	if runtime == nil || runtime.telemetry == nil || !runtime.hostReady || runtime.client == nil || runtime.client.Exited() || !runtime.beginRequest() {
+		return nil, errors.New("用户 telemetry 插件未就绪")
+	}
+	defer runtime.finishRequest()
+	if runtime.lifetime != nil {
+		stop := context.AfterFunc(runtime.lifetime, cancel)
+		defer stop()
+	}
+	payload, err := json.Marshal(query)
+	if err != nil {
+		return nil, err
+	}
+	response, err := runtime.telemetry.QuerySnapshot(readCtx, wrapperspb.Bytes(payload), grpc.MaxCallRecvMsgSize(pluginv1.UserTelemetryMaxResponseBytes))
+	if err != nil || response == nil {
+		return nil, errors.New("用户 telemetry 查询失败")
+	}
+	if readCtx.Err() != nil || runtime.draining.Load() {
+		return nil, errors.New("用户 telemetry 查询已取消")
+	}
+	latest, err := m.GetTelemetryAllowedUsers(readCtx, id)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := query.Restrict(latest); err != nil {
+		return nil, err
+	}
+	return validatePluginTelemetrySnapshot(response.Value, query)
+}
+
+func (m *PluginManager) reconcileOnce(ctx context.Context) error {
+	m.operationMu.Lock()
+	defer m.operationMu.Unlock()
+	transportErr := m.reconcileTransportOnce(ctx)
+	installations, err := m.repo.List(ctx)
+	if err != nil {
+		m.mu.Lock()
+		stale := []*pluginRuntime{}
+		for id, r := range m.runtimes {
+			if r.installation != nil && r.installation.Manifest.isUserTelemetry() {
+				stale = append(stale, m.removeRuntimeLocked(id))
+			}
+		}
+		m.mu.Unlock()
+		for _, r := range stale {
+			r.drain(5 * time.Second)
+		}
+		return errors.Join(transportErr, err)
+	}
+	active := map[int64]*PluginInstallation{}
+	for _, i := range installations {
+		if i.Manifest.isUserTelemetry() && i.State == PluginStateStarting && m.startingStateExpired(i) {
+			stateErr := m.repo.UpdateState(ctx, i.ID, PluginStateDisabled, "telemetry 插件启动超时，已恢复为停用状态", nil, i.BinarySHA256, PluginStateStarting)
+			if stateErr != nil && !errors.Is(stateErr, ErrPluginStateChanged) {
+				transportErr = errors.Join(transportErr, stateErr)
+			}
+			continue
+		}
+		if hasEnabledTelemetryBinding(i) && (i.State == PluginStateEnabled || i.State == PluginStateError) {
+			active[i.ID] = i
+		}
+	}
+	m.mu.Lock()
+	stale := []*pluginRuntime{}
+	for id, r := range m.runtimes {
+		if r.installation != nil && r.installation.Manifest.isUserTelemetry() && active[id] == nil {
+			stale = append(stale, m.removeRuntimeLocked(id))
+		}
+	}
+	m.mu.Unlock()
+	for _, r := range stale {
+		r.drain(5 * time.Second)
+	}
+	for _, i := range active {
+		if err := m.reconcileTelemetryRuntime(ctx, i); err != nil {
+			stateErr := m.repo.UpdateState(ctx, i.ID, PluginStateError, "用户 telemetry 运行时恢复失败", nil, i.BinarySHA256, i.State)
+			transportErr = errors.Join(transportErr, err, stateErr)
+		}
+	}
+	return transportErr
+}
+func (m *PluginManager) reconcileTelemetryRuntime(ctx context.Context, i *PluginInstallation) error {
+	m.mu.Lock()
+	current := m.runtimes[i.ID]
+	m.mu.Unlock()
+	if current != nil && current.installation.BinarySHA256 == i.BinarySHA256 && current.installation.ConfigEncrypted == i.ConfigEncrypted {
+		healthCtx, cancel := context.WithTimeout(ctx, pluginHealthTimeout)
+		err := current.checkHealth(healthCtx)
+		cancel()
+		if err == nil && current.hostReady {
+			if i.State == PluginStateError {
+				return m.repo.MarkRuntimeHealthy(ctx, i.ID, i.BinarySHA256, i.ConfigEncrypted)
+			}
+			return nil
+		}
+	}
+	if current != nil {
+		m.mu.Lock()
+		stale := m.removeRuntimeLocked(i.ID)
+		m.mu.Unlock()
+		if stale != nil {
+			stale.drain(5 * time.Second)
+		}
+	}
+	local, err := m.ensureLocalInstallation(ctx, i)
+	if err != nil {
+		return err
+	}
+	runtime, err := m.prepareRuntime(ctx, local, true)
+	if err != nil {
+		return err
+	}
+	latest, err := m.repo.GetByID(ctx, i.ID)
+	if err != nil || latest == nil || !hasEnabledTelemetryBinding(latest) || (latest.State != PluginStateEnabled && latest.State != PluginStateError) || latest.BinarySHA256 != i.BinarySHA256 || latest.ConfigEncrypted != i.ConfigEncrypted {
+		runtime.kill()
+		return err
+	}
+	if err := m.repo.MarkRuntimeHealthy(ctx, i.ID, i.BinarySHA256, i.ConfigEncrypted); err != nil {
+		runtime.kill()
+		return err
+	}
+	m.mu.Lock()
+	m.publishRuntimeLocked(latest, runtime)
+	m.mu.Unlock()
+	return nil
+}

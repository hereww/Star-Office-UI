+		pluginv1.RegisterUserTelemetryHostServiceServer(s, server)
+		return s
+	})
+	initCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	response, err := api.InitHostServices(initCtx, &pluginv1.InitHostServicesRequest{HostServiceId: id, HostServiceApiVersion: pluginv1.HostServiceAPIVersion})
+	if err != nil {
+		return fmt.Errorf("初始化 telemetry HostService 失败: %w", err)
+	}
+	if response == nil || !response.Ready {
+		return errors.New("插件未确认 telemetry HostService 就绪")
+	}
+	return nil
+}

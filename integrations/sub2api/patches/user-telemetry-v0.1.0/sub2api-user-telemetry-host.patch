+(async()=>{
+ const executablePath = process.env.TELEMETRY_UI_BROWSER || (fs.existsSync("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome") ? "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" : undefined);

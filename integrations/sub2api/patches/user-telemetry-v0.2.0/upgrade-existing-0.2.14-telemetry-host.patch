+// These are all business tables seeded by this disposable harness. A single
+// statement captures their counts from one PostgreSQL statement snapshot.
+type businessTableBaseline struct {
+	Users     int64
+	APIKeys   int64
+	UsageLogs int64
+}
+
+const businessTableBaselineSQL = `SELECT (SELECT COUNT(*) FROM users), (SELECT COUNT(*) FROM api_keys), (SELECT COUNT(*) FROM usage_logs)`
+
+func readBusinessTableBaseline(ctx context.Context, db *sql.DB) (businessTableBaseline, error) {
+	var baseline businessTableBaseline
+	if err := db.QueryRowContext(ctx, businessTableBaselineSQL).Scan(&baseline.Users, &baseline.APIKeys, &baseline.UsageLogs); err != nil {
+		return businessTableBaseline{}, fmt.Errorf("read uninstall business table baseline: %w", err)
+	}
+	return baseline, nil
+}
+
+func validateUninstallPreservation(before, after businessTableBaseline, credentialCount int64) error {
+	if before != after {
+		return fmt.Errorf("business table row counts changed during uninstall: before=%+v after=%+v; remaining plugin credentials=%d", before, after, credentialCount)
+	}
+	if credentialCount != 0 {
+		return fmt.Errorf("uninstall left %d plugin credentials; business table row counts unchanged=%+v", credentialCount, after)
+	}
+	return nil
+}

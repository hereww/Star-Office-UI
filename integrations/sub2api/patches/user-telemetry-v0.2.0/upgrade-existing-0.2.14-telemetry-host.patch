+func TestTelemetryModelRepoRegisterUpdateReleaseAndTTL(t *testing.T) {
+	c, mr, ctx := telemetryModelRepoFixture(t)
+	id := telemetryModelTestID(1)
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 7, id, "requested"))
+	keys := telemetryActiveModelKeys(7)
+	require.Equal(t, "telemetry:active_models:{7}:expiry", keys[0])
+	require.Equal(t, "telemetry:active_models:{7}:models", keys[1])
+	require.Len(t, mr.Keys(), 2)
+	for _, key := range keys {
+		require.Equal(t, 45*time.Second, mr.TTL(key))
+	}
+	models, err := c.ReadTelemetryActiveModels(ctx, []int64{7})
+	require.NoError(t, err)
+	require.Equal(t, []public.ActiveModel{{RequestedModel: "requested", Requests: 1}}, models[7])
+	alive, err := c.UpdateTelemetryModel(ctx, 7, id, "upstream")
+	require.NoError(t, err)
+	require.True(t, alive)
+	models, err = c.ReadTelemetryActiveModels(ctx, []int64{7})
+	require.NoError(t, err)
+	require.Equal(t, "upstream", *models[7][0].UpstreamModel)
+	mr.FastForward(12 * time.Second)
+	mr.SetTime(time.Date(2026, 10, 8, 12, 0, 12, 0, time.UTC))
+	alive, err = c.RefreshTelemetryModel(ctx, 7, id)
+	require.NoError(t, err)
+	require.True(t, alive)
+	for _, key := range keys {
+		require.Equal(t, 45*time.Second, mr.TTL(key))
+	}
+	require.NoError(t, c.ReleaseTelemetryModel(ctx, 7, id))
+	require.NoError(t, c.ReleaseTelemetryModel(ctx, 7, id))
+	alive, err = c.RefreshTelemetryModel(ctx, 7, id)
+	require.NoError(t, err)
+	require.False(t, alive)
+	alive, err = c.UpdateTelemetryModel(ctx, 7, id, "late")
+	require.NoError(t, err)
+	require.False(t, alive)
+	require.Empty(t, mr.Keys(), "heartbeat/update must not recreate deleted keys")
+}

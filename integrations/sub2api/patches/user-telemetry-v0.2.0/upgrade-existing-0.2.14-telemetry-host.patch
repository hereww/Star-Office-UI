+// Guard the production call sites, not merely the parser's behavior in a
+// standalone harness. The outer account loop and inner concrete attempt must
+// both use the current un-mapped wsAttemptMessage (not the first reqModel).
+func TestTelemetryModelHooksWSCurrentAttemptModelCallSites(t *testing.T) {
+	_, testFile, _, ok := runtime.Caller(0)
+	require.True(t, ok)
+	sourcePath := filepath.Join(filepath.Dir(testFile), "openai_gateway_handler.go")
+	parsed, err := parser.ParseFile(token.NewFileSet(), sourcePath, nil, parser.SkipObjectResolution)
+	require.NoError(t, err)
+	var body *ast.BlockStmt
+	for _, declaration := range parsed.Decls {
+		if function, ok := declaration.(*ast.FuncDecl); ok && function.Name.Name == "ResponsesWebSocket" {
+			body = function.Body
+			break
+		}
+	}
+	require.NotNil(t, body, "inspect the real ResponsesWebSocket handler only")
+	var initial, attempt *ast.AssignStmt
+	var beginAttempt *ast.CallExpr
+	var loops []*ast.ForStmt
+	ast.Inspect(body, func(node ast.Node) bool {
+		switch node := node.(type) {
+		case *ast.ForStmt:
+			loops = append(loops, node)
+		case *ast.AssignStmt:
+			if len(node.Lhs) != 1 || len(node.Rhs) != 1 {
+				return true
+			}
+			left, ok := node.Lhs[0].(*ast.Ident)
+			if !ok {
+				return true
+			}
+			if left.Name == "initialTelemetryRequested" {
+				require.Nil(t, initial, "outer initialization must have one source of truth")
+				initial = node
+			}
+			if left.Name == "attemptTelemetryModel" {
+				if call, ok := node.Rhs[0].(*ast.CallExpr); ok {
+					if name, ok := call.Fun.(*ast.Ident); ok && name.Name == "openAIWSTelemetryAttemptRequestedModel" {
+						require.Nil(t, attempt, "each concrete attempt must have one frame-derived model assignment")
+						attempt = node
+					}
+				}
+			}
+		case *ast.CallExpr:
+			if selector, ok := node.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == "beginTelemetryTurn" && len(node.Args) == 3 {
+				if model, ok := node.Args[2].(*ast.Ident); ok && model.Name == "attemptTelemetryModel" {
+					require.Nil(t, beginAttempt)
+					beginAttempt = node
+				}
+			}
+		}
+		return true
+	})
+	require.NotNil(t, initial, "outer account loop must initialize a requested model")
+	require.NotNil(t, attempt, "inner attempt loop must re-resolve from its current frame")
+	require.NotNil(t, beginAttempt, "the resolved attempt model must reach actual lease registration")
+	for name, assignment := range map[string]*ast.AssignStmt{"outer initialization": initial, "inner attempt": attempt} {
+		call, ok := assignment.Rhs[0].(*ast.CallExpr)
+		require.True(t, ok, name+" must call the production model helper, not assign reqModel")
+		function, ok := call.Fun.(*ast.Ident)
+		require.True(t, ok)
+		require.Equal(t, "openAIWSTelemetryAttemptRequestedModel", function.Name)
+		require.Len(t, call.Args, 2)
+		message, ok := call.Args[0].(*ast.Ident)
+		require.True(t, ok)
+		require.Equal(t, "wsAttemptMessage", message.Name, name+" must resolve the current public retry frame")
+	}
+	innermostLoop := func(position token.Pos) *ast.ForStmt {
+		var found *ast.ForStmt
+		for _, loop := range loops {
+			if loop.Pos() < position && position < loop.End() && (found == nil || loop.Pos() > found.Pos()) {
+				found = loop
+			}
+		}
+		return found
+	}
+	outerLoop := innermostLoop(initial.Pos())
+	innerLoop := innermostLoop(attempt.Pos())
+	require.NotNil(t, outerLoop)
+	require.NotNil(t, innerLoop)
+	require.NotSame(t, outerLoop, innerLoop, "the two guards must cover distinct outer-account and inner-attempt loops")
+	require.True(t, outerLoop.Pos() < innerLoop.Pos() && innerLoop.End() < outerLoop.End())
+	require.Same(t, innerLoop, innermostLoop(beginAttempt.Pos()))
+	require.True(t, attempt.End() < beginAttempt.Pos(), "resolve the current frame before registering its lease")
+	ast.Inspect(innerLoop.Body, func(node ast.Node) bool {
+		assignment, ok := node.(*ast.AssignStmt)
+		if !ok || assignment.Pos() <= attempt.Pos() || assignment.Pos() >= beginAttempt.Pos() {
+			return true
+		}
+		for _, target := range assignment.Lhs {
+			if identifier, ok := target.(*ast.Ident); ok {
+				require.NotEqual(t, "attemptTelemetryModel", identifier.Name, "no stale model overwrite is allowed between frame resolution and registration")
+			}
+		}
+		return true
+	})
+}

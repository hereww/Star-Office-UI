+func TestTelemetryModelHooksMainHandlerOrderingContractParsesAndGuardsCallSites(t *testing.T) {
+	_, testFile, _, ok := runtime.Caller(0)
+	require.True(t, ok)
+	sourcePath := filepath.Join(filepath.Dir(testFile), "openai_gateway_handler.go")
+	source, err := os.ReadFile(sourcePath)
+	require.NoError(t, err)
+	_, err = parser.ParseFile(token.NewFileSet(), sourcePath, source, parser.SkipObjectResolution)
+	require.NoError(t, err, "main handler must remain syntactically parseable")
+	text := string(source)
+
+	beforeRequest := strings.Index(text, "BeforeRequest: func")
+	mapRequestModel := strings.Index(text, "MapRequestModel: func")
+	beforeTurn := strings.Index(text, "BeforeTurn: func")
+	require.GreaterOrEqual(t, beforeRequest, 0)
+	require.Greater(t, mapRequestModel, beforeRequest)
+	require.Greater(t, beforeTurn, mapRequestModel)
+
+	storeModel := strings.Index(text, "turnTelemetryRequested.Store(&model)")
+	require.Greater(t, storeModel, beforeRequest, "WS BeforeRequest must freeze the current public model")
+	require.Less(t, storeModel, mapRequestModel, "model B must be stored before mapping")
+
+	turnSection := text[beforeTurn:]
+	require.Contains(t, turnSection, "releaseTelemetryOnly()")
+	beginTurn := strings.Index(turnSection, "beginTelemetryTurn(c, apiKey.UserID, telemetryRequested)")
+	require.GreaterOrEqual(t, beginTurn, 0)
+	releaseBeforeBegin := strings.LastIndex(turnSection[:beginTurn], "releaseTelemetryOnly()")
+	require.GreaterOrEqual(t, releaseBeforeBegin, 0, "each turn must retire the prior telemetry lease before replacing it")
+	require.Contains(t, text, "defer releaseTelemetryOnly()", "each proxy attempt needs scoped telemetry cleanup on handshake early return")
+}

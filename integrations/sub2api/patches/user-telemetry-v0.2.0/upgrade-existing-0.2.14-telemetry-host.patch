+func TestTelemetryModelOptionalNoopAndValidation(t *testing.T) {
+	var nilService *ConcurrencyService
+	require.Nil(t, nilService.BeginTelemetryModel(context.Background(), 1, "m"))
+	require.Nil(t, NewConcurrencyService(nil).BeginTelemetryModel(context.Background(), 1, "m"))
+	// Embedding only the existing interface deliberately does not implement the new one.
+	unsupported := struct{ ConcurrencyCache }{}
+	require.Nil(t, NewConcurrencyService(unsupported).BeginTelemetryModel(context.Background(), 1, "m"))
+	c := newTelemetryModelTestCache()
+	s := NewConcurrencyService(c)
+	for _, model := range []string{"", "   ", "a\nb", "a\x00b", "a\x7fb", "a\u0085b", "a\u200bb", strings.Repeat("a", 201), string([]byte{255})} {
+		require.Nil(t, s.BeginTelemetryModel(context.Background(), 1, model), "%q", model)
+	}
+	require.True(t, ValidTelemetryModelName(strings.Repeat("a", 200)))
+	require.False(t, ValidTelemetryModelName(strings.Repeat("猫", 67)))
+	require.Nil(t, s.BeginTelemetryModel(context.Background(), 0, "m"))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.Nil(t, s.BeginTelemetryModel(ctx, 1, "m"))
+	require.Empty(t, c.registerIDs)
+	var nilLease *TelemetryModelLease
+	zeroLease := &TelemetryModelLease{}
+	zeroLease.UpdateUpstream("m")
+	zeroLease.Release()
+	nilLease.Release()
+	nilLease.UpdateUpstream("model")
+	nilLease.refresh()
+	UpdateTelemetryModelFromContext(nil, "m")
+	UpdateTelemetryModelFromContext(context.Background(), "m")
+	UpdateTelemetryModelFromContext(WithTelemetryModelLease(nil, nil), "m")
+}

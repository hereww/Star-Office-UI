+func readHandlerTelemetryModels(t *testing.T, concurrency *service.ConcurrencyService, userIDs ...int64) map[int64][]serviceActiveModelView {
+	t.Helper()
+	models, err := concurrency.ReadTelemetryActiveModels(context.Background(), userIDs)
+	require.NoError(t, err)
+	out := make(map[int64][]serviceActiveModelView, len(models))
+	for userID, entries := range models {
+		for _, entry := range entries {
+			view := serviceActiveModelView{requested: entry.RequestedModel, requests: entry.Requests}
+			if entry.UpstreamModel != nil {
+				view.upstream = *entry.UpstreamModel
+				view.hasUpstream = true
+			}
+			out[userID] = append(out[userID], view)
+		}
+	}
+	return out
+}
+
+type serviceActiveModelView struct {
+	requested   string
+	upstream    string
+	hasUpstream bool
+	requests    int
+}

+package telemetry
+
+import (
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	public "github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+)
+
+func validTokenTotal(value *string) bool {
+	if value == nil {
+		return true
+	}
+	if len(*value) == 0 || len(*value) > 128 || (len(*value) > 1 && (*value)[0] == '0') {
+		return false
+	}
+	for _, r := range *value {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+func validModelName(value string) bool {
+	if len(value) == 0 || len(value) > 200 || !utf8.ValidString(value) || strings.TrimSpace(value) == "" {
+		return false
+	}
+	for _, r := range value {
+		if unicode.IsControl(r) || unicode.Is(unicode.Cf, r) {
+			return false
+		}
+	}
+	return true
+}
+func validObservation(value *string) bool {
+	if value == nil {
+		return false
+	}
+	_, err := time.Parse(time.RFC3339Nano, *value)
+	return err == nil
+}
+func validDailyValue(day *public.DailyTokenUsage) bool {
+	if day == nil || !validTokenTotal(day.Total) {
+		return false
+	}
+	switch day.Quality {
+	case "fresh":
+		return day.Total != nil && validObservation(day.ObservedAt)
+	case "partial":
+		return day.Total != nil && validObservation(day.ObservedAt)
+	case "unavailable":
+		return day.Total == nil && day.ObservedAt == nil
+	default:
+		return false
+	}
+}
+
+// Calendar windows are independent of the caller-selected query window, but
+// must be a coherent same-timezone pair, not unlabelled arbitrary aggregates.
+func validDailyUsage(usage public.TokenUsage, timezone string) bool {
+	if !validTokenTotal(usage.Total) {
+		return false
+	}
+	if usage.Today == nil && usage.Yesterday == nil {
+		return true
+	} // old plugin/host
+	if !validDailyValue(usage.Today) || !validDailyValue(usage.Yesterday) {
+		return false
+	}
+	loc, err := time.LoadLocation(timezone)
+	if err != nil {
+		return false
+	}
+	start, err := time.Parse(time.RFC3339Nano, usage.Today.Start)
+	if err != nil {
+		return false
+	}
+	end, err := time.Parse(time.RFC3339Nano, usage.Today.End)
+	if err != nil {
+		return false
+	}
+	start = start.In(loc)
+	midnight := time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, loc)
+	if !start.Equal(midnight) || end.Before(start) || !end.Before(midnight.AddDate(0, 0, 1)) {
+		return false
+	}
+	if usage.Today.Date != midnight.Format("2006-01-02") {
+		return false
+	}
+	prevStart, err := time.Parse(time.RFC3339Nano, usage.Yesterday.Start)
+	if err != nil {
+		return false
+	}
+	prevEnd, err := time.Parse(time.RFC3339Nano, usage.Yesterday.End)
+	if err != nil {
+		return false
+	}
+	return prevStart.Equal(midnight.AddDate(0, 0, -1)) && prevEnd.Equal(midnight) && usage.Yesterday.Date == midnight.AddDate(0, 0, -1).Format("2006-01-02")
+}
+func validActiveModels(snapshot *public.ActiveModelSnapshot) bool {
+	if snapshot == nil {
+		return true
+	}
+	switch snapshot.Quality {
+	case "unavailable":
+		return len(snapshot.Models) == 0 && snapshot.ObservedAt == nil
+	case "fresh", "partial":
+		if snapshot.Models == nil || !validObservation(snapshot.ObservedAt) {
+			return false
+		}
+	default:
+		return false
+	}
+	count := 0
+	seen := map[string]bool{}
+	for _, model := range snapshot.Models {
+		if !validModelName(model.RequestedModel) || (model.UpstreamModel != nil && !validModelName(*model.UpstreamModel)) || model.Requests < 1 || model.Requests > 10000-count {
+			return false
+		}
+		key := model.RequestedModel + "\x00"
+		if model.UpstreamModel != nil {
+			key += *model.UpstreamModel
+		}
+		if seen[key] {
+			return false
+		}
+		seen[key] = true
+		count += model.Requests
+	}
+	return true
+}

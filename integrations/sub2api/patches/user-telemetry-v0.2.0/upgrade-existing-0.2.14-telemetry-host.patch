+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	public "github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+)
+
+const (
+	TelemetryModelLeaseTTL          = 45 * time.Second
+	telemetryModelHeartbeatInterval = 12 * time.Second
+	telemetryModelOperationTimeout  = 2 * time.Second
+	telemetryModelWriteTimeout      = 100 * time.Millisecond
+	TelemetryActiveModelMaxRequests = 10000
+)
+
+var ErrTelemetryActiveModelsUnavailable = errors.New("telemetry active model cache unavailable")
+
+// TelemetryActiveModelCache is optional: it does not alter ConcurrencyCache or
+// admission control. Refresh and Update MUST only mutate existing, unexpired
+// leases; neither may resurrect a released lease. Reads must return an entry
+// (including an empty slice) for each requested user, and no other users.
+type TelemetryActiveModelCache interface {
+	RegisterTelemetryModel(context.Context, int64, string, string) error
+	RefreshTelemetryModel(context.Context, int64, string) (bool, error)
+	UpdateTelemetryModel(context.Context, int64, string, string) (bool, error)
+	ReleaseTelemetryModel(context.Context, int64, string) error
+	ReadTelemetryActiveModels(context.Context, []int64) (map[int64][]public.ActiveModel, error)
+}
+
+// ValidTelemetryModelName bounds both Redis payloads and public output. The
+// limit is 200 UTF-8 bytes (not runes); blank, invalid UTF-8, control and invisible
+// format characters are rejected. The original spelling is otherwise retained.
+func ValidTelemetryModelName(model string) bool {
+	if len(model) == 0 || len(model) > 200 || !utf8.ValidString(model) || strings.TrimSpace(model) == "" {
+		return false
+	}
+	for _, r := range model {
+		if unicode.IsControl(r) || unicode.Is(unicode.Cf, r) {
+			return false
+		}
+	}
+	return true
+}
+
+// TelemetryModelLease is metadata only. Its opaque random identity is private
+// and unrelated to gateway request IDs, API keys, accounts or request contents.
+// All writes are serialized under mu, including deletion. A failed model update
+// retires the lease instead of heartbeating a knowingly stale upstream model.
+// Redis outages may leave the last value until its bounded TTL; never block or
+// cancel the business request because telemetry failed.
+type TelemetryModelLease struct {
+	mu      sync.Mutex
+	cache   TelemetryActiveModelCache
+	ctx     context.Context
+	userID  int64
+	leaseID string
+	stopped bool
+	stop    chan struct{}
+	done    chan struct{}
+}
+
+// BeginTelemetryModel must be called AFTER admission and just before forwarding.
+// Missing support, invalid inputs and registration failure return a nil no-op
+// lease. It never cancels ctx and never changes business concurrency slots.
+func (s *ConcurrencyService) BeginTelemetryModel(ctx context.Context, userID int64, requestedModel string) *TelemetryModelLease {
+	if s == nil || s.cache == nil || userID <= 0 || !ValidTelemetryModelName(requestedModel) {
+		return nil
+	}
+	cache, ok := s.cache.(TelemetryActiveModelCache)
+	if !ok {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if ctx.Err() != nil {
+		return nil
+	}
+	var random [16]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return nil
+	}
+	l := &TelemetryModelLease{cache: cache, ctx: ctx, userID: userID, leaseID: hex.EncodeToString(random[:]), stop: make(chan struct{}), done: make(chan struct{})}
+	opCtx, cancel := context.WithTimeout(ctx, telemetryModelWriteTimeout)
+	err := cache.RegisterTelemetryModel(opCtx, userID, l.leaseID, requestedModel)
+	cancel()
+	// An error can mean the write succeeded but its acknowledgement was lost.
+	// Always attempt detached cleanup; TTL is the final safety net.
+	if err != nil || ctx.Err() != nil {
+		l.Release()
+		return nil
+	}
+	go l.run(telemetryModelHeartbeatInterval)
+	return l
+}
+
+func (l *TelemetryModelLease) run(interval time.Duration) {
+	defer close(l.done)
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-l.stop:
+			return
+		case <-l.ctx.Done():
+			l.Release()
+			return
+		case <-ticker.C:
+			l.refresh()
+		}
+	}
+}
+
+func (l *TelemetryModelLease) refresh() {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.stopped {
+		return
+	}
+	if l.cache == nil || l.ctx == nil || l.ctx.Err() != nil {
+		l.releaseLocked()
+		return
+	}
+	ctx, cancel := context.WithTimeout(l.ctx, telemetryModelOperationTimeout)
+	alive, err := l.cache.RefreshTelemetryModel(ctx, l.userID, l.leaseID)
+	cancel()
+	if l.ctx.Err() != nil || (err == nil && !alive) {
+		l.releaseLocked()
+	}
+	// A transient refresh error is allowed to recover, but the cache must reject
+	// an expired lease. Thus recovery cannot resurrect a crashed/expired request.
+}
+
+func (l *TelemetryModelLease) UpdateUpstream(model string) {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.stopped {
+		return
+	}
+	if l.cache == nil || l.ctx == nil || l.ctx.Err() != nil || !ValidTelemetryModelName(model) {
+		l.releaseLocked()
+		return
+	}
+	ctx, cancel := context.WithTimeout(l.ctx, telemetryModelWriteTimeout)
+	alive, err := l.cache.UpdateTelemetryModel(ctx, l.userID, l.leaseID, model)
+	cancel()
+	if err != nil || !alive || l.ctx.Err() != nil {
+		l.releaseLocked()
+	}
+}
+
+// Release is nil-safe and idempotent. On return no local writer can perform a
+// later heartbeat/update. Cleanup is detached from the cancelled request and
+// bounded to 100 milliseconds; if Redis is unreachable the record expires naturally.
+func (l *TelemetryModelLease) Release() {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if !l.stopped {
+		l.releaseLocked()
+	}
+}
+
+func (l *TelemetryModelLease) releaseLocked() {
+	l.stopped = true
+	if l.stop != nil {
+		close(l.stop)
+	}
+	if l.cache == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), telemetryModelWriteTimeout)
+	defer cancel()
+	_ = l.cache.ReleaseTelemetryModel(ctx, l.userID, l.leaseID)
+}
+
+type telemetryModelLeaseContextKey struct{}
+
+func WithTelemetryModelLease(ctx context.Context, lease *TelemetryModelLease) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, telemetryModelLeaseContextKey{}, lease)
+}
+
+// UpdateTelemetryModelFromContext is safe on routes with no telemetry hook.
+func UpdateTelemetryModelFromContext(ctx context.Context, upstream string) {
+	if ctx == nil {
+		return
+	}
+	lease, _ := ctx.Value(telemetryModelLeaseContextKey{}).(*TelemetryModelLease)
+	lease.UpdateUpstream(upstream)
+}
+
+// ReadTelemetryActiveModels never broadens scope or treats Redis failure as
+// idle. The caller must report unavailable on error, not substitute empty data.
+func (s *ConcurrencyService) ReadTelemetryActiveModels(ctx context.Context, userIDs []int64) (map[int64][]public.ActiveModel, error) {
+	ids, err := TelemetryActiveModelUserScope(userIDs)
+	if err != nil {
+		return nil, err
+	}
+	if len(ids) == 0 {
+		return map[int64][]public.ActiveModel{}, nil
+	}
+	if s == nil || s.cache == nil {
+		return nil, ErrTelemetryActiveModelsUnavailable
+	}
+	cache, ok := s.cache.(TelemetryActiveModelCache)
+	if !ok {
+		return nil, ErrTelemetryActiveModelsUnavailable
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(ctx, telemetryModelOperationTimeout)
+	defer cancel()
+	models, err := cache.ReadTelemetryActiveModels(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	if len(models) != len(ids) {
+		return nil, fmt.Errorf("telemetry model cache returned incomplete or excess user scope")
+	}
+	for _, id := range ids {
+		entries, exists := models[id]
+		if !exists {
+			return nil, fmt.Errorf("telemetry model cache returned incomplete user scope")
+		}
+		count := 0
+		for _, model := range entries {
+			if !ValidTelemetryModelName(model.RequestedModel) || (model.UpstreamModel != nil && !ValidTelemetryModelName(*model.UpstreamModel)) || model.Requests <= 0 || model.Requests > TelemetryActiveModelMaxRequests-count {
+				return nil, fmt.Errorf("invalid telemetry active model snapshot")
+			}
+			count += model.Requests
+		}
+	}
+	return models, nil
+}
+
+// TelemetryActiveModelUserScope validates and canonicalizes an explicit bounded
+// set. An empty set means no users, NEVER all users. Duplicates are harmless.
+func TelemetryActiveModelUserScope(userIDs []int64) ([]int64, error) {
+	if len(userIDs) > public.MaxPageSize {
+		return nil, fmt.Errorf("telemetry model scope exceeds %d users", public.MaxPageSize)
+	}
+	seen := make(map[int64]bool, len(userIDs))
+	ids := make([]int64, 0, len(userIDs))
+	for _, id := range userIDs {
+		if id <= 0 {
+			return nil, fmt.Errorf("invalid telemetry model user ID")
+		}
+		if !seen[id] {
+			ids = append(ids, id)
+			seen[id] = true
+		}
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	return ids, nil
+}

+func TestTelemetryModelRepoExactExpiryBoundary(t *testing.T) {
+	c, mr, ctx := telemetryModelRepoFixture(t)
+	id := telemetryModelTestID(1)
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 1, id, "m"))
+	// SetTime advances Redis TIME without expiring the physical keys. The
+	// per-member score must reject ownership exactly at the boundary anyway.

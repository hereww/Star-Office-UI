+		{"blank model falls back", `{"model":"  "}`, " public-A ", "public-A"},
+		{"null model falls back", `{"model":null}`, "public-A", "public-A"},
+		{"numeric model falls back", `{"model":429}`, "public-A", "public-A"},
+		{"boolean model falls back", `{"model":true}`, "public-A", "public-A"},
+		{"array model falls back", `{"model":["upstream-B"]}`, "public-A", "public-A"},
+		{"object model falls back", `{"model":{"name":"upstream-B"}}`, "public-A", "public-A"},
+		{"nested upstream model is not public model", `{"response":{"model":"upstream-B"}}`, "public-B", "public-B"},
+		{"malformed JSON falls back", `{"model":"public-B"`, "public-A", "public-A"},
+		{"trailing JSON falls back", `{"model":"public-B"} {}`, "public-A", "public-A"},
+		{"empty message falls back", "", " public-A ", "public-A"},
+		{"no model or fallback remains unknown", `{}`, "  ", ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.want, openAIWSTelemetryAttemptRequestedModel([]byte(tc.message), tc.fallback))
+		})

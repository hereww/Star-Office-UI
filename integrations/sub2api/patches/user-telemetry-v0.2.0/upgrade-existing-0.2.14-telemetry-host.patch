+func TestTelemetryModelUpdateFailureOrInvalidModelRetiresLease(t *testing.T) {
+	for _, scenario := range []string{"redis-error", "invalid-model", "missing"} {
+		t.Run(scenario, func(t *testing.T) {
+			c := newTelemetryModelTestCache()
+			lease := NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m")
+			require.NotNil(t, lease)
+			t.Cleanup(lease.Release)
+			model := "upstream"
+			switch scenario {
+			case "redis-error":
+				c.updateErr = errors.New("redis failure")
+			case "invalid-model":
+				model = "a\nb"
+			case "missing":
+				c.mu.Lock()
+				delete(c.records[1], lease.leaseID)
+				c.mu.Unlock()
+			}
+			lease.UpdateUpstream(model)
+			waitTelemetryModelDone(t, lease)
+			lease.refresh()
+			require.Zero(t, c.recordCount())
+			require.Zero(t, c.refreshCalls)
+		})
+	}
+}

+	attempt2 := newTelemetryModelGinContext(t, service.WithCompositeRouteDecision(parent, service.CompositeRouteDecision{
+		Matched: true, Source: service.CompositeRouteSourceExplicit,
+		PublicModel: "requested-new", TargetPlatform: service.PlatformOpenAI,

+func TestTelemetryModelHooksWSBeforeRequestBeforeTurnMapOrderUpdatesRequestedB(t *testing.T) {
+	helper, concurrency, parent := newTelemetryModelHandlerFixture(t)
+	const userID int64 = 49
+	c := newTelemetryModelGinContext(t, service.WithCompositeRouteDecision(parent, service.CompositeRouteDecision{
+		Matched: true, Source: service.CompositeRouteSourceExplicit,
+		PublicModel: "first-frame-public-A", TargetPlatform: service.PlatformOpenAI,
+	}))
+
+	// Establish the previous turn so the harness also verifies old-lease
+	// retirement before the new turn starts.
+	oldRelease := helper.beginTelemetryTurn(c, userID, "turn-A")
+	service.SetOpsUpstreamModel(c, "upstream-A")
+	oldRelease()
+
+	var sequence []string
+	var turnModel string
+	var currentRelease func()
+	beforeRequest := func(model string) {
+		sequence = append(sequence, "BeforeRequest")
+		// This is the production fix: freeze the current public model before
+		// BeforeTurn; MapRequestModel must not be the first writer.
+		turnModel = model
+	}
+	beforeTurn := func() {
+		sequence = append(sequence, "BeforeTurn")
+		if currentRelease != nil {
+			currentRelease()
+		}
+		currentRelease = helper.beginTelemetryTurn(c, userID, turnModel)
+	}
+	mapRequestModel := func() string {
+		sequence = append(sequence, "MapRequestModel")
+		service.SetOpsUpstreamModel(c, "upstream-B")
+		return "mapped-B"
+	}
+
+	beforeRequest("turn-B")
+	beforeTurn()
+	require.Equal(t, []string{"BeforeRequest", "BeforeTurn"}, sequence)
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		userID: {{requested: "turn-B", requests: 1}},
+	}, readHandlerTelemetryModels(t, concurrency, userID), "requested B must be registered before mapping")
+
+	require.Equal(t, "mapped-B", mapRequestModel())
+	require.Equal(t, []string{"BeforeRequest", "BeforeTurn", "MapRequestModel"}, sequence)
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		userID: {{requested: "turn-B", upstream: "upstream-B", hasUpstream: true, requests: 1}},
+	}, readHandlerTelemetryModels(t, concurrency, userID))
+	currentRelease()
+	require.Eventually(t, func() bool {
+		return len(readHandlerTelemetryModels(t, concurrency, userID)[userID]) == 0
+	}, time.Second, 5*time.Millisecond)
+}

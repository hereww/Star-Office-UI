+// Controlled HTTP bridge upstream: no remote network/provider is contacted.
+// Blocking each actual Do call allows telemetry to be sampled while the real
+// ResponsesWebSocket handler, scheduler, parser and Redis lease are in flight.
+type telemetryModelWSRetryHTTPCall struct {
+	accountID int64
+	payload   []byte
+	response  chan *http.Response
+}
+
+type telemetryModelWSRetryHTTPUpstream struct {
+	service.HTTPUpstream
+	calls chan telemetryModelWSRetryHTTPCall
+	stop  <-chan struct{}
+}
+
+func (u *telemetryModelWSRetryHTTPUpstream) Do(req *http.Request, _ string, accountID int64, _ int) (*http.Response, error) {
+	payload, err := io.ReadAll(req.Body)
+	if err != nil {
+		return nil, err
+	}
+	_ = req.Body.Close()
+	call := telemetryModelWSRetryHTTPCall{accountID: accountID, payload: payload, response: make(chan *http.Response, 1)}
+	select {
+	case u.calls <- call:
+	case <-u.stop:
+		return nil, fmt.Errorf("telemetry websocket test stopped")
+	case <-req.Context().Done():
+		return nil, req.Context().Err()
+	}
+	select {
+	case response := <-call.response:
+		return response, nil
+	case <-u.stop:
+		return nil, fmt.Errorf("telemetry websocket test stopped")
+	case <-req.Context().Done():
+		return nil, req.Context().Err()
+	}
+}

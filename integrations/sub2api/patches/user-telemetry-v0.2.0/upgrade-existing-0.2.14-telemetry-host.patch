+// Admin telemetry is direct versioned JSON. Only preview metadata is modeled here.
+export interface PluginDailyTokenUsage {
+  date: string
+  start: string
+  end: string
+  total: string | null
+  quality: string
+  observed_at: string | null
+}
+
+export interface PluginActiveModelSnapshot {
+  models: { requested_model: string; upstream_model: string | null; requests: number }[]
+  quality: 'fresh' | 'partial' | 'unavailable'
+  observed_at: string | null
+}
+
+export interface PluginUserTelemetryUser {
+  user_id: string
+  username: string
+  email: string
+  token_usage: {
+    total: string | null
+    today?: PluginDailyTokenUsage
+    yesterday?: PluginDailyTokenUsage
+  }
+  active_models?: PluginActiveModelSnapshot
+  concurrency: { current: number | null; limit: number }
+  quality: { concurrency: string }
+  observed_at: { concurrency: string | null }
+}
+
+export interface PluginUserTelemetrySnapshot {
+  schema_version: number
+  window: { start: string; end: string; timezone: string }
+  users: PluginUserTelemetryUser[]
+  next_cursor: string | null
+}
+
+export async function getUserTelemetry(
+  id: number,
+  cursor?: string
+): Promise<PluginUserTelemetrySnapshot> {
+  // apiClient unwraps management envelopes only; do not unwrap this direct JSON again.
+  const { data } = await apiClient.get<PluginUserTelemetrySnapshot>(
+    `/admin/plugins/${id}/user-telemetry`,
+    cursor ? { params: { cursor } } : undefined
+  )
+  return data
+}

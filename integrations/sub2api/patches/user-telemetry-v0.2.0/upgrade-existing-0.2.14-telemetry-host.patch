+type telemetryModelTestCache struct {
+	ConcurrencyCache                                        // No unrelated admission-control method is invoked.
+	mu                                                      sync.Mutex
+	records                                                 map[int64]map[string]public.ActiveModel
+	registerErr, refreshErr, updateErr, releaseErr, readErr error
+	missing                                                 bool
+	refreshCalls, updateCalls, releaseCalls                 int
+	registerIDs                                             []string
+	readIDs                                                 []int64
+	readOverride                                            map[int64][]public.ActiveModel
+	updateStarted, unblockUpdate                            chan struct{}
+	releaseCtxErr                                           error
+}
+
+func newTelemetryModelTestCache() *telemetryModelTestCache {
+	return &telemetryModelTestCache{records: make(map[int64]map[string]public.ActiveModel)}
+}
+func (c *telemetryModelTestCache) RegisterTelemetryModel(ctx context.Context, id int64, lease, model string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.records[id] == nil {
+		c.records[id] = make(map[string]public.ActiveModel)
+	}
+	c.records[id][lease] = public.ActiveModel{RequestedModel: model, Requests: 1}
+	c.registerIDs = append(c.registerIDs, lease)
+	return c.registerErr // Can model a write with lost acknowledgement.
+}
+func (c *telemetryModelTestCache) RefreshTelemetryModel(ctx context.Context, id int64, lease string) (bool, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.refreshCalls++
+	_, ok := c.records[id][lease]
+	return ok && !c.missing, c.refreshErr
+}
+func (c *telemetryModelTestCache) UpdateTelemetryModel(ctx context.Context, id int64, lease, model string) (bool, error) {
+	if c.updateStarted != nil {
+		close(c.updateStarted)
+		select {
+		case <-c.unblockUpdate:
+		case <-ctx.Done():
+			return false, ctx.Err()
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.updateCalls++
+	old, exists := c.records[id][lease]
+	if exists && c.updateErr == nil {
+		old.UpstreamModel = &model
+		c.records[id][lease] = old
+	}
+	return exists, c.updateErr
+}
+func (c *telemetryModelTestCache) ReleaseTelemetryModel(ctx context.Context, id int64, lease string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.releaseCalls++
+	c.releaseCtxErr = ctx.Err()
+	if c.releaseErr == nil {
+		delete(c.records[id], lease)
+	}
+	return c.releaseErr
+}
+func (c *telemetryModelTestCache) ReadTelemetryActiveModels(ctx context.Context, ids []int64) (map[int64][]public.ActiveModel, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readIDs = append([]int64(nil), ids...)
+	if c.readErr != nil {
+		return nil, c.readErr
+	}
+	if c.readOverride != nil {
+		return c.readOverride, nil
+	}
+	out := make(map[int64][]public.ActiveModel)
+	for _, id := range ids {
+		out[id] = []public.ActiveModel{}
+		for _, model := range c.records[id] {
+			out[id] = append(out[id], model)
+		}
+	}
+	return out, nil
+}
+func (c *telemetryModelTestCache) recordCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := 0
+	for _, records := range c.records {
+		n += len(records)
+	}
+	return n
+}
+func waitTelemetryModelDone(t *testing.T, lease *TelemetryModelLease) {
+	t.Helper()
+	select {
+	case <-lease.done:
+	case <-time.After(time.Second):
+		t.Fatal("telemetry heartbeat did not stop")
+	}
+}

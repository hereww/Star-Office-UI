+func TestTelemetryModelBeginUpdateContextAndRelease(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	s := NewConcurrencyService(c)
+	lease := s.BeginTelemetryModel(context.Background(), 7, "client-model")
+	require.NotNil(t, lease)
+	t.Cleanup(lease.Release)
+	require.Len(t, lease.leaseID, 32)
+	_, err := hex.DecodeString(lease.leaseID)
+	require.NoError(t, err)
+	data, err := s.ReadTelemetryActiveModels(context.Background(), []int64{7, 8})
+	require.NoError(t, err)
+	require.Equal(t, []public.ActiveModel{{RequestedModel: "client-model", Requests: 1}}, data[7])
+	require.Empty(t, data[8])
+	UpdateTelemetryModelFromContext(WithTelemetryModelLease(context.Background(), lease), "mapped-model")
+	data, err = s.ReadTelemetryActiveModels(context.Background(), []int64{7})
+	require.NoError(t, err)
+	require.Equal(t, "mapped-model", *data[7][0].UpstreamModel)
+	lease.refresh()
+	lease.Release()
+	lease.Release()
+	lease.UpdateUpstream("other")
+	lease.refresh()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+	require.Equal(t, 1, c.updateCalls)
+	require.Equal(t, 1, c.refreshCalls)
+	require.Equal(t, 1, c.releaseCalls)
+	data, err = s.ReadTelemetryActiveModels(context.Background(), []int64{7})
+	require.NoError(t, err)
+	require.NotNil(t, data[7])
+	require.Empty(t, data[7])
+	// Lease internals cannot leak through the public DTO.
+	require.Equal(t, 3, reflect.TypeOf(public.ActiveModel{}).NumField())
+}

+func TestTelemetryModelHeartbeatFailureRecoveryAndLeaseLoss(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	lease := NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m")
+	require.NotNil(t, lease)
+	t.Cleanup(lease.Release)
+	c.refreshErr = errors.New("temporary failure")
+	lease.refresh()
+	require.Equal(t, 1, c.recordCount())
+	c.refreshErr = nil
+	lease.refresh()
+	c.missing = true
+	lease.refresh()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+	require.Equal(t, 3, c.refreshCalls)
+}

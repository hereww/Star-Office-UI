+package handler
+
+import (
+	"sync"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+// beginTelemetryForward is called only after admission/slots, around a live
+// forwarding attempt. It never inspects prompts or any credential. The existing
+// effective-upstream-model hook updates the lease immediately before dispatch.
+func (h *ConcurrencyHelper) beginTelemetryForward(c *gin.Context, userID int64, model string) func() {
+	if h == nil || h.concurrencyService == nil || c == nil || c.Request == nil {
+		return func() {}
+	}
+	return h.beginTelemetryTurn(c, userID, clientRequestedModel(c, model))
+}
+
+// beginTelemetryTurn takes the explicit per-turn public model. A WebSocket may
+// change models while its original HTTP context still records the first model.
+func (h *ConcurrencyHelper) beginTelemetryTurn(c *gin.Context, userID int64, model string) func() {
+	if h == nil || h.concurrencyService == nil || c == nil || c.Request == nil {
+		return func() {}
+	}
+	lease := h.concurrencyService.BeginTelemetryModel(c.Request.Context(), userID, model)
+	c.Request = c.Request.WithContext(service.WithTelemetryModelLease(c.Request.Context(), lease))
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			if lease != nil {
+				lease.Release()
+			}
+		})
+	}
+}

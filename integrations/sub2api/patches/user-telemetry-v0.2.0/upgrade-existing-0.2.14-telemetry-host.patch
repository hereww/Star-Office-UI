+	service.SetOpsUpstreamModel(attempt2, "upstream-new")
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		userID: {{requested: "requested-new", upstream: "upstream-new", hasUpstream: true, requests: 1}},
+	}, readHandlerTelemetryModels(t, concurrency, userID))
+	release2()
+	require.Eventually(t, func() bool {
+		return len(readHandlerTelemetryModels(t, concurrency, userID)[userID]) == 0
+	}, time.Second, 5*time.Millisecond)
+
+	// The production heartbeat is 12 seconds. Wait beyond it to prove the
+	// attempt-scoped release did not merely hide a lease that later reappears.
+	time.Sleep(12500 * time.Millisecond)
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID))
+}

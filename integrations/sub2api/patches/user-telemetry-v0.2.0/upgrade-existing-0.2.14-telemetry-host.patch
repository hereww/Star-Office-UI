+func TestTelemetryModelHooksHTTPBeginReadsPublicModelAndTracksActualFailover(t *testing.T) {
+	helper, concurrency, ctx := newTelemetryModelHandlerFixture(t)
+	ctx = service.WithCompositeRouteDecision(ctx, service.CompositeRouteDecision{
+		Matched:        true,
+		Source:         service.CompositeRouteSourceExplicit,
+		PublicModel:    "public-alias",
+		TargetPlatform: service.PlatformOpenAI,
+		UpstreamModel:  "mapped-before-forward",
+	})
+	c := newTelemetryModelGinContext(t, ctx)
+
+	release := helper.beginTelemetryForward(c, 41, "fallback-upstream-model")
+	models := readHandlerTelemetryModels(t, concurrency, 41)
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		41: {{requested: "public-alias", requests: 1}},
+	}, models)
+
+	service.SetOpsUpstreamModel(c, "actual-first-attempt")
+	models = readHandlerTelemetryModels(t, concurrency, 41)
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		41: {{requested: "public-alias", upstream: "actual-first-attempt", hasUpstream: true, requests: 1}},
+	}, models)
+
+	// A failover attempt must replace the live upstream model, not create a
+	// second stale model for the same lease.
+	service.SetOpsUpstreamModel(c, "actual-failover-attempt")
+	models = readHandlerTelemetryModels(t, concurrency, 41)
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		41: {{requested: "public-alias", upstream: "actual-failover-attempt", hasUpstream: true, requests: 1}},
+	}, models)
+
+	release()
+	require.Eventually(t, func() bool {
+		models := readHandlerTelemetryModels(t, concurrency, 41)
+		return len(models[41]) == 0
+	}, time.Second, 5*time.Millisecond)
+}

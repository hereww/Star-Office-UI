+		{"Shanghai after midnight", "2026-10-03T16:00:00.000000001Z", "Asia/Shanghai", "2026-10-04T00:00:00+08:00", "2026-10-03T00:00:00+08:00", 24},
+		{"UTC", "2026-10-04T08:30:00Z", "UTC", "2026-10-04T00:00:00Z", "2026-10-03T00:00:00Z", 24},
+		{"New York spring DST yesterday", "2026-03-09T12:30:00Z", "America/New_York", "2026-03-09T00:00:00-04:00", "2026-03-08T00:00:00-05:00", 23},
+		{"New York fall DST yesterday", "2026-11-02T12:30:00Z", "America/New_York", "2026-11-02T00:00:00-05:00", "2026-11-01T00:00:00-04:00", 25},
+		{"New York spring today", "2026-03-08T12:30:00Z", "America/New_York", "2026-03-08T00:00:00-05:00", "2026-03-07T00:00:00-05:00", 24},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			svc, mock := newTelemetryTestService(t, nil)
+			now, err := time.Parse(time.RFC3339Nano, test.now)
+			require.NoError(t, err)
+			loc, err := time.LoadLocation(test.zone)
+			require.NoError(t, err)
+			svc.now = func() time.Time { return now }
+			todayStart, err := time.Parse(time.RFC3339Nano, test.todayStart)
+			require.NoError(t, err)
+			yesterdayStart, err := time.Parse(time.RFC3339Nano, test.yesterdayStart)
+			require.NoError(t, err)
+			expectTelemetryOneUser(mock, 5, "active")
+			expectTelemetryEmptyKeys(mock)
+			// An explicit past window also lets daily totals represent empty today
+			// at exactly midnight without changing Normalize's existing semantics.
+			mock.ExpectQuery(userTelemetryTokensSQL).WithArgs("{1}", sqlmock.AnyArg(), sqlmock.AnyArg()).WillReturnRows(telemetryTokensRows().AddRow(1, "17"))
+			mock.ExpectQuery(userTelemetryDailyTokensSQL).WithArgs("{1}", yesterdayStart.In(loc), todayStart.In(loc), now.In(loc)).WillReturnRows(telemetryDailyTokensRows())
+			query := fmt.Sprintf(`{"user_ids":["1"],"start":"2020-01-01T00:00:00Z","end":"2020-01-02T00:00:00Z","timezone":%q}`, test.zone)
+			snapshot, _ := readTelemetrySnapshot(t, svc, query)
+			usage := snapshot.Users[0].TokenUsage
+			require.Equal(t, "17", *usage.Total, "selected window total must not change to the daily sum")
+			require.Equal(t, test.todayStart[:10], usage.Today.Date)
+			require.Equal(t, test.yesterdayStart[:10], usage.Yesterday.Date)
+			require.Equal(t, test.todayStart, usage.Today.Start)
+			require.Equal(t, now.In(loc).Format(time.RFC3339Nano), usage.Today.End)
+			require.Equal(t, test.yesterdayStart, usage.Yesterday.Start)
+			require.Equal(t, test.todayStart, usage.Yesterday.End)
+			require.Equal(t, time.Duration(test.yesterdayHours)*time.Hour, todayStart.Sub(yesterdayStart))
+			for _, day := range []*usertelemetry.DailyTokenUsage{usage.Today, usage.Yesterday} {
+				require.Equal(t, "0", *day.Total)
+				require.Equal(t, "fresh", day.Quality)
+				require.NotNil(t, day.ObservedAt)
+			}
+		})
+	}
+}

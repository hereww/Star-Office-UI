+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+// Exercise the actual cache implementation, not a stub or private Redis keys.
+// A missing sorted set must produce an explicit confirmed-zero entry on a
+// successful batch, while a Redis failure must produce an error, never a zero.
+func TestUserTelemetryCacheBatchConfirmedZeroAndLiveOccupancy(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	cache := NewConcurrencyCache(client, 15, 900)
+	concurrency := service.NewConcurrencyService(cache)
+	ctx := context.Background()
+	const userID int64 = 9007199254740993
+	users := []service.UserWithConcurrency{{ID: userID, MaxConcurrency: 5}, {ID: userID + 1, MaxConcurrency: 5}}
+	load, err := concurrency.GetUsersLoadBatch(ctx, users)
+	require.NoError(t, err)
+	require.Len(t, load, 2)
+	for _, user := range users {
+		require.NotNil(t, load[user.ID])
+		require.Equal(t, user.ID, load[user.ID].UserID)
+		require.Zero(t, load[user.ID].CurrentConcurrency)
+	}
+	acquired, err := cache.AcquireUserSlot(ctx, userID, 5, "telemetry-test-regular-slot")
+	require.NoError(t, err)
+	require.True(t, acquired)
+	live, ok := cache.(service.LiveConcurrencyCache)
+	require.True(t, ok)
+	acquired, err = live.AcquireLiveLease(ctx, 41, 5, userID, 5, 42, "telemetry-test-live-slot", false)
+	require.NoError(t, err)
+	require.True(t, acquired)
+	load, err = concurrency.GetUsersLoadBatch(ctx, users)
+	require.NoError(t, err)
+	require.Equal(t, 2, load[userID].CurrentConcurrency)
+	require.Zero(t, load[userID+1].CurrentConcurrency)
+	require.NoError(t, cache.ReleaseUserSlot(ctx, userID, "telemetry-test-regular-slot"))
+	require.NoError(t, live.ReleaseLiveLease(ctx, 41, userID, 42, "telemetry-test-live-slot"))
+	load, err = concurrency.GetUsersLoadBatch(ctx, users)
+	require.NoError(t, err)
+	require.Zero(t, load[userID].CurrentConcurrency)
+}
+
+func TestUserTelemetryReaderActualRedisSuccessAndFailure(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		name := "confirmed_zero"
+		if failed {
+			name = "redis_failure"
+		}
+		t.Run(name, func(t *testing.T) {
+			server := miniredis.RunT(t)
+			client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+			t.Cleanup(func() { _ = client.Close() })
+			cache := NewConcurrencyCache(client, 15, 900)
+			if failed {
+				require.NoError(t, client.Close())
+				load, err := cache.GetUsersLoadBatch(context.Background(), []service.UserWithConcurrency{{ID: 1, MaxConcurrency: 5}})
+				require.Error(t, err)
+				require.Nil(t, load)
+			}
+			db, mock, err := sqlmock.New()
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				mock.ExpectClose()
+				require.NoError(t, db.Close())
+				require.NoError(t, mock.ExpectationsWereMet())
+			})
+			mock.ExpectQuery(`^SELECT id, email, username, concurrency, status`).WithArgs("{1}", int64(0), 101).
+				WillReturnRows(sqlmock.NewRows([]string{"id", "email", "username", "concurrency", "status"}).AddRow(1, "a@example.test", "", 5, "disabled"))
+			mock.ExpectQuery(`^SELECT id, user_id, name, status`).WithArgs("{1}", 10001).
+				WillReturnRows(sqlmock.NewRows([]string{"id", "user_id", "name", "status"}))
+			mock.ExpectQuery(`^SELECT user_id,`).WithArgs("{1}", sqlmock.AnyArg(), sqlmock.AnyArg()).
+				WillReturnRows(sqlmock.NewRows([]string{"user_id", "total"}))
+			svc := service.NewUserTelemetryService(db, service.NewConcurrencyService(cache))
+			raw, err := svc.ReadUserTelemetry(context.Background(), json.RawMessage(`{"user_ids":["1"],"start":"2020-01-01T00:00:00Z","end":"2020-01-02T00:00:00Z"}`))
+			require.NoError(t, err)
+			var snapshot usertelemetry.Snapshot
+			require.NoError(t, json.Unmarshal(raw, &snapshot))
+			user := snapshot.Users[0]
+			if failed {
+				require.Nil(t, user.Concurrency.Current)
+				require.Nil(t, user.ObservedAt.Concurrency)
+				require.Equal(t, "unavailable", user.Quality.Concurrency)
+			} else {
+				require.NotNil(t, user.Concurrency.Current)
+				require.Zero(t, *user.Concurrency.Current)
+				require.NotNil(t, user.ObservedAt.Concurrency)
+				require.Equal(t, "fresh", user.Quality.Concurrency)
+			}
+		})
+	}
+}
diff --git a/backend/internal/repository/user_telemetry_credentials.go b/backend/internal/repository/user_telemetry_credentials.go
new file mode 100644
index 000000000..c71798109
--- /dev/null
+++ b/backend/internal/repository/user_telemetry_credentials.go
@@ -0,0 +1,81 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+type userTelemetryCredentialStore struct{ db *sql.DB }
+
+func NewUserTelemetryCredentialStore(db *sql.DB) service.UserTelemetryCredentialStore {
+	return &userTelemetryCredentialStore{db}
+}
+func (s *userTelemetryCredentialStore) Create(ctx context.Context, c *service.UserTelemetryCredential) error {
+	raw, err := json.Marshal(c.UserIDs)
+	if err != nil {
+		return err
+	}
+	return s.db.QueryRowContext(ctx, `INSERT INTO sub2api_user_telemetry_credentials(plugin_id,name,user_ids,token_hash,expires_at) VALUES($1,$2,$3,$4,$5) RETURNING id,created_at`, c.PluginID, c.Name, raw, c.TokenHash, c.ExpiresAt).Scan(&c.ID, &c.CreatedAt)
+}
+func (s *userTelemetryCredentialStore) Authenticate(ctx context.Context, pluginID int64, hash []byte) (*service.UserTelemetryCredential, error) {
+	c, err := scanTelemetryCredential(s.db.QueryRowContext(ctx, telemetryCredentialSelect+` WHERE plugin_id=$1 AND token_hash=$2 AND revoked_at IS NULL AND expires_at>NOW()`, pluginID, hash))
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, service.ErrTelemetryUnauthorized
+	}
+	return c, err
+}
+func (s *userTelemetryCredentialStore) List(ctx context.Context, id, cursor int64, pageSize int) (*service.UserTelemetryCredentialPage, error) {
+	if cursor < 0 || pageSize < 1 || pageSize > 500 {
+		return nil, fmt.Errorf("invalid credential page")
+	}
+	rows, err := s.db.QueryContext(ctx, telemetryCredentialSelect+` WHERE plugin_id=$1 AND ($2::bigint=0 OR id<$2) ORDER BY id DESC LIMIT $3`, id, cursor, pageSize+1)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := &service.UserTelemetryCredentialPage{Credentials: make([]service.UserTelemetryCredential, 0, pageSize)}
+	for rows.Next() {
+		c, e := scanTelemetryCredential(rows)
+		if e != nil {
+			return nil, e
+		}
+		if len(out.Credentials) == pageSize {
+			next := strconv.FormatInt(out.Credentials[len(out.Credentials)-1].ID, 10)
+			out.NextCursor = &next
+			break
+		}
+		out.Credentials = append(out.Credentials, *c)
+	}
+	return out, rows.Err()
+}
+func (s *userTelemetryCredentialStore) Revoke(ctx context.Context, pluginID, id int64) error {
+	r, err := s.db.ExecContext(ctx, `UPDATE sub2api_user_telemetry_credentials SET revoked_at=COALESCE(revoked_at,NOW()) WHERE plugin_id=$1 AND id=$2`, pluginID, id)
+	if err != nil {
+		return err
+	}
+	n, err := r.RowsAffected()
+	if err == nil && n != 1 {
+		return service.ErrTelemetryCredentialNotFound
+	}
+	return err
+}
+
+const telemetryCredentialSelect = `SELECT id,plugin_id,name,user_ids,token_hash,expires_at,created_at,revoked_at FROM sub2api_user_telemetry_credentials`
+
+func scanTelemetryCredential(s interface{ Scan(...any) error }) (*service.UserTelemetryCredential, error) {
+	c := new(service.UserTelemetryCredential)
+	var raw []byte
+	if err := s.Scan(&c.ID, &c.PluginID, &c.Name, &raw, &c.TokenHash, &c.ExpiresAt, &c.CreatedAt, &c.RevokedAt); err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(raw, &c.UserIDs); err != nil {
+		return nil, err
+	}
+	return c, nil
+}

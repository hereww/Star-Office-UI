+func TestUserTelemetryDailyBoundsFrozenAcrossMidnight(t *testing.T) {
+	svc, mock := newTelemetryTestService(t, nil)
+	now := time.Date(2026, 10, 3, 15, 59, 59, 0, time.UTC)
+	calls := 0
+	svc.now = func() time.Time {
+		instant := now.Add(time.Duration(calls) * time.Second)
+		calls++
+		return instant
+	}
+	expectTelemetryOneUser(mock, 5, "active")
+	expectTelemetryEmptyKeys(mock)
+	loc, err := time.LoadLocation("Asia/Shanghai")
+	require.NoError(t, err)
+	mock.ExpectQuery(userTelemetryTokensSQL).WithArgs("{1}", sqlmock.AnyArg(), now.In(loc)).WillReturnRows(telemetryTokensRows())
+	mock.ExpectQuery(userTelemetryDailyTokensSQL).WithArgs("{1}", time.Date(2026, 10, 2, 0, 0, 0, 0, loc), time.Date(2026, 10, 3, 0, 0, 0, 0, loc), now.In(loc)).WillReturnRows(telemetryDailyTokensRows().AddRow(1, "3", "5"))
+	snapshot, _ := readTelemetrySnapshot(t, svc, `{"user_ids":["1"]}`)
+	usage := snapshot.Users[0].TokenUsage
+	require.Equal(t, "2026-10-03", usage.Today.Date)
+	require.Equal(t, "2026-10-02", usage.Yesterday.Date)
+	require.Equal(t, "2026-10-03T23:59:59+08:00", snapshot.Window.End)
+	require.Equal(t, snapshot.Window.End, usage.Today.End)
+	require.Equal(t, now.Add(4*time.Second).Format(time.RFC3339Nano), *usage.Today.ObservedAt)
+	require.Equal(t, 5, calls)
+}

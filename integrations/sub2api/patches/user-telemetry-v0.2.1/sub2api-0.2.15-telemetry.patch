+	preservationDetail := ""
+	if preservationErr != nil {
+		preservationDetail = preservationErr.Error()
+	}
+	verify("uninstall revokes credentials without deleting business data", preservationErr == nil, preservationDetail)
+	rep.Passed = true
+	fmt.Printf("Acceptance passed: %d checks; no production services touched.\n", len(rep.Checks))
+}
+
+// These are all business tables seeded by this disposable harness. A single
+// statement captures their counts from one PostgreSQL statement snapshot.
+type businessTableBaseline struct {
+	Users     int64
+	APIKeys   int64
+	UsageLogs int64
+}
+
+const businessTableBaselineSQL = `SELECT (SELECT COUNT(*) FROM users), (SELECT COUNT(*) FROM api_keys), (SELECT COUNT(*) FROM usage_logs)`
+
+func readBusinessTableBaseline(ctx context.Context, db *sql.DB) (businessTableBaseline, error) {
+	var baseline businessTableBaseline
+	if err := db.QueryRowContext(ctx, businessTableBaselineSQL).Scan(&baseline.Users, &baseline.APIKeys, &baseline.UsageLogs); err != nil {
+		return businessTableBaseline{}, fmt.Errorf("read uninstall business table baseline: %w", err)
+	}
+	return baseline, nil
+}
+
+func validateUninstallPreservation(before, after businessTableBaseline, credentialCount int64) error {
+	if before != after {
+		return fmt.Errorf("business table row counts changed during uninstall: before=%+v after=%+v; remaining plugin credentials=%d", before, after, credentialCount)
+	}
+	if credentialCount != 0 {
+		return fmt.Errorf("uninstall left %d plugin credentials; business table row counts unchanged=%+v", credentialCount, after)
+	}
+	return nil
+}
+
+func seed(db *sql.DB) error {
+	_, err := db.Exec(`CREATE TABLE users(id BIGINT PRIMARY KEY,email TEXT NOT NULL,username TEXT NOT NULL DEFAULT '',concurrency INT NOT NULL,status TEXT NOT NULL DEFAULT 'active',deleted_at TIMESTAMPTZ);CREATE TABLE api_keys(id BIGINT PRIMARY KEY,user_id BIGINT NOT NULL REFERENCES users(id),key TEXT NOT NULL,name TEXT NOT NULL,status TEXT NOT NULL,deleted_at TIMESTAMPTZ);CREATE TABLE usage_logs(id BIGSERIAL PRIMARY KEY,user_id BIGINT,api_key_id BIGINT,input_tokens INT NOT NULL DEFAULT 0,output_tokens INT NOT NULL DEFAULT 0,cache_creation_tokens INT NOT NULL DEFAULT 0,cache_read_tokens INT NOT NULL DEFAULT 0,created_at TIMESTAMPTZ NOT NULL);
+ INSERT INTO users VALUES(42,'fixture42@example.com','研发助手',5,'active',NULL),(43,'fixture43@example.com','',5,'active',NULL),(44,'fixture44@example.com','不限并发',0,'active',NULL),(9007199254740993,'fixture-large@example.com','大ID',5,'active',NULL);
+ INSERT INTO api_keys VALUES(101,42,'do-not-export-key-1','工作A','active',NULL),(102,42,'do-not-export-key-2','工作B','disabled',NULL),(103,42,'do-not-export-deleted','历史','active',NOW()),(104,43,'do-not-export-other','其他用户','active',NULL);
+ INSERT INTO usage_logs(user_id,api_key_id,input_tokens,output_tokens,cache_creation_tokens,cache_read_tokens,created_at) VALUES(42,101,100,50,20,30,'2026-10-03T08:00:00+08:00'),(42,103,5,5,0,0,'2026-10-03T08:10:00+08:00'),(43,104,900,100,0,0,'2026-10-03T08:20:00+08:00'),(42,101,999,999,0,0,'2026-10-02T23:59:59+08:00'),(42,101,999,999,0,0,'2026-10-04T00:00:00+08:00');`)
+	return err
+}
+
+func validateAcceptanceMetadata(hostVersion, hostBase, reportDate string) error {
+	if hostVersion == "" {
+		return fmt.Errorf("--host-version is required")
+	}
+	if !isStrictSemver(hostVersion) {
+		return fmt.Errorf("--host-version must be a valid semver without a leading v")
+	}
+	if len(hostBase) != 40 {
+		return fmt.Errorf("--host-base must be a 40-character SHA")
+	}
+	if _, err := hex.DecodeString(hostBase); err != nil {
+		return fmt.Errorf("--host-base must be a 40-character hexadecimal SHA")
+	}
+	parsedDate, err := time.Parse("2006-01-02", reportDate)
+	if err != nil || parsedDate.Format("2006-01-02") != reportDate {
+		return fmt.Errorf("--report-date must be a valid YYYY-MM-DD date")
+	}
+	return nil
+}
+
+func isStrictSemver(version string) bool {
+	if version == "" || version != strings.TrimSpace(version) || strings.HasPrefix(version, "v") || !semver.IsValid("v"+version) {
+		return false
+	}
+	coreEnd := len(version)
+	if separator := strings.IndexAny(version, "-+"); separator >= 0 {
+		coreEnd = separator
+	}
+	return len(strings.Split(version[:coreEnd], ".")) == 3
+}
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+func tokenCategory(s string) string {
+	if s == "" {
+		return "absent"
+	}
+	if strings.HasPrefix(s, "sk-") {
+		return "model key"
+	}
+	if strings.HasPrefix(s, "ui-") {
+		return "UI token"
+	}
+	return "admin token"
+}
+func redactError(w *httptest.ResponseRecorder) string {
+	if w.Code < 400 {
+		return ""
+	}
+	var e struct {
+		Message string `json:"message"`
+	}
+	_ = json.Unmarshal(w.Body.Bytes(), &e)
+	return e.Message
+}
+func tamper(raw []byte) []byte {
+	zr, err := zip.NewReader(bytes.NewReader(raw), int64(len(raw)))
+	must(err)
+	var out bytes.Buffer
+	zw := zip.NewWriter(&out)
+	changed := false
+	for _, f := range zr.File {
+		r, e := f.Open()
+		must(e)
+		b, e := io.ReadAll(r)
+		must(e)
+		r.Close()
+		if !changed && strings.HasPrefix(f.Name, "runtimes/") && len(b) > 0 {
+			b[0] ^= 1
+			changed = true
+		}
+		w, e := zw.Create(f.Name)
+		must(e)
+		_, e = w.Write(b)
+		must(e)
+	}
+	must(zw.Close())
+	if !changed {
+		panic("no runtime to tamper")
+	}
+	return out.Bytes()
+}

+// openAIWSTelemetryAttemptRequestedModel reads only public model metadata from
+// the exact un-mapped frame that this attempt will forward. Current-turn retry
+// payloads restore originalModel; never infer it from an upstream-mapped frame.
+func openAIWSTelemetryAttemptRequestedModel(message []byte, fallback string) string {
+	if gjson.ValidBytes(message) {
+		model := gjson.GetBytes(message, "model")
+		if model.Type == gjson.String {
+			if requested := strings.TrimSpace(model.String()); requested != "" {
+				return requested
+			}
+		}
+	}
+	return strings.TrimSpace(fallback)
+}

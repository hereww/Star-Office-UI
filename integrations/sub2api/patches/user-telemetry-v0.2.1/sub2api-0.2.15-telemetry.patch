+	route := manager.route.Load()
+	manager.publishRuntimeLocked(telemetryI, telemetry)
+	require.Same(t, route, manager.route.Load())
+	require.Len(t, manager.runtimes, 2)
+	manager.removeRuntimeLocked(42)
+	require.Same(t, route, manager.route.Load())
+	manager.publishRuntimeLocked(telemetryI, telemetry)

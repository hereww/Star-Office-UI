+	currentTurnMessage := []byte(`{"type":"response.create","model":"public-B","previous_response_id":"resp-A"}`)
+	var failedBLease *service.TelemetryModelLease
+	upstream429 := &service.UpstreamFailoverError{StatusCode: http.StatusTooManyRequests}
+	attemptErr := func() error {
+		releaseB := helper.beginTelemetryTurn(c, userID, openAIWSTelemetryAttemptRequestedModel(currentTurnMessage, firstPublicModel))
+		defer releaseB()
+		failedBLease = service.TelemetryModelLeaseFromContext(c.Request.Context())
+		require.NotNil(t, failedBLease)
+		service.SetOpsUpstreamModel(c, accountOne.GetMappedModel(currentPublicModel))
+		// Old callback/context writers may run late; they must not touch B.
+		leaseA.UpdateUpstream("stale-A-after-release")
+		releaseA()
+		require.Equal(t, map[int64][]serviceActiveModelView{
+			userID: {{requested: currentPublicModel, upstream: "account-one-B", hasUpstream: true, requests: 1}},
+		}, readHandlerTelemetryModels(t, concurrency, userID))
+		return upstream429
+	}()
+	require.Same(t, upstream429, attemptErr)
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID), "429 attempt must release B before account switching")
+
+	// Current-turn retry payloads contain original/public B. Use the production
+	// next-attempt cloning helper, then run both initialization and attempt model
+	// resolution exactly as required by the fixed outer/inner call sites.
+	retryPayload := []byte(`{"type":"response.create","model":"public-B","input":[]}`)
+	var retrySafe bool
+	wsAttemptMessage, retrySafe = openAIWSNextAttemptMessage(wsAttemptMessage, retryPayload, true)
+	require.True(t, retrySafe)
+	retryPayload[0] = 'x'
+	require.Equal(t, byte('{'), wsAttemptMessage[0], "attempt payload must be an isolated copy")
+	initialTelemetryRequested := openAIWSTelemetryAttemptRequestedModel(wsAttemptMessage, firstPublicModel)
+	require.Equal(t, currentPublicModel, initialTelemetryRequested, "new account's turn 1 must not reset to A")
+	attemptTelemetryRequested := openAIWSTelemetryAttemptRequestedModel(wsAttemptMessage, initialTelemetryRequested)
+	releaseRetryB := helper.beginTelemetryTurn(c, userID, attemptTelemetryRequested)
+	t.Cleanup(releaseRetryB)
+	retryBLease := service.TelemetryModelLeaseFromContext(c.Request.Context())
+	require.NotNil(t, retryBLease)
+	require.NotSame(t, failedBLease, retryBLease, "retry must use a new lease, not reuse the retired attempt")
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		userID: {{requested: currentPublicModel, requests: 1}},
+	}, readHandlerTelemetryModels(t, concurrency, userID), "old account's upstream must not bleed into the new attempt")
+
+	service.SetOpsUpstreamModel(c, accountTwo.GetMappedModel(currentPublicModel))
+	failedBLease.UpdateUpstream("stale-account-one-B")
+	failedBLease.Release()
+	leaseA.UpdateUpstream("stale-account-one-A")
+	require.Equal(t, map[int64][]serviceActiveModelView{
+		userID: {{requested: currentPublicModel, upstream: "account-two-B", hasUpstream: true, requests: 1}},
+	}, readHandlerTelemetryModels(t, concurrency, userID), "only B on the replacement account may remain live")
+
+	releaseRetryB()
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID))
+	// Exercise late upstream setters after the final release as well as old
+	// leases, then wait through a real production heartbeat interval.
+	service.SetOpsUpstreamModel(c, "late-upstream-after-completion")
+	failedBLease.UpdateUpstream("late-failed-B")
+	leaseA.UpdateUpstream("late-completed-A")
+	releaseRetryB()
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID))
+	time.Sleep(12500 * time.Millisecond)
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID), "released A/B attempts must never reappear on heartbeat")
+}
+
+// Guard the production call sites, not merely the parser's behavior in a
+// standalone harness. The outer account loop and inner concrete attempt must
+// both use the current un-mapped wsAttemptMessage (not the first reqModel).
+func TestTelemetryModelHooksWSCurrentAttemptModelCallSites(t *testing.T) {
+	_, testFile, _, ok := runtime.Caller(0)
+	require.True(t, ok)
+	sourcePath := filepath.Join(filepath.Dir(testFile), "openai_gateway_handler.go")
+	parsed, err := parser.ParseFile(token.NewFileSet(), sourcePath, nil, parser.SkipObjectResolution)
+	require.NoError(t, err)
+	var body *ast.BlockStmt
+	for _, declaration := range parsed.Decls {
+		if function, ok := declaration.(*ast.FuncDecl); ok && function.Name.Name == "ResponsesWebSocket" {
+			body = function.Body
+			break
+		}
+	}
+	require.NotNil(t, body, "inspect the real ResponsesWebSocket handler only")
+	var initial, attempt *ast.AssignStmt
+	var beginAttempt *ast.CallExpr
+	var loops []*ast.ForStmt
+	ast.Inspect(body, func(node ast.Node) bool {
+		switch node := node.(type) {
+		case *ast.ForStmt:
+			loops = append(loops, node)
+		case *ast.AssignStmt:
+			if len(node.Lhs) != 1 || len(node.Rhs) != 1 {
+				return true
+			}
+			left, ok := node.Lhs[0].(*ast.Ident)
+			if !ok {
+				return true
+			}
+			if left.Name == "initialTelemetryRequested" {
+				require.Nil(t, initial, "outer initialization must have one source of truth")
+				initial = node
+			}
+			if left.Name == "attemptTelemetryModel" {
+				if call, ok := node.Rhs[0].(*ast.CallExpr); ok {
+					if name, ok := call.Fun.(*ast.Ident); ok && name.Name == "openAIWSTelemetryAttemptRequestedModel" {
+						require.Nil(t, attempt, "each concrete attempt must have one frame-derived model assignment")
+						attempt = node
+					}
+				}
+			}
+		case *ast.CallExpr:
+			if selector, ok := node.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == "beginTelemetryTurn" && len(node.Args) == 3 {
+				if model, ok := node.Args[2].(*ast.Ident); ok && model.Name == "attemptTelemetryModel" {
+					require.Nil(t, beginAttempt)
+					beginAttempt = node
+				}
+			}
+		}
+		return true
+	})
+	require.NotNil(t, initial, "outer account loop must initialize a requested model")
+	require.NotNil(t, attempt, "inner attempt loop must re-resolve from its current frame")
+	require.NotNil(t, beginAttempt, "the resolved attempt model must reach actual lease registration")
+	for name, assignment := range map[string]*ast.AssignStmt{"outer initialization": initial, "inner attempt": attempt} {
+		call, ok := assignment.Rhs[0].(*ast.CallExpr)
+		require.True(t, ok, name+" must call the production model helper, not assign reqModel")
+		function, ok := call.Fun.(*ast.Ident)
+		require.True(t, ok)
+		require.Equal(t, "openAIWSTelemetryAttemptRequestedModel", function.Name)
+		require.Len(t, call.Args, 2)
+		message, ok := call.Args[0].(*ast.Ident)
+		require.True(t, ok)
+		require.Equal(t, "wsAttemptMessage", message.Name, name+" must resolve the current public retry frame")
+	}
+	innermostLoop := func(position token.Pos) *ast.ForStmt {
+		var found *ast.ForStmt
+		for _, loop := range loops {
+			if loop.Pos() < position && position < loop.End() && (found == nil || loop.Pos() > found.Pos()) {
+				found = loop
+			}
+		}
+		return found
+	}
+	outerLoop := innermostLoop(initial.Pos())
+	innerLoop := innermostLoop(attempt.Pos())
+	require.NotNil(t, outerLoop)
+	require.NotNil(t, innerLoop)
+	require.NotSame(t, outerLoop, innerLoop, "the two guards must cover distinct outer-account and inner-attempt loops")
+	require.True(t, outerLoop.Pos() < innerLoop.Pos() && innerLoop.End() < outerLoop.End())
+	require.Same(t, innerLoop, innermostLoop(beginAttempt.Pos()))
+	require.True(t, attempt.End() < beginAttempt.Pos(), "resolve the current frame before registering its lease")
+	ast.Inspect(innerLoop.Body, func(node ast.Node) bool {
+		assignment, ok := node.(*ast.AssignStmt)
+		if !ok || assignment.Pos() <= attempt.Pos() || assignment.Pos() >= beginAttempt.Pos() {
+			return true
+		}
+		for _, target := range assignment.Lhs {
+			if identifier, ok := target.(*ast.Ident); ok {
+				require.NotEqual(t, "attemptTelemetryModel", identifier.Name, "no stale model overwrite is allowed between frame resolution and registration")
+			}
+		}
+		return true
+	})
+}
+
+// Controlled HTTP bridge upstream: no remote network/provider is contacted.
+// Blocking each actual Do call allows telemetry to be sampled while the real
+// ResponsesWebSocket handler, scheduler, parser and Redis lease are in flight.
+type telemetryModelWSRetryHTTPCall struct {
+	accountID int64
+	payload   []byte
+	response  chan *http.Response
+}
+
+type telemetryModelWSRetryHTTPUpstream struct {
+	service.HTTPUpstream
+	calls chan telemetryModelWSRetryHTTPCall
+	stop  <-chan struct{}
+}
+
+func (u *telemetryModelWSRetryHTTPUpstream) Do(req *http.Request, _ string, accountID int64, _ int) (*http.Response, error) {
+	payload, err := io.ReadAll(req.Body)
+	if err != nil {
+		return nil, err
+	}
+	_ = req.Body.Close()
+	call := telemetryModelWSRetryHTTPCall{accountID: accountID, payload: payload, response: make(chan *http.Response, 1)}
+	select {
+	case u.calls <- call:
+	case <-u.stop:
+		return nil, fmt.Errorf("telemetry websocket test stopped")
+	case <-req.Context().Done():
+		return nil, req.Context().Err()
+	}
+	select {
+	case response := <-call.response:
+		return response, nil
+	case <-u.stop:
+		return nil, fmt.Errorf("telemetry websocket test stopped")
+	case <-req.Context().Done():
+		return nil, req.Context().Err()
+	}
+}
+
+// Unlike the metadata harness above, this uses a real local client WebSocket and
+// the production ResponsesWebSocket -> HTTP bridge -> 429 -> different-account
+// retry chain. HTTPUpstream and the account repository remain controlled test
+// doubles; this is NOT a production/provider acceptance test or WS-upstream test.
+func TestTelemetryModelHooksWSHTTPBridgeCurrentTurn429CrossAccountRetry(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	helper, concurrency, _ := newTelemetryModelHandlerFixture(t)
+	const userID int64 = 51
+	const groupID int64 = 5101
+	const firstAccountID int64 = 5102
+	const secondAccountID int64 = 5103
+	const firstPublicModel = "public-A"
+	const currentPublicModel = "public-B"
+	stop := make(chan struct{})
+	defer close(stop)
+	upstream := &telemetryModelWSRetryHTTPUpstream{calls: make(chan telemetryModelWSRetryHTTPCall, 4), stop: stop}
+	cfg := &config.Config{}
+	cfg.RunMode = config.RunModeSimple
+	cfg.Default.RateMultiplier = 1
+	cfg.Security.URLAllowlist.Enabled = false
+	cfg.Security.URLAllowlist.AllowInsecureHTTP = true
+	cfg.Gateway.OpenAIWS.Enabled = true
+	cfg.Gateway.OpenAIWS.APIKeyEnabled = true
+	cfg.Gateway.OpenAIWS.ResponsesWebsocketsV2 = true
+	cfg.Gateway.OpenAIWS.ModeRouterV2Enabled = true
+	cfg.Gateway.OpenAIWS.ReadTimeoutSeconds = 5
+	cfg.Gateway.OpenAIWS.WriteTimeoutSeconds = 5
+	cfg.Gateway.MaxAccountSwitches = 3
+	accountRepo := &openAIWSFailoverHandlerAccountRepoStub{accounts: []service.Account{
+		{
+			ID: firstAccountID, Name: "telemetry-account-one", Platform: service.PlatformOpenAI,
+			Type: service.AccountTypeAPIKey, Status: service.StatusActive, Schedulable: true, Concurrency: 1, Priority: 1,
+			Credentials: map[string]any{"api_key": "sk-test-account-one", "model_mapping": map[string]any{
+				firstPublicModel: "gpt-5.4", currentPublicModel: "gpt-5.2",
+			}},
+			Extra: map[string]any{"openai_apikey_responses_websockets_v2_mode": service.OpenAIWSIngressModeHTTPBridge},
+		},
+		{
+			ID: secondAccountID, Name: "telemetry-account-two", Platform: service.PlatformOpenAI,
+			Type: service.AccountTypeAPIKey, Status: service.StatusActive, Schedulable: true, Concurrency: 1, Priority: 2,
+			Credentials: map[string]any{"api_key": "sk-test-account-two", "model_mapping": map[string]any{
+				firstPublicModel: "gpt-5.4", currentPublicModel: "gpt-5.6-sol",
+			}},
+			Extra: map[string]any{"openai_apikey_responses_websockets_v2_mode": service.OpenAIWSIngressModeHTTPBridge},
+		},
+	}}
+	usageRepo := &openAIWSUsageHandlerUsageLogRepoStub{created: make(chan *service.UsageLog, 4)}
+	billingCache := service.NewBillingCacheService(nil, nil, nil, nil, nil, nil, cfg, nil)
+	t.Cleanup(billingCache.Stop)
+	gateway := service.NewOpenAIGatewayService(
+		accountRepo, usageRepo, nil, nil, nil, nil, nil, cfg, nil, nil,
+		service.NewBillingService(cfg, nil), service.NewRateLimitService(accountRepo, nil, cfg, nil, nil),
+		billingCache, upstream, &service.DeferredService{}, nil, nil, nil, nil, nil, nil, nil,
+	)
+	h := &OpenAIGatewayHandler{
+		gatewayService: gateway, billingCacheService: billingCache, apiKeyService: &service.APIKeyService{},
+		concurrencyHelper: helper, maxAccountSwitches: 3, cfg: cfg,
+	}
+	accountGroupID := int64(groupID)
+	apiKey := &service.APIKey{
+		ID: 5104, UserID: userID, GroupID: &accountGroupID,
+		User:  &service.User{ID: userID, Status: service.StatusActive},
+		Group: &service.Group{ID: groupID, Platform: service.PlatformOpenAI, Status: service.StatusActive},
+	}
+	handlerDone := make(chan struct{})
+	router := gin.New()
+	router.Use(func(c *gin.Context) {
+		c.Set(string(middleware.ContextKeyAPIKey), apiKey)
+		c.Set(string(middleware.ContextKeyUser), middleware.AuthSubject{UserID: userID, Concurrency: 1})
+		c.Next()
+	})
+	router.GET("/openai/v1/responses", func(c *gin.Context) {
+		defer close(handlerDone)
+		h.ResponsesWebSocket(c)
+	})
+	server := httptest.NewServer(router)
+	t.Cleanup(server.Close)
+	dialCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	client, _, err := coderws.Dial(dialCtx, "ws"+strings.TrimPrefix(server.URL, "http")+"/openai/v1/responses", nil)
+	cancel()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.CloseNow() })
+	write := func(payload string) {
+		t.Helper()
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		require.NoError(t, client.Write(ctx, coderws.MessageText, []byte(payload)))
+	}
+	nextCall := func() telemetryModelWSRetryHTTPCall {
+		t.Helper()
+		select {
+		case call := <-upstream.calls:
+			return call
+		case <-handlerDone:
+			t.Fatal("real WebSocket handler exited before the expected HTTP bridge attempt")
+		case <-time.After(5 * time.Second):
+			t.Fatal("real WebSocket handler did not reach the expected HTTP bridge attempt")
+		}
+		return telemetryModelWSRetryHTTPCall{}
+	}
+	complete := func(call telemetryModelWSRetryHTTPCall, id string) {
+		model := gjson.GetBytes(call.payload, "model").String()
+		body := fmt.Sprintf("data: {\"type\":\"response.completed\",\"response\":{\"id\":%q,\"model\":%q,\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}}\n\n", id, model)
+		call.response <- &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(body))}
+	}
+	readCompleted := func(id string) {
+		t.Helper()
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		for {
+			_, payload, err := client.Read(ctx)
+			require.NoError(t, err)
+			event := gjson.GetBytes(payload, "type").String()
+			require.NotEqual(t, "error", event, "429 should fail over without becoming a client-visible error")
+			if event == "response.completed" {
+				require.Equal(t, id, gjson.GetBytes(payload, "response.id").String())
+				return
+			}
+		}
+	}
+	expectLive := func(requested, mapped string) {
+		t.Helper()
+		require.Equal(t, map[int64][]serviceActiveModelView{
+			userID: {{requested: requested, upstream: mapped, hasUpstream: true, requests: 1}},
+		}, readHandlerTelemetryModels(t, concurrency, userID))
+	}
+
+	write(`{"type":"response.create","model":"public-A","input":[{"role":"user","content":"first"}]}`)
+	first := nextCall()
+	require.Equal(t, firstAccountID, first.accountID)
+	require.Equal(t, "gpt-5.4", gjson.GetBytes(first.payload, "model").String())
+	expectLive(firstPublicModel, "gpt-5.4")
+	complete(first, "resp-telemetry-A")
+	readCompleted("resp-telemetry-A")
+	require.Eventually(t, func() bool {
+		return len(readHandlerTelemetryModels(t, concurrency, userID)[userID]) == 0
+	}, time.Second, 5*time.Millisecond, "completed A's lease must be removed while the client connection remains open")
+
+	write(`{"type":"response.create","model":"public-B","previous_response_id":"resp-telemetry-A","input":[{"role":"user","content":"second"}]}`)
+	failedB := nextCall()
+	require.Equal(t, firstAccountID, failedB.accountID)
+	require.Equal(t, "gpt-5.2", gjson.GetBytes(failedB.payload, "model").String())
+	expectLive(currentPublicModel, "gpt-5.2")
+	// This regression is the cross-account current-turn path. Use API-key
+	// accounts so the OAuth-only same-account 429 retry window cannot mask the
+	// scheduler switch that the test is intended to verify.
+	quotaHeaders := http.Header{"Content-Type": {"application/json"}}
+	quotaBody := []byte(`{"error":{"type":"rate_limit_exceeded","message":"temporary upstream rate limit"}}`)
+	failedB.response <- &http.Response{
+		StatusCode: http.StatusTooManyRequests,
+		Header:     quotaHeaders,
+		Body:       io.NopCloser(strings.NewReader(string(quotaBody))),
+	}
+	retryB := nextCall()
+	require.Equal(t, secondAccountID, retryB.accountID, "429 must select a different account through the production scheduler")
+	require.Equal(t, "gpt-5.6-sol", gjson.GetBytes(retryB.payload, "model").String())
+	require.Empty(t, gjson.GetBytes(retryB.payload, "previous_response_id").String(), "retry must not carry the previous account's response chain")
+	expectLive(currentPublicModel, "gpt-5.6-sol") // Fails with requested=A on the old handler.
+	complete(retryB, "resp-telemetry-B")
+	readCompleted("resp-telemetry-B")
+	require.Eventually(t, func() bool {
+		return len(readHandlerTelemetryModels(t, concurrency, userID)[userID]) == 0
+	}, time.Second, 5*time.Millisecond, "successful B retry must clear the only remaining lease")
+	_ = client.CloseNow()
+	select {
+	case <-handlerDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("real WebSocket handler did not finish after the client disconnected")
+	}
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID))
+	// The above count=1 assertions rule out an orphaned account-one B entry.
+	// Wait beyond the real heartbeat so retirement is not just a transient read.
+	time.Sleep(12500 * time.Millisecond)
+	require.Empty(t, readHandlerTelemetryModels(t, concurrency, userID))
+	select {
+	case extra := <-upstream.calls:
+		t.Fatalf("unexpected extra bridge attempt on account %d", extra.accountID)
+	default:
+	}
+}

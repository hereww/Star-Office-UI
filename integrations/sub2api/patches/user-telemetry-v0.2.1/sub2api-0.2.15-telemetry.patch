@@ -0,0 +1,90 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func TestUserTelemetryCredentialPostgresIsolationPaginationAndRevocation(t *testing.T) {
+	dsn := os.Getenv("S2A_TELEMETRY_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("isolated PostgreSQL DSN required")
+	}
+	if u, err := url.Parse(dsn); err == nil && u.Scheme != "" {
+		q := u.Query()
+		q.Set("search_path", "pg_temp")
+		u.RawQuery = q.Encode()
+		dsn = u.String()
+	} else {
+		dsn += " search_path=pg_temp"
+	}
+	db, err := sql.Open("postgres", dsn)
+	require.NoError(t, err)
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	ctx := context.Background()
+	require.NoError(t, db.PingContext(ctx))
+	_, err = db.ExecContext(ctx, `CREATE TEMP TABLE sub2api_user_telemetry_credentials(id BIGSERIAL PRIMARY KEY,plugin_id BIGINT NOT NULL,name TEXT NOT NULL,user_ids JSONB NOT NULL,token_hash BYTEA UNIQUE NOT NULL CHECK(octet_length(token_hash)=32),expires_at TIMESTAMPTZ NOT NULL,created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),revoked_at TIMESTAMPTZ)`)
+	require.NoError(t, err)
+	var namespace string
+	require.NoError(t, db.QueryRowContext(ctx, `SELECT n.nspname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.oid='sub2api_user_telemetry_credentials'::regclass`).Scan(&namespace))
+	require.True(t, strings.HasPrefix(namespace, "pg_temp_"))
+	_, err = db.ExecContext(ctx, `INSERT INTO sub2api_user_telemetry_credentials(plugin_id,name,user_ids,token_hash,expires_at) SELECT 1,'pagination fixture','["42"]'::jsonb,decode(lpad(to_hex(n),64,'0'),'hex'),NOW()+INTERVAL '1 hour' FROM generate_series(1,1002) n`)
+	require.NoError(t, err)
+	store := NewUserTelemetryCredentialStore(db)
+	seen := map[int64]bool{}
+	var cursor int64
+	pages := 0
+	for {
+		page, err := store.List(ctx, 1, cursor, 100)
+		require.NoError(t, err)
+		require.LessOrEqual(t, len(page.Credentials), 100)
+		pages++
+		for _, credential := range page.Credentials {
+			require.False(t, seen[credential.ID])
+			seen[credential.ID] = true
+		}
+		raw, err := json.Marshal(page)
+		require.NoError(t, err)
+		require.NotContains(t, string(raw), "token_hash")
+		if page.NextCursor == nil {
+			break
+		}
+		cursor, err = strconv.ParseInt(*page.NextCursor, 10, 64)
+		require.NoError(t, err)
+		require.Equal(t, cursor, page.Credentials[len(page.Credentials)-1].ID)
+		require.Less(t, pages, 20)
+	}
+	require.Len(t, seen, 1002)
+	require.Equal(t, 11, pages)
+	require.True(t, seen[1])
+	token, hash, err := service.NewUserTelemetrySecret()
+	require.NoError(t, err)
+	credential := &service.UserTelemetryCredential{PluginID: 2, Name: "auth fixture", UserIDs: []string{"42"}, TokenHash: hash, ExpiresAt: time.Now().Add(time.Hour)}
+	require.NoError(t, store.Create(ctx, credential))
+	authenticated, err := store.Authenticate(ctx, 2, service.UserTelemetrySecretHash(token))
+	require.NoError(t, err)
+	require.Equal(t, credential.ID, authenticated.ID)
+	_, err = store.Authenticate(ctx, 1, hash)
+	require.ErrorIs(t, err, service.ErrTelemetryUnauthorized)
+	require.Error(t, store.Revoke(ctx, 1, credential.ID))
+	require.NoError(t, store.Revoke(ctx, 2, credential.ID))
+	_, err = store.Authenticate(ctx, 2, hash)
+	require.ErrorIs(t, err, service.ErrTelemetryUnauthorized)
+	_, expiredHash, err := service.NewUserTelemetrySecret()
+	require.NoError(t, err)
+	require.NoError(t, store.Create(ctx, &service.UserTelemetryCredential{PluginID: 2, Name: "expiry fixture", UserIDs: []string{"42"}, TokenHash: expiredHash, ExpiresAt: time.Now().Add(-time.Minute)}))
+	_, err = store.Authenticate(ctx, 2, expiredHash)
+	require.ErrorIs(t, err, service.ErrTelemetryUnauthorized)
+	t.Log("real PostgreSQL temporary schema; 1002 credentials across 11 pages; plugin binding, expiry, immediate revocation")
+}
diff --git a/backend/internal/repository/user_telemetry_postgres_test.go b/backend/internal/repository/user_telemetry_postgres_test.go
new file mode 100644
index 000000000..8b502f6e7
--- /dev/null
+++ b/backend/internal/repository/user_telemetry_postgres_test.go
@@ -0,0 +1,250 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"math/big"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+// Opt in with S2A_TELEMETRY_TEST_POSTGRES_DSN. This never starts a database or
+// writes production tables: search_path=pg_temp and one connection isolate all
+// fixtures in temporary tables (including a deliberately secret key column).
+// Optional S2A_TELEMETRY_TEST_REDIS_ADDR exercises the real cache as well; it
+// performs the existing batch reader's expired-slot cleanup but creates no slots.
+func TestUserTelemetryRealPostgresRecordedUsage(t *testing.T) {
+	dsn := os.Getenv("S2A_TELEMETRY_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("set S2A_TELEMETRY_TEST_POSTGRES_DSN to run isolated real PostgreSQL acceptance")
+	}
+	if strings.HasPrefix(dsn, "postgres://") || strings.HasPrefix(dsn, "postgresql://") {
+		u, err := url.Parse(dsn)
+		require.NoError(t, err)
+		q := u.Query()
+		q.Set("search_path", "pg_temp")
+		u.RawQuery = q.Encode()
+		dsn = u.String()
+	} else {
+		dsn += " search_path=pg_temp"
+	}
+	db, err := sql.Open("postgres", dsn)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	db.SetMaxOpenConns(1)
+	db.SetMaxIdleConns(1)
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	require.NoError(t, db.PingContext(ctx))
+	for _, statement := range []string{
+		`CREATE TEMP TABLE users (id bigint PRIMARY KEY, email text NOT NULL, username text NOT NULL, concurrency integer NOT NULL, status text NOT NULL, deleted_at timestamptz)`,
+		`CREATE TEMP TABLE api_keys (id bigint PRIMARY KEY, user_id bigint NOT NULL, name text NOT NULL, status text NOT NULL, deleted_at timestamptz, key text NOT NULL)`,
+		`CREATE TEMP TABLE usage_logs (user_id bigint NOT NULL, api_key_id bigint NOT NULL, created_at timestamptz NOT NULL, input_tokens bigint NOT NULL, output_tokens bigint NOT NULL, cache_creation_tokens bigint NOT NULL, cache_read_tokens bigint NOT NULL, cache_creation_5m_tokens bigint NOT NULL DEFAULT 0, cache_creation_1h_tokens bigint NOT NULL DEFAULT 0, total_cost numeric NOT NULL DEFAULT 0)`,
+		`INSERT INTO users VALUES (9007199254740993,'first@example.test','',5,'disabled',NULL), (9007199254740994,'second@example.test','second',0,'active',NULL), (9007199254740995,'deleted@example.test','deleted',5,'active','2020-01-01'), (9007199254740996,'no-usage@example.test','no-usage',5,'active',NULL)`,
+		`INSERT INTO api_keys VALUES (9007199254740101,9007199254740993,'first-live','active',NULL,'NEVER_EXPORT_THIS_SECRET'), (9007199254740102,9007199254740993,'first-rotated','disabled',NULL,'NEVER_EXPORT_THIS_SECRET'), (9007199254740103,9007199254740993,'first-deleted','active','2020-01-01','NEVER_EXPORT_THIS_SECRET'), (9007199254740104,9007199254740994,'second-live','active',NULL,'NEVER_EXPORT_THIS_SECRET')`,
+		// Four components produce 10; subitems/cost must not make it 9010+.
+		`INSERT INTO usage_logs VALUES (9007199254740993,9007199254740101,'2020-01-01T00:00:00Z',1,2,3,4,4000,5000,999)`,
+		`INSERT INTO usage_logs VALUES (9007199254740993,9007199254740102,'2020-01-01T12:00:00Z',20,0,0,0,0,0,0)`,
+		// Deleted key history still contributes, with per-row numeric addition
+		// and SUM exceeding bigint: 2*MaxInt64 + 30 = 18446744073709551644.
+		`INSERT INTO usage_logs VALUES (9007199254740993,9007199254740103,'2020-01-01T18:00:00Z',9223372036854775807,9223372036854775807,0,0,0,0,0)`,
+		`INSERT INTO usage_logs VALUES (9007199254740994,9007199254740104,'2020-01-01T01:00:00Z',7,0,0,0,0,0,0)`,
+		// Out-of-window entries do not leak into [start,end).
+		`INSERT INTO usage_logs VALUES (9007199254740993,9007199254740101,'2019-12-31T23:59:59Z',555,0,0,0,0,0,0), (9007199254740993,9007199254740101,'2020-01-02T00:00:00Z',777,0,0,0,0,0,0)`,
+	} {
+		_, err := db.ExecContext(ctx, statement)
+		require.NoError(t, err)
+	}
+	// PostgreSQL creates a dedicated pg_temp_N schema for this session. Prove
+	// every unqualified fixture name resolves there, never to the seed tables.
+	var schema string
+	require.NoError(t, db.QueryRowContext(ctx, `SELECT nspname FROM pg_namespace WHERE oid = pg_my_temp_schema()`).Scan(&schema))
+	require.True(t, strings.HasPrefix(schema, "pg_temp_"))
+	t.Logf("isolated fixture schema: %s (session temporary; search_path=pg_temp)", schema)
+	for _, table := range []string{"users", "api_keys", "usage_logs"} {
+		var isolated bool
+		require.NoError(t, db.QueryRowContext(ctx, `SELECT to_regclass($1)::oid = to_regclass('pg_temp.' || $1)::oid`, table).Scan(&isolated))
+		require.True(t, isolated, "fixture must resolve to the private temporary schema: %s", table)
+	}
+	// Deliberately use a DB-session timezone unlike the request's timezone.
+	// Bound timestamptz instants, not session-local date_trunc, own the day cuts.
+	_, err = db.ExecContext(ctx, `SET TIME ZONE 'America/New_York'`)
+	require.NoError(t, err)
+	loc, err := time.LoadLocation("Asia/Shanghai")
+	require.NoError(t, err)
+	fixtureNow := time.Now().In(loc)
+	todayStart := time.Date(fixtureNow.Year(), fixtureNow.Month(), fixtureNow.Day(), 0, 0, 0, 0, loc)
+	yesterdayStart := todayStart.AddDate(0, 0, -1)
+	for _, row := range []struct {
+		userID, keyID                 int64
+		at                            time.Time
+		input, output, creation, read string
+	}{
+		// Exact inclusive yesterday bound and exclusive today bound; one
+		// microsecond is PostgreSQL's precision, not a nanosecond that rounds up.
+		{9007199254740993, 9007199254740101, yesterdayStart.Add(-time.Microsecond), "555", "0", "0", "0"},
+		{9007199254740993, 9007199254740101, yesterdayStart, "7", "0", "0", "0"},
+		{9007199254740993, 9007199254740101, todayStart.Add(-time.Microsecond), "9", "0", "0", "0"},
+		{9007199254740993, 9007199254740101, todayStart, "1", "2", "3", "4"},
+		// Historical deleted key and numeric row addition exceeding bigint.
+		{9007199254740993, 9007199254740103, todayStart, "9223372036854775807", "9223372036854775807", "0", "0"},
+		{9007199254740993, 9007199254740101, todayStart.AddDate(0, 0, 2), "777", "0", "0", "0"},
+		{9007199254740994, 9007199254740104, yesterdayStart, "3", "0", "0", "0"},
+		{9007199254740994, 9007199254740104, todayStart, "4", "0", "0", "0"},
+		// Deleted and outside-request users must never contaminate page totals.
+		{9007199254740995, 9007199254740101, todayStart, "888", "0", "0", "0"},
+		{9007199254740997, 9007199254740101, todayStart, "999", "0", "0", "0"},
+	} {
+		_, err = db.ExecContext(ctx, `INSERT INTO pg_temp.usage_logs
+		(user_id,api_key_id,created_at,input_tokens,output_tokens,cache_creation_tokens,cache_read_tokens,cache_creation_5m_tokens,cache_creation_1h_tokens,total_cost)
+		VALUES ($1,$2,$3,$4,$5,$6,$7,4000,5000,999)`, row.userID, row.keyID, row.at, row.input, row.output, row.creation, row.read)
+		require.NoError(t, err)
+	}
+	var concurrency *service.ConcurrencyService
+	if addr := os.Getenv("S2A_TELEMETRY_TEST_REDIS_ADDR"); addr != "" {
+		client := redis.NewClient(&redis.Options{Addr: addr})
+		t.Cleanup(func() { _ = client.Close() })
+		require.NoError(t, client.Ping(ctx).Err())
+		concurrency = service.NewConcurrencyService(NewConcurrencyCache(client, 15, 900))
+	}
+	svc := service.NewUserTelemetryService(db, concurrency)
+	query := json.RawMessage(`{"user_ids":["9007199254740993","9007199254740994","9007199254740995","9007199254740996"],"page_size":2,"start":"2020-01-01T00:00:00Z","end":"2020-01-02T00:00:00Z"}`)
+	raw, err := svc.ReadUserTelemetry(ctx, query)
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), "NEVER_EXPORT_THIS_SECRET")
+	var snapshot usertelemetry.Snapshot
+	require.NoError(t, json.Unmarshal(raw, &snapshot))
+	require.Len(t, snapshot.Users, 2)
+	require.Equal(t, "9007199254740994", *snapshot.NextCursor)
+	first, second := snapshot.Users[0], snapshot.Users[1]
+	require.Equal(t, "9007199254740993", first.UserID)
+	require.Empty(t, first.Username)
+	require.Len(t, first.APIKeys, 2)
+	require.Equal(t, "9007199254740101", first.APIKeys[0].ID)
+	require.Equal(t, "9007199254740102", first.APIKeys[1].ID)
+	require.Equal(t, "18446744073709551644", *first.TokenUsage.Total)
+	require.Len(t, second.APIKeys, 1)
+	require.Equal(t, "7", *second.TokenUsage.Total)
+	assertTelemetryDailyPostgres(t, ctx, db, first)
+	assertTelemetryDailyPostgres(t, ctx, db, second)
+	// The reference below uses returned frozen bounds and arbitrary precision,
+	// so a rare test execution crossing midnight is still checked correctly.
+	if first.TokenUsage.Today.Date == fixtureNow.Format("2006-01-02") {
+		require.Equal(t, "18446744073709551624", *first.TokenUsage.Today.Total)
+		require.Equal(t, "16", *first.TokenUsage.Yesterday.Total)
+		require.Equal(t, "4", *second.TokenUsage.Today.Total)
+		require.Equal(t, "3", *second.TokenUsage.Yesterday.Total)
+	}
+
+	require.Equal(t, "untracked", second.Quality.Concurrency)
+	require.Nil(t, second.Concurrency.Current)
+	if concurrency == nil {
+		require.Equal(t, "unavailable", first.Quality.Concurrency)
+		require.Nil(t, first.Concurrency.Current)
+	} else {
+		require.Equal(t, "fresh", first.Quality.Concurrency)
+		require.NotNil(t, first.Concurrency.Current)
+	}
+	var nextQuery usertelemetry.Query
+	require.NoError(t, json.Unmarshal(query, &nextQuery))
+	nextQuery.Cursor = *snapshot.NextCursor
+	query, err = json.Marshal(nextQuery)
+	require.NoError(t, err)
+	raw, err = svc.ReadUserTelemetry(ctx, query)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(raw, &snapshot))
+	require.Len(t, snapshot.Users, 1, "soft-deleted user must not appear on the next page")
+	require.Equal(t, "9007199254740996", snapshot.Users[0].UserID)
+	require.Equal(t, "0", *snapshot.Users[0].TokenUsage.Total)
+	assertTelemetryDailyPostgres(t, ctx, db, snapshot.Users[0])
+	require.Equal(t, "0", *snapshot.Users[0].TokenUsage.Today.Total)
+	require.Equal(t, "0", *snapshot.Users[0].TokenUsage.Yesterday.Total)
+
+	require.Empty(t, snapshot.Users[0].APIKeys)
+	require.Nil(t, snapshot.NextCursor)
+
+	// Real SQL failures must remain unknown, not fabricated zeros. Only this
+	// session's table is dropped; the acceptance/public usage table is untouched.
+	_, err = db.ExecContext(ctx, `DROP TABLE pg_temp.usage_logs`)
+	require.NoError(t, err)
+	nextQuery.Cursor = ""
+	query, err = json.Marshal(nextQuery)
+	require.NoError(t, err)
+	raw, err = svc.ReadUserTelemetry(ctx, query)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(raw, &snapshot))
+	for _, user := range snapshot.Users {
+		require.Nil(t, user.TokenUsage.Total)
+		require.Nil(t, user.ObservedAt.TokenUsage)
+		require.Equal(t, "unavailable", user.Quality.TokenUsage)
+		for _, day := range []*usertelemetry.DailyTokenUsage{user.TokenUsage.Today, user.TokenUsage.Yesterday} {
+			require.NotNil(t, day)
+			require.Nil(t, day.Total)
+			require.Nil(t, day.ObservedAt)
+			require.Equal(t, "unavailable", day.Quality)
+		}
+
+		require.Equal(t, "fresh", user.Quality.Identity)
+		require.Equal(t, "fresh", user.Quality.APIKeys)
+	}
+
+	// A complete key list is mandatory even against a real database.
+	_, err = db.ExecContext(ctx, `INSERT INTO pg_temp.api_keys (id,user_id,name,status,key) SELECT n,9007199254740993,'overflow-fixture','active','NEVER_EXPORT_THIS_SECRET' FROM generate_series(1,10001) AS n`)
+	require.NoError(t, err)
+	raw, err = svc.ReadUserTelemetry(ctx, query)
+	require.ErrorIs(t, err, service.ErrUserTelemetryAPIKeyLimit)
+	require.Nil(t, raw)
+
+	_, err = db.ExecContext(ctx, `DROP TABLE pg_temp.users`)
+	require.NoError(t, err)
+	raw, err = svc.ReadUserTelemetry(ctx, query)
+	require.ErrorContains(t, err, "identity read failed")
+	require.Nil(t, raw)
+}
+
+// Independent reference: sum individual fixture components in Go big.Int using
+// the returned [start,end) instants. It intentionally does not duplicate SUM
+// FILTER SQL, and so detects wrong FILTER columns/bounds and numeric overflow.
+func assertTelemetryDailyPostgres(t *testing.T, ctx context.Context, db *sql.DB, user usertelemetry.User) {
+	t.Helper()
+	for _, day := range []*usertelemetry.DailyTokenUsage{user.TokenUsage.Today, user.TokenUsage.Yesterday} {
+		require.NotNil(t, day)
+		require.NotNil(t, day.Total)
+		require.Equal(t, "fresh", day.Quality)
+		require.NotNil(t, day.ObservedAt)
+		start, err := time.Parse(time.RFC3339Nano, day.Start)
+		require.NoError(t, err)
+		end, err := time.Parse(time.RFC3339Nano, day.End)
+		require.NoError(t, err)
+		require.Equal(t, day.Date, start.Format("2006-01-02"))
+		rows, err := db.QueryContext(ctx, `SELECT created_at, input_tokens::text, output_tokens::text,
+		cache_creation_tokens::text, cache_read_tokens::text FROM pg_temp.usage_logs WHERE user_id=$1`, user.UserID)
+		require.NoError(t, err)
+		total := new(big.Int)
+		for rows.Next() {
+			var at time.Time
+			var components [4]string
+			require.NoError(t, rows.Scan(&at, &components[0], &components[1], &components[2], &components[3]))
+			if at.Before(start) || !at.Before(end) {
+				continue
+			}
+			for _, component := range components {
+				value, ok := new(big.Int).SetString(component, 10)
+				require.True(t, ok)
+				total.Add(total, value)
+			}
+		}
+		require.NoError(t, rows.Err())
+		require.NoError(t, rows.Close())
+		require.Equal(t, total.String(), *day.Total)
+	}
+}

@@ -0,0 +1,438 @@
+package service
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"strconv"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"github.com/lib/pq"
+)
+
+const userTelemetryMaxAPIKeys = 10000
+
+// Explicit column allowlists keep credentials and billing fields out of the
+// reader, not merely out of its JSON. All parameters are bound, including IDs.
+const userTelemetryUsersSQL = `SELECT id, email, username, concurrency, status
+FROM users
+WHERE deleted_at IS NULL AND id = ANY($1::bigint[]) AND id > $2
+ORDER BY id ASC LIMIT $3`
+
+const userTelemetryAPIKeysSQL = `SELECT id, user_id, name, status
+FROM api_keys
+WHERE deleted_at IS NULL AND user_id = ANY($1::bigint[])
+ORDER BY user_id ASC, id ASC LIMIT $2`
+
+// Cast EACH operand before adding: both a single row and the aggregate may
+// exceed bigint. Deliberately do not join api_keys: deleted/rotated keys still
+// contribute recorded usage. The 5m/1h cache-creation counters are subitems.
+const userTelemetryTokensSQL = `SELECT user_id,
+SUM((input_tokens::numeric) + (output_tokens::numeric) + (cache_creation_tokens::numeric) + (cache_read_tokens::numeric))::text
+FROM usage_logs
+WHERE user_id = ANY($1::bigint[]) AND created_at >= $2 AND created_at < $3
+GROUP BY user_id`
+
+// One independent scan of yesterday through the frozen now serves both calendar
+// windows. Each operand is numeric BEFORE addition; no key join or cache subitems.
+const userTelemetryDailyTokensSQL = `SELECT user_id,
+COALESCE(SUM((input_tokens::numeric) + (output_tokens::numeric) + (cache_creation_tokens::numeric) + (cache_read_tokens::numeric)) FILTER (WHERE created_at >= $3 AND created_at < $4), 0)::text,
+COALESCE(SUM((input_tokens::numeric) + (output_tokens::numeric) + (cache_creation_tokens::numeric) + (cache_read_tokens::numeric)) FILTER (WHERE created_at >= $2 AND created_at < $3), 0)::text
+FROM usage_logs
+WHERE user_id = ANY($1::bigint[]) AND created_at >= $2 AND created_at < $4
+GROUP BY user_id`
+
+type telemetryDailyBounds struct {
+	yesterdayStart time.Time
+	todayStart     time.Time
+	now            time.Time
+}
+
+func newTelemetryDailyBounds(now time.Time, loc *time.Location) telemetryDailyBounds {
+	now = now.In(loc)
+	today := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, loc)
+	// Calendar arithmetic is essential: yesterday can be 23 or 25 hours long.
+	return telemetryDailyBounds{yesterdayStart: today.AddDate(0, 0, -1), todayStart: today, now: now}
+}
+
+func telemetryDailyWindow(start, end time.Time) *usertelemetry.DailyTokenUsage {
+	return &usertelemetry.DailyTokenUsage{
+		Date: start.Format("2006-01-02"), Start: start.Format(time.RFC3339Nano),
+		End: end.Format(time.RFC3339Nano), Quality: "unavailable",
+	}
+}
+
+type telemetryDailyTotals struct {
+	today     string
+	yesterday string
+}
+
+var ErrUserTelemetryAPIKeyLimit = errors.New("user telemetry API key resource limit exceeded (maximum 10000 keys per page; request a smaller user page)")
+
+// UserTelemetryService performs uncached, request-scoped reads. It must only be
+// called after the administrator's user scope has been enforced by the caller.
+// Normalize is repeated here so private RPC cannot bypass input validation.
+type UserTelemetryService struct {
+	db          *sql.DB
+	concurrency *ConcurrencyService
+	now         func() time.Time
+}
+
+func NewUserTelemetryService(db *sql.DB, concurrency *ConcurrencyService) *UserTelemetryService {
+	return &UserTelemetryService{db: db, concurrency: concurrency, now: time.Now}
+}
+
+func (s *UserTelemetryService) ReadUserTelemetry(ctx context.Context, query json.RawMessage) (json.RawMessage, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("user telemetry database unavailable")
+	}
+	q, err := usertelemetry.DecodeQuery(query)
+	if err != nil {
+		return nil, err
+	}
+	now := s.now() // Freeze query normalization AND both daily windows once.
+	q, start, end, err := q.Normalize(now)
+	if err != nil {
+		return nil, err
+	}
+	loc, err := time.LoadLocation(q.Timezone)
+	if err != nil {
+		return nil, err
+	}
+	dailyBounds := newTelemetryDailyBounds(now, loc)
+	ids := make([]int64, 0, len(q.UserIDs))
+	for _, value := range q.UserIDs {
+		id, err := usertelemetry.ParseID(value)
+		if err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	var cursor int64
+	if q.Cursor != "" {
+		cursor, err = usertelemetry.ParseID(q.Cursor)
+		if err != nil {
+			return nil, err
+		}
+	}
+	users, nextCursor, err := s.readTelemetryUsers(ctx, ids, cursor, q.PageSize)
+	if err != nil {
+		return nil, fmt.Errorf("user telemetry identity read failed: %w", err)
+	}
+	snapshot := usertelemetry.Snapshot{
+		SchemaVersion: usertelemetry.APIVersion,
+		Window:        usertelemetry.Window{Start: q.Start, End: q.End, Timezone: q.Timezone},
+		Users:         users, NextCursor: nextCursor,
+	}
+	if len(users) == 0 {
+		return json.Marshal(snapshot)
+	}
+	pageIDs := make([]int64, len(users))
+	for i := range users {
+		pageIDs[i], err = usertelemetry.ParseID(users[i].UserID)
+		if err != nil {
+			return nil, err
+		}
+	}
+	keys, err := s.readTelemetryAPIKeys(ctx, pageIDs)
+	if err != nil {
+		// The contract's APIKeys slice cannot distinguish an incomplete list
+		// from a complete empty list. Fail explicitly; never silently truncate.
+		return nil, fmt.Errorf("user telemetry API key read failed: %w", err)
+	}
+	keysObserved := s.telemetrySampleTime()
+	for i, id := range pageIDs {
+		if list := keys[id]; list != nil {
+			users[i].APIKeys = list
+		}
+		users[i].Quality.APIKeys = "fresh"
+		users[i].ObservedAt.APIKeys = &keysObserved
+	}
+
+	tokens, tokensErr := s.readTelemetryTokens(ctx, pageIDs, start, end)
+	if tokensErr == nil {
+		tokensObserved := s.telemetrySampleTime()
+		for i, id := range pageIDs {
+			total, found := tokens[id]
+			if !found {
+				// Only a successful complete GROUP BY read proves no usage.
+				total = "0"
+			}
+			users[i].TokenUsage.Total = &total
+			users[i].Quality.TokenUsage = "fresh"
+			users[i].ObservedAt.TokenUsage = &tokensObserved
+		}
+	}
+	// Daily status is independent of the caller-selected window total. Initialize
+	// explicit metadata even on failure, but never publish partial/unknown zeros.
+	for i := range users {
+		users[i].TokenUsage.Today = telemetryDailyWindow(dailyBounds.todayStart, dailyBounds.now)
+		users[i].TokenUsage.Yesterday = telemetryDailyWindow(dailyBounds.yesterdayStart, dailyBounds.todayStart)
+	}
+	daily, dailyErr := s.readTelemetryDailyTokens(ctx, pageIDs, dailyBounds)
+	if dailyErr == nil {
+		observed := s.telemetrySampleTime()
+		for i, id := range pageIDs {
+			totals, found := daily[id]
+			if !found {
+				// A complete successful GROUP BY scan proves absence for both days.
+				totals = telemetryDailyTotals{today: "0", yesterday: "0"}
+			}
+			users[i].TokenUsage.Today.Total = &totals.today
+			users[i].TokenUsage.Yesterday.Total = &totals.yesterday
+			users[i].TokenUsage.Today.Quality = "fresh"
+			users[i].TokenUsage.Yesterday.Quality = "fresh"
+			users[i].TokenUsage.Today.ObservedAt = &observed
+			users[i].TokenUsage.Yesterday.ObservedAt = &observed
+		}
+	}
+	s.readTelemetryConcurrency(ctx, users, pageIDs)
+	s.readTelemetryActiveModels(ctx, users, pageIDs)
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return json.Marshal(snapshot)
+}
+
+func (s *UserTelemetryService) telemetrySampleTime() string {
+	return s.now().UTC().Format(time.RFC3339Nano)
+}
+
+func (s *UserTelemetryService) readTelemetryUsers(ctx context.Context, ids []int64, cursor int64, pageSize int) ([]usertelemetry.User, *string, error) {
+	rows, err := s.db.QueryContext(ctx, userTelemetryUsersSQL, pq.Array(ids), cursor, pageSize+1)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer rows.Close()
+	users := make([]usertelemetry.User, 0, pageSize)
+	allowed := make(map[int64]bool, len(ids))
+	for _, id := range ids {
+		allowed[id] = true
+	}
+	previous := cursor
+	var hasMore bool
+	for rows.Next() {
+		var id int64
+		var email, username, status string
+		var limit int
+		if err := rows.Scan(&id, &email, &username, &limit, &status); err != nil {
+			return nil, nil, err
+		}
+		if !allowed[id] || id <= previous {
+			return nil, nil, errors.New("invalid user telemetry identity result")
+		}
+		previous = id
+		if len(users) == pageSize {
+			hasMore = true
+			continue
+		}
+		users = append(users, usertelemetry.User{
+			UserID: strconv.FormatInt(id, 10), Email: email, Username: username,
+			APIKeys:     []usertelemetry.APIKey{},
+			Concurrency: usertelemetry.Concurrency{Limit: limit},
+			Quality:     usertelemetry.Quality{Identity: "fresh", APIKeys: "unavailable", TokenUsage: "unavailable", Concurrency: "unavailable"},
+		})
+	}
+	if err := rows.Err(); err != nil {
+		return nil, nil, err
+	}
+	observed := s.telemetrySampleTime()
+	for i := range users {
+		users[i].ObservedAt.Identity = observed
+	}
+	if hasMore {
+		next := users[len(users)-1].UserID
+		return users, &next, nil
+	}
+	return users, nil, nil
+}
+
+func (s *UserTelemetryService) readTelemetryAPIKeys(ctx context.Context, ids []int64) (map[int64][]usertelemetry.APIKey, error) {
+	rows, err := s.db.QueryContext(ctx, userTelemetryAPIKeysSQL, pq.Array(ids), userTelemetryMaxAPIKeys+1)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	keys := make(map[int64][]usertelemetry.APIKey, len(ids))
+	allowed := make(map[int64]bool, len(ids))
+	for _, id := range ids {
+		allowed[id] = true
+	}
+	count := 0
+	for rows.Next() {
+		count++
+		if count > userTelemetryMaxAPIKeys {
+			return nil, ErrUserTelemetryAPIKeyLimit
+		}
+		var keyID, userID int64
+		var name, status string
+		if err := rows.Scan(&keyID, &userID, &name, &status); err != nil {
+			return nil, err
+		}
+		if keyID <= 0 || !allowed[userID] {
+			return nil, errors.New("invalid user telemetry API key result")
+		}
+		keys[userID] = append(keys[userID], usertelemetry.APIKey{ID: strconv.FormatInt(keyID, 10), Name: name, Status: status})
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return keys, nil
+}
+
+func (s *UserTelemetryService) readTelemetryTokens(ctx context.Context, ids []int64, start, end time.Time) (map[int64]string, error) {
+	rows, err := s.db.QueryContext(ctx, userTelemetryTokensSQL, pq.Array(ids), start, end)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	tokens := make(map[int64]string, len(ids))
+	allowed := make(map[int64]bool, len(ids))
+	for _, id := range ids {
+		allowed[id] = true
+	}
+	for rows.Next() {
+		var id int64
+		var total string
+		if err := rows.Scan(&id, &total); err != nil {
+			return nil, err
+		}
+		if _, duplicate := tokens[id]; duplicate || !allowed[id] || !telemetryDecimalInteger(total) {
+			return nil, errors.New("invalid user telemetry token aggregate")
+		}
+		tokens[id] = total
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return tokens, nil
+}
+
+func (s *UserTelemetryService) readTelemetryDailyTokens(ctx context.Context, ids []int64, bounds telemetryDailyBounds) (map[int64]telemetryDailyTotals, error) {
+	rows, err := s.db.QueryContext(ctx, userTelemetryDailyTokensSQL, pq.Array(ids), bounds.yesterdayStart, bounds.todayStart, bounds.now)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	allowed := make(map[int64]bool, len(ids))
+	for _, id := range ids {
+		allowed[id] = true
+	}
+	tokens := make(map[int64]telemetryDailyTotals, len(ids))
+	for rows.Next() {
+		var id int64
+		var total telemetryDailyTotals
+		if err := rows.Scan(&id, &total.today, &total.yesterday); err != nil {
+			return nil, err
+		}
+		if _, duplicate := tokens[id]; duplicate || !allowed[id] ||
+			!telemetryDecimalInteger(total.today) || !telemetryDecimalInteger(total.yesterday) {
+			return nil, errors.New("invalid user telemetry daily token aggregate")
+		}
+		tokens[id] = total
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	return tokens, nil
+}
+
+// PostgreSQL SUM(numeric)::text stays a decimal integer without any conversion
+// through float64 or int64; reject corrupt/negative counters instead of a zero.
+func telemetryDecimalInteger(value string) bool {
+	if value == "" {
+		return false
+	}
+	for _, digit := range value {
+		if digit < '0' || digit > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *UserTelemetryService) readTelemetryActiveModels(ctx context.Context, users []usertelemetry.User, ids []int64) {
+	// Always publish an explicit unavailable state for the new field. An idle
+	// user is represented by a successful empty model list, never by a missing
+	// field or by the last model seen in usage_logs.
+	for i := range users {
+		users[i].ActiveModels = &usertelemetry.ActiveModelSnapshot{
+			Models: []usertelemetry.ActiveModel{}, Quality: "unavailable",
+		}
+	}
+	if s == nil || s.concurrency == nil || len(ids) == 0 {
+		return
+	}
+	models, err := s.concurrency.ReadTelemetryActiveModels(ctx, ids)
+	if err != nil {
+		return
+	}
+	observed := s.telemetrySampleTime()
+	for i, id := range ids {
+		entries, ok := models[id]
+		if !ok {
+			// The service-level reader guarantees a complete requested scope;
+			// fail closed if an alternate implementation violates that contract.
+			continue
+		}
+		if entries == nil {
+			entries = []usertelemetry.ActiveModel{}
+		}
+		users[i].ActiveModels = &usertelemetry.ActiveModelSnapshot{
+			Models: entries, Quality: "partial", ObservedAt: &observed,
+		}
+	}
+}
+
+func (s *UserTelemetryService) readTelemetryConcurrency(ctx context.Context, users []usertelemetry.User, ids []int64) {
+	tracked := make([]UserWithConcurrency, 0, len(users))
+	for i, id := range ids {
+		if users[i].Concurrency.Limit <= 0 {
+			users[i].Quality.Concurrency = "untracked"
+			continue
+		}
+		tracked = append(tracked, UserWithConcurrency{ID: id, MaxConcurrency: users[i].Concurrency.Limit})
+	}
+	if len(tracked) == 0 || s.concurrency == nil || telemetryNilCache(s.concurrency.cache) {
+		return
+	}
+	load, err := s.concurrency.GetUsersLoadBatch(ctx, tracked)
+	if err != nil {
+		return
+	}
+	observed := s.telemetrySampleTime()
+	for i, id := range ids {
+		if users[i].Concurrency.Limit <= 0 {
+			continue
+		}
+		entry, found := load[id]
+		if !found || entry == nil || entry.UserID != id || entry.CurrentConcurrency < 0 {
+			continue
+		}
+		current := entry.CurrentConcurrency
+		users[i].Concurrency.Current = &current
+		users[i].Quality.Concurrency = "fresh"
+		users[i].ObservedAt.Concurrency = &observed
+	}
+}
+
+func telemetryNilCache(cache ConcurrencyCache) bool {
+	if cache == nil {
+		return true
+	}
+	// A typed nil pointer in an interface is also an uninitialized cache.
+	value := reflect.ValueOf(cache)
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		return value.IsNil()
+	default:
+		return false
+	}
+}
diff --git a/backend/internal/service/user_telemetry_active_models.go b/backend/internal/service/user_telemetry_active_models.go
new file mode 100644
index 000000000..d485673e5
--- /dev/null
+++ b/backend/internal/service/user_telemetry_active_models.go
@@ -0,0 +1,278 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	public "github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+)
+
+const (
+	TelemetryModelLeaseTTL          = 45 * time.Second
+	telemetryModelHeartbeatInterval = 12 * time.Second
+	telemetryModelOperationTimeout  = 2 * time.Second
+	telemetryModelWriteTimeout      = 100 * time.Millisecond
+	TelemetryActiveModelMaxRequests = 10000
+)
+
+var ErrTelemetryActiveModelsUnavailable = errors.New("telemetry active model cache unavailable")
+
+// TelemetryActiveModelCache is optional: it does not alter ConcurrencyCache or
+// admission control. Refresh and Update MUST only mutate existing, unexpired
+// leases; neither may resurrect a released lease. Reads must return an entry
+// (including an empty slice) for each requested user, and no other users.
+type TelemetryActiveModelCache interface {
+	RegisterTelemetryModel(context.Context, int64, string, string) error
+	RefreshTelemetryModel(context.Context, int64, string) (bool, error)
+	UpdateTelemetryModel(context.Context, int64, string, string) (bool, error)
+	ReleaseTelemetryModel(context.Context, int64, string) error
+	ReadTelemetryActiveModels(context.Context, []int64) (map[int64][]public.ActiveModel, error)
+}
+
+// ValidTelemetryModelName bounds both Redis payloads and public output. The
+// limit is 200 UTF-8 bytes (not runes); blank, invalid UTF-8, control and invisible
+// format characters are rejected. The original spelling is otherwise retained.
+func ValidTelemetryModelName(model string) bool {
+	if len(model) == 0 || len(model) > 200 || !utf8.ValidString(model) || strings.TrimSpace(model) == "" {
+		return false
+	}
+	for _, r := range model {
+		if unicode.IsControl(r) || unicode.Is(unicode.Cf, r) {
+			return false
+		}
+	}
+	return true
+}
+
+// TelemetryModelLease is metadata only. Its opaque random identity is private
+// and unrelated to gateway request IDs, API keys, accounts or request contents.
+// All writes are serialized under mu, including deletion. A failed model update
+// retires the lease instead of heartbeating a knowingly stale upstream model.
+// Redis outages may leave the last value until its bounded TTL; never block or
+// cancel the business request because telemetry failed.
+type TelemetryModelLease struct {
+	mu      sync.Mutex
+	cache   TelemetryActiveModelCache
+	ctx     context.Context
+	userID  int64
+	leaseID string
+	stopped bool
+	stop    chan struct{}
+	done    chan struct{}
+}
+
+// BeginTelemetryModel must be called AFTER admission and just before forwarding.
+// Missing support, invalid inputs and registration failure return a nil no-op
+// lease. It never cancels ctx and never changes business concurrency slots.
+func (s *ConcurrencyService) BeginTelemetryModel(ctx context.Context, userID int64, requestedModel string) *TelemetryModelLease {
+	if s == nil || s.cache == nil || userID <= 0 || !ValidTelemetryModelName(requestedModel) {
+		return nil
+	}
+	cache, ok := s.cache.(TelemetryActiveModelCache)
+	if !ok {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if ctx.Err() != nil {
+		return nil
+	}
+	var random [16]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return nil
+	}
+	l := &TelemetryModelLease{cache: cache, ctx: ctx, userID: userID, leaseID: hex.EncodeToString(random[:]), stop: make(chan struct{}), done: make(chan struct{})}
+	opCtx, cancel := context.WithTimeout(ctx, telemetryModelWriteTimeout)
+	err := cache.RegisterTelemetryModel(opCtx, userID, l.leaseID, requestedModel)
+	cancel()
+	// An error can mean the write succeeded but its acknowledgement was lost.
+	// Always attempt detached cleanup; TTL is the final safety net.
+	if err != nil || ctx.Err() != nil {
+		l.Release()
+		return nil
+	}
+	go l.run(telemetryModelHeartbeatInterval)
+	return l
+}
+
+func (l *TelemetryModelLease) run(interval time.Duration) {
+	defer close(l.done)
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-l.stop:
+			return
+		case <-l.ctx.Done():
+			l.Release()
+			return
+		case <-ticker.C:
+			l.refresh()
+		}
+	}
+}
+
+func (l *TelemetryModelLease) refresh() {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.stopped {
+		return
+	}
+	if l.cache == nil || l.ctx == nil || l.ctx.Err() != nil {
+		l.releaseLocked()
+		return
+	}
+	ctx, cancel := context.WithTimeout(l.ctx, telemetryModelOperationTimeout)
+	alive, err := l.cache.RefreshTelemetryModel(ctx, l.userID, l.leaseID)
+	cancel()
+	if l.ctx.Err() != nil || (err == nil && !alive) {
+		l.releaseLocked()
+	}
+	// A transient refresh error is allowed to recover, but the cache must reject
+	// an expired lease. Thus recovery cannot resurrect a crashed/expired request.
+}
+
+func (l *TelemetryModelLease) UpdateUpstream(model string) {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.stopped {
+		return
+	}
+	if l.cache == nil || l.ctx == nil || l.ctx.Err() != nil || !ValidTelemetryModelName(model) {
+		l.releaseLocked()
+		return
+	}
+	ctx, cancel := context.WithTimeout(l.ctx, telemetryModelWriteTimeout)
+	alive, err := l.cache.UpdateTelemetryModel(ctx, l.userID, l.leaseID, model)
+	cancel()
+	if err != nil || !alive || l.ctx.Err() != nil {
+		l.releaseLocked()
+	}
+}
+
+// Release is nil-safe and idempotent. On return no local writer can perform a
+// later heartbeat/update. Cleanup is detached from the cancelled request and
+// bounded to 100 milliseconds; if Redis is unreachable the record expires naturally.
+func (l *TelemetryModelLease) Release() {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if !l.stopped {
+		l.releaseLocked()
+	}
+}
+
+func (l *TelemetryModelLease) releaseLocked() {
+	l.stopped = true
+	if l.stop != nil {
+		close(l.stop)
+	}
+	if l.cache == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), telemetryModelWriteTimeout)
+	defer cancel()
+	_ = l.cache.ReleaseTelemetryModel(ctx, l.userID, l.leaseID)
+}
+
+type telemetryModelLeaseContextKey struct{}
+
+func WithTelemetryModelLease(ctx context.Context, lease *TelemetryModelLease) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, telemetryModelLeaseContextKey{}, lease)
+}
+
+// UpdateTelemetryModelFromContext is safe on routes with no telemetry hook.
+func UpdateTelemetryModelFromContext(ctx context.Context, upstream string) {
+	if ctx == nil {
+		return
+	}
+	lease, _ := ctx.Value(telemetryModelLeaseContextKey{}).(*TelemetryModelLease)
+	lease.UpdateUpstream(upstream)
+}
+
+// ReadTelemetryActiveModels never broadens scope or treats Redis failure as
+// idle. The caller must report unavailable on error, not substitute empty data.
+func (s *ConcurrencyService) ReadTelemetryActiveModels(ctx context.Context, userIDs []int64) (map[int64][]public.ActiveModel, error) {
+	ids, err := TelemetryActiveModelUserScope(userIDs)
+	if err != nil {
+		return nil, err
+	}
+	if len(ids) == 0 {
+		return map[int64][]public.ActiveModel{}, nil
+	}
+	if s == nil || s.cache == nil {
+		return nil, ErrTelemetryActiveModelsUnavailable
+	}
+	cache, ok := s.cache.(TelemetryActiveModelCache)
+	if !ok {
+		return nil, ErrTelemetryActiveModelsUnavailable
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(ctx, telemetryModelOperationTimeout)
+	defer cancel()
+	models, err := cache.ReadTelemetryActiveModels(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	if len(models) != len(ids) {
+		return nil, fmt.Errorf("telemetry model cache returned incomplete or excess user scope")
+	}
+	for _, id := range ids {
+		entries, exists := models[id]
+		if !exists {
+			return nil, fmt.Errorf("telemetry model cache returned incomplete user scope")
+		}
+		count := 0
+		for _, model := range entries {
+			if !ValidTelemetryModelName(model.RequestedModel) || (model.UpstreamModel != nil && !ValidTelemetryModelName(*model.UpstreamModel)) || model.Requests <= 0 || model.Requests > TelemetryActiveModelMaxRequests-count {
+				return nil, fmt.Errorf("invalid telemetry active model snapshot")
+			}
+			count += model.Requests
+		}
+	}
+	return models, nil
+}
+
+// TelemetryActiveModelUserScope validates and canonicalizes an explicit bounded
+// set. An empty set means no users, NEVER all users. Duplicates are harmless.
+func TelemetryActiveModelUserScope(userIDs []int64) ([]int64, error) {
+	if len(userIDs) > public.MaxPageSize {
+		return nil, fmt.Errorf("telemetry model scope exceeds %d users", public.MaxPageSize)
+	}
+	seen := make(map[int64]bool, len(userIDs))
+	ids := make([]int64, 0, len(userIDs))
+	for _, id := range userIDs {
+		if id <= 0 {
+			return nil, fmt.Errorf("invalid telemetry model user ID")
+		}
+		if !seen[id] {
+			ids = append(ids, id)
+			seen[id] = true
+		}
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	return ids, nil
+}
diff --git a/backend/internal/service/user_telemetry_active_models_test.go b/backend/internal/service/user_telemetry_active_models_test.go
new file mode 100644
index 000000000..3597f7135
--- /dev/null
+++ b/backend/internal/service/user_telemetry_active_models_test.go
@@ -0,0 +1,360 @@
+package service
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"reflect"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	public "github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"github.com/stretchr/testify/require"
+)
+
+type telemetryModelTestCache struct {
+	ConcurrencyCache                                        // No unrelated admission-control method is invoked.
+	mu                                                      sync.Mutex
+	records                                                 map[int64]map[string]public.ActiveModel
+	registerErr, refreshErr, updateErr, releaseErr, readErr error
+	missing                                                 bool
+	refreshCalls, updateCalls, releaseCalls                 int
+	registerIDs                                             []string
+	readIDs                                                 []int64
+	readOverride                                            map[int64][]public.ActiveModel
+	updateStarted, unblockUpdate                            chan struct{}
+	releaseCtxErr                                           error
+}
+
+func newTelemetryModelTestCache() *telemetryModelTestCache {
+	return &telemetryModelTestCache{records: make(map[int64]map[string]public.ActiveModel)}
+}
+func (c *telemetryModelTestCache) RegisterTelemetryModel(ctx context.Context, id int64, lease, model string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.records[id] == nil {
+		c.records[id] = make(map[string]public.ActiveModel)
+	}
+	c.records[id][lease] = public.ActiveModel{RequestedModel: model, Requests: 1}
+	c.registerIDs = append(c.registerIDs, lease)
+	return c.registerErr // Can model a write with lost acknowledgement.
+}
+func (c *telemetryModelTestCache) RefreshTelemetryModel(ctx context.Context, id int64, lease string) (bool, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.refreshCalls++
+	_, ok := c.records[id][lease]
+	return ok && !c.missing, c.refreshErr
+}
+func (c *telemetryModelTestCache) UpdateTelemetryModel(ctx context.Context, id int64, lease, model string) (bool, error) {
+	if c.updateStarted != nil {
+		close(c.updateStarted)
+		select {
+		case <-c.unblockUpdate:
+		case <-ctx.Done():
+			return false, ctx.Err()
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.updateCalls++
+	old, exists := c.records[id][lease]
+	if exists && c.updateErr == nil {
+		old.UpstreamModel = &model
+		c.records[id][lease] = old
+	}
+	return exists, c.updateErr
+}
+func (c *telemetryModelTestCache) ReleaseTelemetryModel(ctx context.Context, id int64, lease string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.releaseCalls++
+	c.releaseCtxErr = ctx.Err()
+	if c.releaseErr == nil {
+		delete(c.records[id], lease)
+	}
+	return c.releaseErr
+}
+func (c *telemetryModelTestCache) ReadTelemetryActiveModels(ctx context.Context, ids []int64) (map[int64][]public.ActiveModel, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readIDs = append([]int64(nil), ids...)
+	if c.readErr != nil {
+		return nil, c.readErr
+	}
+	if c.readOverride != nil {
+		return c.readOverride, nil
+	}
+	out := make(map[int64][]public.ActiveModel)
+	for _, id := range ids {
+		out[id] = []public.ActiveModel{}
+		for _, model := range c.records[id] {
+			out[id] = append(out[id], model)
+		}
+	}
+	return out, nil
+}
+func (c *telemetryModelTestCache) recordCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := 0
+	for _, records := range c.records {
+		n += len(records)
+	}
+	return n
+}
+func waitTelemetryModelDone(t *testing.T, lease *TelemetryModelLease) {
+	t.Helper()
+	select {
+	case <-lease.done:
+	case <-time.After(time.Second):
+		t.Fatal("telemetry heartbeat did not stop")
+	}
+}
+
+func TestTelemetryModelBeginUpdateContextAndRelease(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	s := NewConcurrencyService(c)
+	lease := s.BeginTelemetryModel(context.Background(), 7, "client-model")
+	require.NotNil(t, lease)
+	t.Cleanup(lease.Release)
+	require.Len(t, lease.leaseID, 32)
+	_, err := hex.DecodeString(lease.leaseID)
+	require.NoError(t, err)
+	data, err := s.ReadTelemetryActiveModels(context.Background(), []int64{7, 8})
+	require.NoError(t, err)
+	require.Equal(t, []public.ActiveModel{{RequestedModel: "client-model", Requests: 1}}, data[7])
+	require.Empty(t, data[8])
+	UpdateTelemetryModelFromContext(WithTelemetryModelLease(context.Background(), lease), "mapped-model")
+	data, err = s.ReadTelemetryActiveModels(context.Background(), []int64{7})
+	require.NoError(t, err)
+	require.Equal(t, "mapped-model", *data[7][0].UpstreamModel)
+	lease.refresh()
+	lease.Release()
+	lease.Release()
+	lease.UpdateUpstream("other")
+	lease.refresh()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+	require.Equal(t, 1, c.updateCalls)
+	require.Equal(t, 1, c.refreshCalls)
+	require.Equal(t, 1, c.releaseCalls)
+	data, err = s.ReadTelemetryActiveModels(context.Background(), []int64{7})
+	require.NoError(t, err)
+	require.NotNil(t, data[7])
+	require.Empty(t, data[7])
+	// Lease internals cannot leak through the public DTO.
+	require.Equal(t, 3, reflect.TypeOf(public.ActiveModel{}).NumField())
+}
+
+func TestTelemetryModelCancellationDeletesWithDetachedContext(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	ctx, cancel := context.WithCancel(context.Background())
+	lease := NewConcurrencyService(c).BeginTelemetryModel(ctx, 4, "model")
+	require.NotNil(t, lease)
+	cancel()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+	require.NoError(t, c.releaseCtxErr)
+	lease.refresh()
+	lease.UpdateUpstream("other")
+	require.Zero(t, c.updateCalls)
+	require.Zero(t, c.refreshCalls)
+}
+
+func TestTelemetryModelOptionalNoopAndValidation(t *testing.T) {
+	var nilService *ConcurrencyService
+	require.Nil(t, nilService.BeginTelemetryModel(context.Background(), 1, "m"))
+	require.Nil(t, NewConcurrencyService(nil).BeginTelemetryModel(context.Background(), 1, "m"))
+	// Embedding only the existing interface deliberately does not implement the new one.
+	unsupported := struct{ ConcurrencyCache }{}
+	require.Nil(t, NewConcurrencyService(unsupported).BeginTelemetryModel(context.Background(), 1, "m"))
+	c := newTelemetryModelTestCache()
+	s := NewConcurrencyService(c)
+	for _, model := range []string{"", "   ", "a\nb", "a\x00b", "a\x7fb", "a\u0085b", "a\u200bb", strings.Repeat("a", 201), string([]byte{255})} {
+		require.Nil(t, s.BeginTelemetryModel(context.Background(), 1, model), "%q", model)
+	}
+	require.True(t, ValidTelemetryModelName(strings.Repeat("a", 200)))
+	require.False(t, ValidTelemetryModelName(strings.Repeat("猫", 67)))
+	require.Nil(t, s.BeginTelemetryModel(context.Background(), 0, "m"))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.Nil(t, s.BeginTelemetryModel(ctx, 1, "m"))
+	require.Empty(t, c.registerIDs)
+	var nilLease *TelemetryModelLease
+	zeroLease := &TelemetryModelLease{}
+	zeroLease.UpdateUpstream("m")
+	zeroLease.Release()
+	nilLease.Release()
+	nilLease.UpdateUpstream("model")
+	nilLease.refresh()
+	UpdateTelemetryModelFromContext(nil, "m")
+	UpdateTelemetryModelFromContext(context.Background(), "m")
+	UpdateTelemetryModelFromContext(WithTelemetryModelLease(nil, nil), "m")
+}
+
+func TestTelemetryModelRegisterErrorCleansLostAcknowledgement(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	c.registerErr = errors.New("lost acknowledgement")
+	require.Nil(t, NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m"))
+	require.Zero(t, c.recordCount())
+	require.Equal(t, 1, c.releaseCalls)
+}
+
+func TestTelemetryModelUpdateFailureOrInvalidModelRetiresLease(t *testing.T) {
+	for _, scenario := range []string{"redis-error", "invalid-model", "missing"} {
+		t.Run(scenario, func(t *testing.T) {
+			c := newTelemetryModelTestCache()
+			lease := NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m")
+			require.NotNil(t, lease)
+			t.Cleanup(lease.Release)
+			model := "upstream"
+			switch scenario {
+			case "redis-error":
+				c.updateErr = errors.New("redis failure")
+			case "invalid-model":
+				model = "a\nb"
+			case "missing":
+				c.mu.Lock()
+				delete(c.records[1], lease.leaseID)
+				c.mu.Unlock()
+			}
+			lease.UpdateUpstream(model)
+			waitTelemetryModelDone(t, lease)
+			lease.refresh()
+			require.Zero(t, c.recordCount())
+			require.Zero(t, c.refreshCalls)
+		})
+	}
+}
+
+func TestTelemetryModelHeartbeatFailureRecoveryAndLeaseLoss(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	lease := NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m")
+	require.NotNil(t, lease)
+	t.Cleanup(lease.Release)
+	c.refreshErr = errors.New("temporary failure")
+	lease.refresh()
+	require.Equal(t, 1, c.recordCount())
+	c.refreshErr = nil
+	lease.refresh()
+	c.missing = true
+	lease.refresh()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+	require.Equal(t, 3, c.refreshCalls)
+}
+
+func TestTelemetryModelInternalHeartbeatStops(t *testing.T) {

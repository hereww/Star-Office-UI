+package repository
+
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	public "github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"github.com/redis/go-redis/v9"
+)
+
+var _ service.TelemetryActiveModelCache = (*concurrencyCache)(nil)
+
+// Only these two user-local keys are used. The hash tag co-locates them in Redis
+// Cluster; no global index/SCAN and no existing concurrency slot changes.
+func telemetryActiveModelKeys(userID int64) []string {
+	base := "telemetry:active_models:{" + strconv.FormatInt(userID, 10) + "}:"
+	return []string{base + "expiry", base + "models"}
+}
+
+type telemetryActiveModelRecord struct {
+	UserID         string  `json:"user_id"`
+	RequestedModel string  `json:"requested_model"`
+	UpstreamModel  *string `json:"upstream_model"`
+}
+
+// Every mutation and read is atomic within one user's hash slot. Redis TIME
+// avoids clock skew between hosts. Update/heartbeat first verify ownership AND
+// expiry; they cannot recreate entries deleted by Release or a previous read.
+// Cardinalities are checked before iteration to bound work on corrupt/oversized
+// keys. Release deliberately bypasses these checks so it can always clean up.
+var telemetryActiveModelScript = redis.NewScript(`
+redis.replicate_commands()
+local z, h = KEYS[1], KEYS[2]
+local op, id = ARGV[1], ARGV[2]
+if op == 'release' then
+ redis.call('ZREM', z, id)
+ redis.call('HDEL', h, id)
+ return 1
+end
+local max = tonumber(ARGV[4])
+if redis.call('ZCARD', z) > max or redis.call('HLEN', h) > max then
+ return redis.error_reply('telemetry active model limit exceeded')
+end
+local clock = redis.call('TIME')
+local now = tonumber(clock[1]) * 1000 + math.floor(tonumber(clock[2]) / 1000)
+local expired = redis.call('ZRANGEBYSCORE', z, '-inf', now)
+for _, member in ipairs(expired) do
+ redis.call('HDEL', h, member)
+ redis.call('ZREM', z, member)
+end
+if redis.call('ZCARD', z) ~= redis.call('HLEN', h) then
+ return redis.error_reply('telemetry active model index inconsistent')
+end
+if op == 'read' then
+ local members = redis.call('ZRANGE', z, 0, -1)
+ local result = {}
+ for _, member in ipairs(members) do
+  local value = redis.call('HGET', h, member)
+  if not value then return redis.error_reply('telemetry active model record missing') end
+  if string.len(value) > 2048 then return redis.error_reply('telemetry active model record too large') end
+  table.insert(result, value)
+ end
+ return result
+end
+local ttl = tonumber(ARGV[3])
+local score = redis.call('ZSCORE', z, id)
+local value = redis.call('HGET', h, id)
+if op == 'register' then
+ if score or value then return redis.error_reply('telemetry active model duplicate lease') end
+ if redis.call('ZCARD', z) >= max then return redis.error_reply('telemetry active model limit exceeded') end
+ redis.call('HSET', h, id, ARGV[5])
+elseif op == 'refresh' or op == 'update' then
+ if not score or not value or tonumber(score) <= now then return 0 end
+ if op == 'update' then
+  if string.len(value) > 2048 then return redis.error_reply('telemetry active model record too large') end
+  local valid, record = pcall(cjson.decode, value)
+  if not valid or type(record) ~= 'table' then return redis.error_reply('telemetry active model invalid JSON') end
+  record.upstream_model = ARGV[5]
+  redis.call('HSET', h, id, cjson.encode(record))
+ end
+else
+ return redis.error_reply('telemetry active model invalid operation')
+end
+redis.call('ZADD', z, now + ttl, id)
+redis.call('PEXPIRE', z, ttl)
+redis.call('PEXPIRE', h, ttl)
+return 1
+`)
+
+func (c *concurrencyCache) telemetryModelCommand(ctx context.Context, userID int64, leaseID, op, payload string) *redis.Cmd {
+	return telemetryActiveModelScript.Run(ctx, c.rdb, telemetryActiveModelKeys(userID), op, leaseID, service.TelemetryModelLeaseTTL.Milliseconds(), service.TelemetryActiveModelMaxRequests, payload)
+}
+
+func (c *concurrencyCache) validateTelemetryModelLease(userID int64, leaseID string) error {
+	if c == nil || c.rdb == nil {
+		return service.ErrTelemetryActiveModelsUnavailable
+	}
+	if userID <= 0 {
+		return fmt.Errorf("invalid telemetry model user ID")
+	}
+	raw, err := hex.DecodeString(leaseID)
+	if err != nil || len(raw) != 16 || hex.EncodeToString(raw) != leaseID {
+		return fmt.Errorf("invalid telemetry model lease ID")
+	}
+	return nil
+}
+
+func (c *concurrencyCache) RegisterTelemetryModel(ctx context.Context, userID int64, leaseID, requestedModel string) error {
+	if err := c.validateTelemetryModelLease(userID, leaseID); err != nil {
+		return err
+	}
+	if !service.ValidTelemetryModelName(requestedModel) {
+		return fmt.Errorf("invalid requested telemetry model")
+	}
+	payload, err := json.Marshal(telemetryActiveModelRecord{UserID: strconv.FormatInt(userID, 10), RequestedModel: requestedModel})
+	if err != nil {
+		return err
+	}
+	return c.telemetryModelCommand(ctx, userID, leaseID, "register", string(payload)).Err()
+}
+
+func (c *concurrencyCache) RefreshTelemetryModel(ctx context.Context, userID int64, leaseID string) (bool, error) {
+	if err := c.validateTelemetryModelLease(userID, leaseID); err != nil {
+		return false, err
+	}
+	n, err := c.telemetryModelCommand(ctx, userID, leaseID, "refresh", "").Int()
+	return n == 1 && err == nil, err
+}
+
+func (c *concurrencyCache) UpdateTelemetryModel(ctx context.Context, userID int64, leaseID, upstream string) (bool, error) {
+	if err := c.validateTelemetryModelLease(userID, leaseID); err != nil {
+		return false, err
+	}
+	if !service.ValidTelemetryModelName(upstream) {
+		return false, fmt.Errorf("invalid upstream telemetry model")
+	}
+	n, err := c.telemetryModelCommand(ctx, userID, leaseID, "update", upstream).Int()
+	return n == 1 && err == nil, err
+}
+
+func (c *concurrencyCache) ReleaseTelemetryModel(ctx context.Context, userID int64, leaseID string) error {
+	if err := c.validateTelemetryModelLease(userID, leaseID); err != nil {
+		return err
+	}
+	return c.telemetryModelCommand(ctx, userID, leaseID, "release", "").Err()
+}
+
+func (c *concurrencyCache) ReadTelemetryActiveModels(ctx context.Context, userIDs []int64) (map[int64][]public.ActiveModel, error) {
+	ids, err := service.TelemetryActiveModelUserScope(userIDs)
+	if err != nil {
+		return nil, err
+	}
+	result := make(map[int64][]public.ActiveModel, len(ids))
+	if len(ids) == 0 {
+		return result, nil
+	}
+	if c == nil || c.rdb == nil {
+		return nil, service.ErrTelemetryActiveModelsUnavailable
+	}
+	remaining := service.TelemetryActiveModelMaxRequests
+	for _, userID := range ids {
+		raw, err := c.telemetryModelCommand(ctx, userID, "", "read", "").StringSlice()
+		if err != nil {
+			return nil, fmt.Errorf("read telemetry active models: %w", err)
+		}
+		if len(raw) > remaining {
+			return nil, fmt.Errorf("telemetry active model snapshot exceeds total request limit")
+		}
+		remaining -= len(raw)
+		type modelKey struct {
+			requested, upstream string
+			known               bool
+		}
+		counts := make(map[modelKey]int)
+		for _, payload := range raw {
+			var record telemetryActiveModelRecord
+			decoder := json.NewDecoder(strings.NewReader(payload))
+			decoder.DisallowUnknownFields()
+			if err := decoder.Decode(&record); err != nil {
+				return nil, fmt.Errorf("invalid telemetry active model record")
+			}
+			var extra any
+			if err := decoder.Decode(&extra); err != io.EOF {
+				return nil, fmt.Errorf("invalid trailing telemetry active model JSON")
+			}
+			if record.UserID != strconv.FormatInt(userID, 10) || !service.ValidTelemetryModelName(record.RequestedModel) || (record.UpstreamModel != nil && !service.ValidTelemetryModelName(*record.UpstreamModel)) {
+				return nil, fmt.Errorf("invalid telemetry active model record scope or model")
+			}
+			key := modelKey{requested: record.RequestedModel, known: record.UpstreamModel != nil}
+			if key.known {
+				key.upstream = *record.UpstreamModel
+			}
+			counts[key]++
+		}
+		models := make([]public.ActiveModel, 0, len(counts))
+		for key, count := range counts {
+			model := public.ActiveModel{RequestedModel: key.requested, Requests: count}
+			if key.known {
+				upstream := key.upstream
+				model.UpstreamModel = &upstream
+			}
+			models = append(models, model)
+		}
+		sort.Slice(models, func(i, j int) bool {
+			a, b := models[i], models[j]
+			if a.RequestedModel != b.RequestedModel {
+				return a.RequestedModel < b.RequestedModel
+			}
+			if a.UpstreamModel == nil {
+				return b.UpstreamModel != nil
+			}
+			if b.UpstreamModel == nil {
+				return false
+			}
+			return *a.UpstreamModel < *b.UpstreamModel
+		})
+		result[userID] = models
+	}
+	return result, nil
+}

+func TestUserTelemetryDailyFailureInvalidatesBothDaysWholePage(t *testing.T) {
+	for _, kind := range []string{"query", "iteration", "close", "scan id", "null today", "null yesterday", "negative today", "negative yesterday", "decimal", "exponent", "NaN", "empty", "wrong user", "duplicate"} {
+		t.Run(kind, func(t *testing.T) {
+			svc, mock := newTelemetryTestService(t, nil)
+			mock.ExpectQuery(userTelemetryUsersSQL).WithArgs("{1,2}", int64(0), 101).WillReturnRows(telemetryUsersRows().AddRow(1, "a", "", 5, "active").AddRow(2, "b", "", 5, "active"))
+			mock.ExpectQuery(userTelemetryAPIKeysSQL).WithArgs("{1,2}", 10001).WillReturnRows(telemetryKeysRows())
+			mock.ExpectQuery(userTelemetryTokensSQL).WithArgs("{1,2}", sqlmock.AnyArg(), sqlmock.AnyArg()).WillReturnRows(telemetryTokensRows().AddRow(1, "123").AddRow(2, "456"))
+			expectation := mock.ExpectQuery(userTelemetryDailyTokensSQL).WithArgs("{1,2}", sqlmock.AnyArg(), sqlmock.AnyArg(), sqlmock.AnyArg())
+			rows := telemetryDailyTokensRows().AddRow(1, "42", "24")
+			switch kind {
+			case "query":
+				expectation.WillReturnError(errors.New("daily unavailable"))
+			case "iteration":
+				expectation.WillReturnRows(rows.AddRow(2, "99", "11").RowError(1, errors.New("incomplete daily result")))
+			case "close":
+				expectation.WillReturnRows(telemetryDailyTokensRows().CloseError(errors.New("close failed")))
+			case "scan id":
+				expectation.WillReturnRows(rows.AddRow("bad", "1", "2"))
+			case "null today":
+				expectation.WillReturnRows(rows.AddRow(2, nil, "1"))
+			case "null yesterday":
+				expectation.WillReturnRows(rows.AddRow(2, "1", nil))
+			case "negative today":
+				expectation.WillReturnRows(rows.AddRow(2, "-1", "1"))
+			case "negative yesterday":
+				expectation.WillReturnRows(rows.AddRow(2, "1", "-1"))
+			case "decimal":
+				expectation.WillReturnRows(rows.AddRow(2, "1.5", "1"))
+			case "exponent":
+				expectation.WillReturnRows(rows.AddRow(2, "1", "1e9"))
+			case "NaN":
+				expectation.WillReturnRows(rows.AddRow(2, "NaN", "1"))
+			case "empty":
+				expectation.WillReturnRows(rows.AddRow(2, "1", ""))
+			case "wrong user":
+				expectation.WillReturnRows(rows.AddRow(3, "1", "1"))
+			case "duplicate":
+				expectation.WillReturnRows(rows.AddRow(1, "1", "1"))
+			}
+			snapshot, raw := readTelemetrySnapshot(t, svc, `{"user_ids":["1","2"]}`)
+			for _, user := range snapshot.Users {
+				require.NotNil(t, user.TokenUsage.Total)
+				require.Equal(t, "fresh", user.Quality.TokenUsage)
+				for _, day := range []*usertelemetry.DailyTokenUsage{user.TokenUsage.Today, user.TokenUsage.Yesterday} {
+					require.NotNil(t, day)
+					require.Nil(t, day.Total)
+					require.Equal(t, "unavailable", day.Quality)
+					require.Nil(t, day.ObservedAt)
+				}
+			}
+			require.Contains(t, string(raw), `"total":null,"quality":"unavailable","observed_at":null`)
+		})
+	}
+}

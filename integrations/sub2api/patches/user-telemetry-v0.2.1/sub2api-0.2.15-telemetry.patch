+package service
+
+import "context"
+
+// TelemetryModelLeaseFromContext carries metadata into a decorated forwarding
+// context without losing its routing/billing values. The lease is never output.
+func TelemetryModelLeaseFromContext(ctx context.Context) *TelemetryModelLease {
+	if ctx == nil {
+		return nil
+	}
+	lease, _ := ctx.Value(telemetryModelLeaseContextKey{}).(*TelemetryModelLease)
+	return lease
+}

@@ -0,0 +1,147 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+)
+
+func TestValidateAcceptanceMetadata(t *testing.T) {
+	validBase := strings.Repeat("a", 40)
+	tests := []struct {
+		name        string
+		hostVersion string
+		hostBase    string
+		reportDate  string
+		wantErr     bool
+	}{
+		{name: "valid release metadata", hostVersion: "0.2.14", hostBase: validBase, reportDate: "2026-10-08"},
+		{name: "valid prerelease and build metadata", hostVersion: "0.2.14-rc.1+build.7", hostBase: validBase, reportDate: "2026-10-08"},
+		{name: "missing host version", hostBase: validBase, reportDate: "2026-10-08", wantErr: true},
+		{name: "leading v is not accepted", hostVersion: "v0.2.14", hostBase: validBase, reportDate: "2026-10-08", wantErr: true},
+		{name: "invalid host version", hostVersion: "0.2", hostBase: validBase, reportDate: "2026-10-08", wantErr: true},
+		{name: "host base is too short", hostVersion: "0.2.14", hostBase: validBase[:39], reportDate: "2026-10-08", wantErr: true},
+		{name: "host base is not hexadecimal", hostVersion: "0.2.14", hostBase: strings.Repeat("g", 40), reportDate: "2026-10-08", wantErr: true},
+		{name: "missing report date", hostVersion: "0.2.14", hostBase: validBase, wantErr: true},
+		{name: "invalid report date", hostVersion: "0.2.14", hostBase: validBase, reportDate: "2026-02-30", wantErr: true},
+		{name: "report date has wrong format", hostVersion: "0.2.14", hostBase: validBase, reportDate: "2026/10/08", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if err := validateAcceptanceMetadata(tt.hostVersion, tt.hostBase, tt.reportDate); (err != nil) != tt.wantErr {
+				t.Fatalf("validateAcceptanceMetadata() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestReportIncludesHostVersion(t *testing.T) {
+	raw, err := json.Marshal(&report{
+		Date:        "2026-10-08",
+		HostVersion: "0.2.14",
+		HostBase:    strings.Repeat("a", 40),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got map[string]any
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["host_version"] != "0.2.14" {
+		t.Fatalf("host_version = %v, want 0.2.14", got["host_version"])
+	}
+}
+
+func TestValidateUninstallPreservation(t *testing.T) {
+	baseline := businessTableBaseline{Users: 4, APIKeys: 4, UsageLogs: 7}
+	tests := []struct {
+		name        string
+		before      businessTableBaseline
+		after       businessTableBaseline
+		credentials int64
+		wantError   string
+	}{
+		{name: "daily fixtures preserved", before: baseline, after: baseline},
+		{name: "fixture growth is not hard-coded", before: businessTableBaseline{8, 21, 123}, after: businessTableBaseline{8, 21, 123}},
+		{name: "users removed", before: baseline, after: businessTableBaseline{3, 4, 7}, wantError: "business table row counts changed"},
+		{name: "API keys removed", before: baseline, after: businessTableBaseline{4, 3, 7}, wantError: "business table row counts changed"},
+		{name: "daily usage rows removed", before: baseline, after: businessTableBaseline{4, 4, 5}, wantError: "business table row counts changed"},
+		{name: "unexpected row insertion", before: baseline, after: businessTableBaseline{4, 4, 8}, wantError: "business table row counts changed"},
+		{name: "credentials remain", before: baseline, after: baseline, credentials: 1, wantError: "uninstall left 1 plugin credentials"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := validateUninstallPreservation(tt.before, tt.after, tt.credentials)
+			if tt.wantError == "" {
+				if err != nil {
+					t.Fatal(err)
+				}
+			} else if err == nil || !strings.Contains(err.Error(), tt.wantError) {
+				t.Fatalf("error = %v, want %q", err, tt.wantError)
+			}
+		})
+	}
+}
+
+func TestReadBusinessTableBaseline(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	mock.ExpectQuery(regexp.QuoteMeta(businessTableBaselineSQL)).WillReturnRows(sqlmock.NewRows([]string{"users", "api_keys", "usage_logs"}).AddRow(4, 4, 7))
+	got, err := readBusinessTableBaseline(context.Background(), db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := (businessTableBaseline{Users: 4, APIKeys: 4, UsageLogs: 7}); got != want {
+		t.Fatalf("baseline = %+v, want %+v", got, want)
+	}
+	if err := mock.ExpectationsWereMet(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestReadBusinessTableBaselinePropagatesFailure(t *testing.T) {
+	for _, scanFailure := range []bool{false, true} {
+		name := "query failure"
+		if scanFailure {
+			name = "scan failure"
+		}
+		t.Run(name, func(t *testing.T) {
+			db, mock, err := sqlmock.New()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			readFailure := errors.New("fixture database unavailable")
+			expect := mock.ExpectQuery(regexp.QuoteMeta(businessTableBaselineSQL))
+			if scanFailure {
+				expect.WillReturnRows(sqlmock.NewRows([]string{"users", "api_keys", "usage_logs"}).AddRow(4, 4, "not-a-count"))
+			} else {
+				expect.WillReturnError(readFailure)
+			}
+			got, err := readBusinessTableBaseline(context.Background(), db)
+			if err == nil {
+				t.Fatal("baseline read failure must not become a confirmed empty baseline")
+			}
+			if !scanFailure && !errors.Is(err, readFailure) {
+				t.Fatalf("error does not wrap database failure: %v", err)
+			}
+			if got != (businessTableBaseline{}) {
+				t.Fatalf("returned partial baseline on failure: %+v", got)
+			}
+			if err := mock.ExpectationsWereMet(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}

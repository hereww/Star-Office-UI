+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	lease := &TelemetryModelLease{cache: c, ctx: ctx, userID: 1, leaseID: strings.Repeat("a", 32), stop: make(chan struct{}), done: make(chan struct{})}
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 1, lease.leaseID, "model"))
+	go lease.run(time.Millisecond)
+	t.Cleanup(lease.Release)
+	require.Eventually(t, func() bool { c.mu.Lock(); defer c.mu.Unlock(); return c.refreshCalls >= 2 }, time.Second, time.Millisecond)
+	cancel()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+}
+
+func TestTelemetryModelReleaseSerializesWithUpdateAndHeartbeat(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	c.updateStarted = make(chan struct{})
+	c.unblockUpdate = make(chan struct{})
+	lease := NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m")
+	require.NotNil(t, lease)
+	t.Cleanup(lease.Release)
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() { defer wg.Done(); lease.UpdateUpstream("upstream") }()
+	<-c.updateStarted
+	var releaseStarted atomic.Bool
+	wg.Add(1)
+	go func() { defer wg.Done(); releaseStarted.Store(true); lease.Release() }()
+	require.Eventually(t, releaseStarted.Load, time.Second, time.Millisecond)
+	for range 30 {
+		wg.Add(1)
+		go func() { defer wg.Done(); lease.refresh() }()
+	}
+	close(c.unblockUpdate)
+	wg.Wait()
+	waitTelemetryModelDone(t, lease)
+	require.Zero(t, c.recordCount())
+	before := c.refreshCalls
+	lease.refresh()
+	lease.UpdateUpstream("late")
+	require.Equal(t, before, c.refreshCalls)
+	require.Equal(t, 1, c.releaseCalls)
+}
+
+func TestTelemetryModelReleaseFailureStillStopsLocalWriters(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	c.releaseErr = errors.New("redis down")
+	lease := NewConcurrencyService(c).BeginTelemetryModel(context.Background(), 1, "m")
+	lease.Release()
+	waitTelemetryModelDone(t, lease)
+	lease.refresh()
+	lease.UpdateUpstream("late")
+	require.Equal(t, 1, c.recordCount(), "Redis TTL must reap this orphan")
+	require.Zero(t, c.refreshCalls)
+	require.Zero(t, c.updateCalls)
+}
+
+func TestTelemetryModelReadScopeFailuresNeverBecomeIdle(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	s := NewConcurrencyService(c)
+	data, err := s.ReadTelemetryActiveModels(context.Background(), []int64{8, 1, 8})
+	require.NoError(t, err)
+	require.Len(t, data, 2)
+	require.Equal(t, []int64{1, 8}, c.readIDs)
+	data, err = s.ReadTelemetryActiveModels(context.Background(), nil)
+	require.NoError(t, err)
+	require.Empty(t, data)
+	for _, ids := range [][]int64{{0}, {-1}, make([]int64, public.MaxPageSize+1)} {
+		data, err = s.ReadTelemetryActiveModels(context.Background(), ids)
+		require.Error(t, err)
+		require.Nil(t, data)
+	}
+	c.readErr = errors.New("redis offline")
+	data, err = s.ReadTelemetryActiveModels(context.Background(), []int64{1})
+	require.Error(t, err)
+	require.Nil(t, data)
+	c.readErr = nil
+	for _, output := range []map[int64][]public.ActiveModel{
+		{}, {2: {}}, {1: {}, 2: {}},
+		{1: {{RequestedModel: "m", Requests: 0}}},
+		{1: {{RequestedModel: "m", Requests: 10001}}},
+		{1: {{RequestedModel: "m", Requests: 10000}, {RequestedModel: "n", Requests: 1}}},
+		{1: {{RequestedModel: "a\nb", Requests: 1}}},
+	} {
+		c.readOverride = output
+		data, err = s.ReadTelemetryActiveModels(context.Background(), []int64{1})
+		require.Error(t, err)
+		require.Nil(t, data)
+	}
+	var absent *ConcurrencyService
+	data, err = absent.ReadTelemetryActiveModels(context.Background(), []int64{1})
+	require.ErrorIs(t, err, ErrTelemetryActiveModelsUnavailable)
+	require.Nil(t, data)
+	data, err = NewConcurrencyService(struct{ ConcurrencyCache }{}).ReadTelemetryActiveModels(context.Background(), []int64{1})
+	require.ErrorIs(t, err, ErrTelemetryActiveModelsUnavailable)
+	require.Nil(t, data)
+}
+
+func TestTelemetryModelLeaseRandomPerRequest(t *testing.T) {
+	c := newTelemetryModelTestCache()
+	s := NewConcurrencyService(c)
+	a := s.BeginTelemetryModel(context.Background(), 1, "m")
+	b := s.BeginTelemetryModel(context.Background(), 1, "m")
+	require.NotNil(t, a)
+	require.NotNil(t, b)
+	defer a.Release()
+	defer b.Release()
+	require.NotEqual(t, a.leaseID, b.leaseID)
+	require.Equal(t, 2, c.recordCount())
+}

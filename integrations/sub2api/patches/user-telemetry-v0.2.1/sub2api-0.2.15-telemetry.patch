+func telemetryModelRepoFixture(t *testing.T) (*concurrencyCache, *miniredis.Miniredis, context.Context) {
+	t.Helper()
+	mr := miniredis.RunT(t)
+	mr.SetTime(time.Date(2026, 10, 8, 12, 0, 0, 0, time.UTC))
+	client := redis.NewClient(&redis.Options{Addr: mr.Addr(), MaxRetries: -1})
+	t.Cleanup(func() { _ = client.Close() })
+	return NewConcurrencyCache(client, 15, 60).(*concurrencyCache), mr, context.Background()
+}
+func telemetryModelTestID(n int) string { return fmt.Sprintf("%032x", n) }
+
+func TestTelemetryModelRepoRegisterUpdateReleaseAndTTL(t *testing.T) {
+	c, mr, ctx := telemetryModelRepoFixture(t)
+	id := telemetryModelTestID(1)
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 7, id, "requested"))
+	keys := telemetryActiveModelKeys(7)
+	require.Equal(t, "telemetry:active_models:{7}:expiry", keys[0])
+	require.Equal(t, "telemetry:active_models:{7}:models", keys[1])
+	require.Len(t, mr.Keys(), 2)
+	for _, key := range keys {
+		require.Equal(t, 45*time.Second, mr.TTL(key))
+	}
+	models, err := c.ReadTelemetryActiveModels(ctx, []int64{7})
+	require.NoError(t, err)
+	require.Equal(t, []public.ActiveModel{{RequestedModel: "requested", Requests: 1}}, models[7])
+	alive, err := c.UpdateTelemetryModel(ctx, 7, id, "upstream")
+	require.NoError(t, err)
+	require.True(t, alive)
+	models, err = c.ReadTelemetryActiveModels(ctx, []int64{7})
+	require.NoError(t, err)
+	require.Equal(t, "upstream", *models[7][0].UpstreamModel)
+	mr.FastForward(12 * time.Second)
+	mr.SetTime(time.Date(2026, 10, 8, 12, 0, 12, 0, time.UTC))
+	alive, err = c.RefreshTelemetryModel(ctx, 7, id)
+	require.NoError(t, err)
+	require.True(t, alive)
+	for _, key := range keys {
+		require.Equal(t, 45*time.Second, mr.TTL(key))
+	}
+	require.NoError(t, c.ReleaseTelemetryModel(ctx, 7, id))
+	require.NoError(t, c.ReleaseTelemetryModel(ctx, 7, id))
+	alive, err = c.RefreshTelemetryModel(ctx, 7, id)
+	require.NoError(t, err)
+	require.False(t, alive)
+	alive, err = c.UpdateTelemetryModel(ctx, 7, id, "late")
+	require.NoError(t, err)
+	require.False(t, alive)
+	require.Empty(t, mr.Keys(), "heartbeat/update must not recreate deleted keys")
+}
+
+func TestTelemetryModelRepoCrashExpiryAndExpiredMemberNotRevived(t *testing.T) {
+	for _, operation := range []string{"read", "refresh", "update"} {
+		t.Run(operation, func(t *testing.T) {
+			c, mr, ctx := telemetryModelRepoFixture(t)
+			old, live := telemetryModelTestID(1), telemetryModelTestID(2)
+			require.NoError(t, c.RegisterTelemetryModel(ctx, 1, old, "crashed"))
+			mr.FastForward(30 * time.Second)
+			mr.SetTime(time.Date(2026, 10, 8, 12, 0, 30, 0, time.UTC))
+			require.NoError(t, c.RegisterTelemetryModel(ctx, 1, live, "live-other-instance"))
+			mr.FastForward(16 * time.Second)
+			mr.SetTime(time.Date(2026, 10, 8, 12, 0, 46, 0, time.UTC))
+			switch operation {
+			case "read":
+				_, err := c.ReadTelemetryActiveModels(ctx, []int64{1})
+				require.NoError(t, err)
+			case "refresh":
+				alive, err := c.RefreshTelemetryModel(ctx, 1, old)
+				require.NoError(t, err)
+				require.False(t, alive)
+			case "update":
+				alive, err := c.UpdateTelemetryModel(ctx, 1, old, "late")
+				require.NoError(t, err)
+				require.False(t, alive)
+			}
+			keys := telemetryActiveModelKeys(1)
+			exists, err := c.rdb.HExists(ctx, keys[1], old).Result()
+			require.NoError(t, err)
+			require.False(t, exists)
+			models, err := c.ReadTelemetryActiveModels(ctx, []int64{1})
+			require.NoError(t, err)
+			require.Equal(t, []public.ActiveModel{{RequestedModel: "live-other-instance", Requests: 1}}, models[1])
+			mr.FastForward(46 * time.Second)
+			require.Empty(t, mr.Keys(), "a process crash expires both keys")
+			models, err = c.ReadTelemetryActiveModels(ctx, []int64{1})
+			require.NoError(t, err)
+			require.NotNil(t, models[1])
+			require.Empty(t, models[1])
+		})
+	}
+}
+
+func TestTelemetryModelRepoExactExpiryBoundary(t *testing.T) {
+	c, mr, ctx := telemetryModelRepoFixture(t)
+	id := telemetryModelTestID(1)
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 1, id, "m"))
+	// SetTime advances Redis TIME without expiring the physical keys. The
+	// per-member score must reject ownership exactly at the boundary anyway.
+	mr.SetTime(time.Date(2026, 10, 8, 12, 0, 45, 0, time.UTC))
+	alive, err := c.RefreshTelemetryModel(ctx, 1, id)
+	require.NoError(t, err)
+	require.False(t, alive)
+	models, err := c.ReadTelemetryActiveModels(ctx, []int64{1})
+	require.NoError(t, err)
+	require.Empty(t, models[1])
+}
+
+func TestTelemetryModelRepoAggregationStableOrderingScopeAndMultiInstance(t *testing.T) {
+	c, mr, ctx := telemetryModelRepoFixture(t)
+	otherClient := redis.NewClient(&redis.Options{Addr: mr.Addr(), MaxRetries: -1})
+	defer otherClient.Close()
+	other := NewConcurrencyCache(otherClient, 15, 60).(*concurrencyCache)
+	for i, name := range []string{"z", "a", "a", "a", "a"} {
+		cache := c
+		if i%2 == 0 {
+			cache = other
+		}
+		id := telemetryModelTestID(i + 1)
+		require.NoError(t, cache.RegisterTelemetryModel(ctx, 1, id, name))
+		if i == 1 || i == 2 {
+			alive, err := cache.UpdateTelemetryModel(ctx, 1, id, "mapped-b")
+			require.NoError(t, err)
+			require.True(t, alive)
+		}
+		if i == 3 {
+			alive, err := cache.UpdateTelemetryModel(ctx, 1, id, "mapped-a")
+			require.NoError(t, err)
+			require.True(t, alive)
+		}
+	}
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 9, telemetryModelTestID(99), "out-of-scope"))
+	// Corrupting an unrequested user must not even be observed by this read.
+	require.NoError(t, c.rdb.Set(ctx, telemetryActiveModelKeys(9)[0], "wrong-type", 0).Err())
+	expected := []public.ActiveModel{
+		{RequestedModel: "a", Requests: 1},
+		{RequestedModel: "a", UpstreamModel: telemetryModelString("mapped-a"), Requests: 1},
+		{RequestedModel: "a", UpstreamModel: telemetryModelString("mapped-b"), Requests: 2},
+		{RequestedModel: "z", Requests: 1},
+	}
+	for range 5 {
+		models, err := other.ReadTelemetryActiveModels(ctx, []int64{7, 1, 7})
+		require.NoError(t, err)
+		require.Len(t, models, 2)
+		require.Equal(t, expected, models[1])
+		require.NotNil(t, models[7])
+		require.Empty(t, models[7])
+	}
+	models, err := other.ReadTelemetryActiveModels(ctx, nil)
+	require.NoError(t, err)
+	require.Empty(t, models)
+}
+func telemetryModelString(value string) *string { return &value }
+
+func TestTelemetryModelRepoInvalidInputAndUnavailable(t *testing.T) {
+	c, _, ctx := telemetryModelRepoFixture(t)
+	for _, model := range []string{"", " ", "x\ny", "x\x00y", "x\u200by", strings.Repeat("x", 201), string([]byte{255})} {
+		require.Error(t, c.RegisterTelemetryModel(ctx, 1, telemetryModelTestID(1), model))
+		_, err := c.UpdateTelemetryModel(ctx, 1, telemetryModelTestID(1), model)
+		require.Error(t, err)
+	}
+	for _, id := range []string{"", "request-id", strings.Repeat("A", 32), strings.Repeat("a", 34)} {
+		require.Error(t, c.RegisterTelemetryModel(ctx, 1, id, "model"))
+		require.Error(t, c.ReleaseTelemetryModel(ctx, 1, id))
+	}
+	require.Error(t, c.RegisterTelemetryModel(ctx, 0, telemetryModelTestID(1), "model"))
+	for _, ids := range [][]int64{{-1}, {0}, make([]int64, public.MaxPageSize+1)} {
+		models, err := c.ReadTelemetryActiveModels(ctx, ids)
+		require.Error(t, err)
+		require.Nil(t, models)
+	}
+	for _, cache := range []*concurrencyCache{nil, {}} {
+		require.ErrorIs(t, cache.RegisterTelemetryModel(ctx, 1, telemetryModelTestID(1), "m"), service.ErrTelemetryActiveModelsUnavailable)
+		models, err := cache.ReadTelemetryActiveModels(ctx, []int64{1})
+		require.ErrorIs(t, err, service.ErrTelemetryActiveModelsUnavailable)
+		require.Nil(t, models)
+	}
+}
+
+func TestTelemetryModelRepoRedisErrorNotIdle(t *testing.T) {
+	c, mr, ctx := telemetryModelRepoFixture(t)
+	require.NoError(t, c.RegisterTelemetryModel(ctx, 1, telemetryModelTestID(1), "m"))
+	mr.SetError("ERR telemetry test failure")
+	models, err := c.ReadTelemetryActiveModels(ctx, []int64{1})
+	require.Error(t, err)
+	require.Nil(t, models)
+	require.Error(t, c.RegisterTelemetryModel(ctx, 1, telemetryModelTestID(2), "m"))
+	alive, err := c.RefreshTelemetryModel(ctx, 1, telemetryModelTestID(1))
+	require.Error(t, err)
+	require.False(t, alive)
+	alive, err = c.UpdateTelemetryModel(ctx, 1, telemetryModelTestID(1), "next")
+	require.Error(t, err)
+	require.False(t, alive)
+	require.Error(t, c.ReleaseTelemetryModel(ctx, 1, telemetryModelTestID(1)))
+	mr.SetError("")
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	models, err = c.ReadTelemetryActiveModels(cancelled, []int64{1})
+	require.Error(t, err)
+	require.Nil(t, models)
+}
+
+func TestTelemetryModelRepoLimitAndCorruptionReturnError(t *testing.T) {
+	for _, kind := range []string{"over-limit-zset", "over-limit-hash", "missing-hash", "orphan-hash", "wrong-user", "bad-model", "unknown-field", "huge-json"} {
+		t.Run(kind, func(t *testing.T) {
+			c, _, ctx := telemetryModelRepoFixture(t)
+			id := telemetryModelTestID(1)
+			require.NoError(t, c.RegisterTelemetryModel(ctx, 1, id, "m"))
+			keys := telemetryActiveModelKeys(1)
+			switch kind {
+			case "over-limit-zset":
+				values := make([]redis.Z, 10001)
+				for i := range values {
+					values[i] = redis.Z{Score: 2e12, Member: telemetryModelTestID(i + 1)}
+				}
+				require.NoError(t, c.rdb.ZAdd(ctx, keys[0], values...).Err())
+			case "over-limit-hash":
+				values := make(map[string]any, 10001)
+				for i := range 10001 {
+					values[telemetryModelTestID(i+1)] = "{}"
+				}
+				require.NoError(t, c.rdb.HSet(ctx, keys[1], values).Err())
+			case "missing-hash":
+				require.NoError(t, c.rdb.HDel(ctx, keys[1], id).Err())
+			case "orphan-hash":
+				require.NoError(t, c.rdb.HSet(ctx, keys[1], telemetryModelTestID(2), "{}").Err())
+			case "wrong-user":
+				require.NoError(t, c.rdb.HSet(ctx, keys[1], id, `{"user_id":"2","requested_model":"m","upstream_model":null}`).Err())
+			case "bad-model":
+				require.NoError(t, c.rdb.HSet(ctx, keys[1], id, `{"user_id":"1","requested_model":"m\n","upstream_model":null}`).Err())
+			case "unknown-field":
+				require.NoError(t, c.rdb.HSet(ctx, keys[1], id, `{"user_id":"1","requested_model":"m","body":"forbidden"}`).Err())
+			case "huge-json":
+				require.NoError(t, c.rdb.HSet(ctx, keys[1], id, strings.Repeat("x", 2049)).Err())
+			}
+			models, err := c.ReadTelemetryActiveModels(ctx, []int64{1})
+			require.Error(t, err)
+			require.Nil(t, models)
+			require.NoError(t, c.ReleaseTelemetryModel(ctx, 1, id), "Release can still remove its lease when reads fail")
+		})
+	}
+}
+
+func TestTelemetryModelRepoMaximumAllowedAndNoDuplicateRegistration(t *testing.T) {
+	c, _, ctx := telemetryModelRepoFixture(t)
+	keys := telemetryActiveModelKeys(1)
+	zvalues := make([]redis.Z, 10000)
+	hvalues := make(map[string]any, 10000)
+	for i := range zvalues {
+		id := telemetryModelTestID(i + 1)
+		zvalues[i] = redis.Z{Score: 2e12, Member: id}
+		hvalues[id] = `{"user_id":"1","requested_model":"m","upstream_model":null}`
+	}
+	require.NoError(t, c.rdb.ZAdd(ctx, keys[0], zvalues...).Err())
+	require.NoError(t, c.rdb.HSet(ctx, keys[1], hvalues).Err())
+	models, err := c.ReadTelemetryActiveModels(ctx, []int64{1})
+	require.NoError(t, err)
+	require.Equal(t, []public.ActiveModel{{RequestedModel: "m", Requests: 10000}}, models[1])
+	require.Error(t, c.RegisterTelemetryModel(ctx, 1, telemetryModelTestID(10001), "m"))
+	require.Error(t, c.RegisterTelemetryModel(ctx, 1, telemetryModelTestID(1), "replacement"))
+}
+
+func TestTelemetryModelRepoServiceLifecycleAndLargeUserID(t *testing.T) {
+	c, _, ctx := telemetryModelRepoFixture(t)
+	s := service.NewConcurrencyService(c)
+	// cjson update must preserve a string identity beyond JavaScript's 2^53.
+	const userID int64 = 9007199254740993
+	reqCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	lease := s.BeginTelemetryModel(reqCtx, userID, "requested")
+	require.NotNil(t, lease)
+	defer lease.Release()
+	lease.UpdateUpstream("upstream")
+	models, err := s.ReadTelemetryActiveModels(ctx, []int64{userID})
+	require.NoError(t, err)
+	require.Equal(t, "upstream", *models[userID][0].UpstreamModel)
+	cancel()
+	require.Eventually(t, func() bool {
+		models, err := s.ReadTelemetryActiveModels(ctx, []int64{userID})
+		return err == nil && len(models[userID]) == 0
+	}, time.Second, time.Millisecond)
+}

+<!doctype html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>用户数据 · 插件配置</title>
+<style>
+:root{color-scheme:light dark;--bg:#f6f5f1;--surface:#fff;--ink:#222d2a;--muted:#606e67;--line:#d8ded8;--accent:#246851;--error:#a32c28}
+*{box-sizing:border-box}body{margin:0;padding:24px;background:var(--bg);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.6}main{max-width:640px;margin:auto}header{border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:22px}.eyebrow{margin:0;color:var(--accent);font-size:11px;letter-spacing:.1em;font-weight:600}h1{font-size:23px;font-weight:600;margin:5px 0}p{margin:6px 0}.muted,.hint{color:var(--muted);font-size:12px}.notice{background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--accent);padding:12px 14px;margin-bottom:22px}label{display:block;font-weight:600;margin-bottom:6px}textarea,input{width:100%;border:1px solid var(--line);border-radius:4px;background:var(--surface);color:var(--ink);padding:10px 12px;font:inherit}textarea{resize:vertical;min-height:116px;font-family:"SFMono-Regular",Consolas,monospace;line-height:1.5}textarea:focus,input:focus{outline:2px solid var(--accent);outline-offset:2px}.field{margin-bottom:20px}.row{display:grid;grid-template-columns:2fr 1fr;gap:18px}.actions{display:flex;flex-wrap:wrap;gap:10px;border-top:1px solid var(--line);padding-top:18px}button{border:1px solid var(--line);border-radius:4px;background:var(--surface);color:var(--ink);padding:9px 14px;font:inherit;cursor:pointer}button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}#feedback{margin-top:14px;min-height:24px;font-size:13px}#feedback[data-level=error]{color:var(--error)}footer{margin-top:16px;font-size:11px;color:var(--muted)}@media(max-width:440px){body{padding:16px}.row{grid-template-columns:1fr;gap:0}.actions button{flex:1}}
+@media(prefers-color-scheme:dark){:root{--bg:#19211e;--surface:#222d28;--ink:#e7ede8;--muted:#adbbb1;--line:#405047;--accent:#409778;--error:#ffb1a8}}
+</style>
+</head>
+<body>
+<main>
+<header><p class="eyebrow">READ-ONLY TELEMETRY / 0.2.1</p><h1>用户数据输出</h1><p class="muted">仅配置授权范围，不修改模型请求、路由或计费。</p></header>
+<div class="notice">输出授权账号数据：<strong>邮箱、用户名、API Key 元数据、今日/昨日 Token 用量、实时模型、用户并发</strong>。<p class="hint">API 仅含 ID、名称和状态；不输出明文密钥、密码、OAuth 凭据或模型正文。消费端访问授权由宿主管理。</p></div>
+<section id="config-form" aria-label="插件配置">
+<div class="field"><label for="user-ids">授权用户 ID</label><textarea id="user-ids" aria-describedby="ids-hint" placeholder="42&#10;43" autocomplete="off" spellcheck="false" required></textarea><p class="hint" id="ids-hint">每行一个，或用逗号分隔；1–500 个不重复的正整数 ID，不接受邮箱。默认无授权范围，不能启用。</p></div>
+<div class="row"><div class="field"><label for="timezone">统计时区</label><input id="timezone" value="Asia/Shanghai" aria-describedby="tz-hint" autocomplete="off" spellcheck="false"><p class="hint" id="tz-hint">IANA 时区，例如 Asia/Shanghai 或 UTC。</p></div><div class="field"><label for="page-size">每页用户数（可选）</label><input id="page-size" type="number" min="1" max="500" step="1" inputmode="numeric" placeholder="100" aria-describedby="page-hint"><p class="hint" id="page-hint">1–500；留空使用默认值。</p></div></div>
+<div class="actions"><button id="save" class="primary" type="button" disabled>保存配置</button><button id="test" type="button" disabled>保存并测试</button><button id="load" type="button" disabled>重新加载</button></div>
+</section>
+<p id="feedback" role="status" aria-live="polite" aria-atomic="true">正在连接宿主…</p>
+<footer>com.lvdong.user-telemetry · sandbox bridge v1 · 不读取父页面、Cookie 或宿主存储</footer>
+</main>
+<script>
+(() => {
+ 'use strict';
+ const ids = document.getElementById('user-ids'), timezone = document.getElementById('timezone'), page = document.getElementById('page-size');
+ const buttons = ['save','test','load'].map(id => document.getElementById(id));
+ const feedback = document.getElementById('feedback');
+ const token = new URLSearchParams(window.location.hash.slice(1)).get('bridge_token');
+ const hostOrigin = new URL(window.location.href).origin;
+ const referrerOrigin = document.referrer ? new URL(document.referrer).origin : hostOrigin;
+ const pending = new Map(); let closed = false, sequence = 0, busy = false;
+ function message(text, level = 'info') { feedback.textContent = text; feedback.dataset.level = level; }
+ function setBusy(value) { busy = value; buttons.forEach(button => { button.disabled = value || closed; }); }
+ // Assets and their parent are hosted on the same origin. Pin that exact origin;
+ // never trust the first message or send sensitive config to a wildcard target.
+ if (!token || window.parent === window || !/^https?:$/.test(new URL(window.location.href).protocol) || hostOrigin !== referrerOrigin) {
+  message('未建立可信宿主会话，请从 Sub2API 插件配置页打开。', 'error'); return;
+ }
+ function send(type, extra = {}, requestID) {
+  if (closed) throw new Error('closed');
+  window.parent.postMessage({source:'sub2api-plugin-ui',bridge_token:token,type,...extra,...(requestID ? {request_id:requestID} : {})}, hostOrigin);
+ }
+ // randomUUID may be absent on HTTP LAN pages. Keep 128-bit secure entropy
+ // plus a monotonic sequence; never downgrade to Math.random or a counter alone.
+ function nextRequestID() {
+  if (!Number.isSafeInteger(sequence) || sequence >= Number.MAX_SAFE_INTEGER) throw new Error('secure_random_unavailable');
+  const secureCrypto = typeof crypto !== 'undefined' ? crypto : null;
+  let randomID;
+  if (secureCrypto && typeof secureCrypto.randomUUID === 'function') {
+   try { randomID = secureCrypto.randomUUID(); } catch (_) { /* Try secure getRandomValues below. */ }
+  }
+  if (typeof randomID !== 'string' || !randomID) {
+   if (!secureCrypto || typeof secureCrypto.getRandomValues !== 'function') throw new Error('secure_random_unavailable');
+   const bytes = new Uint8Array(16);
+   secureCrypto.getRandomValues(bytes);
+   randomID = Array.from(bytes, byte => byte.toString(16).padStart(2,'0')).join('');
+  }
+  return `${randomID}-${++sequence}`;
+ }
+ function request(type, extra = {}) {
+  return new Promise((resolve,reject) => {
+   if (closed) { reject(new Error('closed')); return; }
+   let id;
+   try { id = nextRequestID(); } catch (_) { cleanup();reject(new Error('secure_random_unavailable'));return; }
+   const timer = setTimeout(() => { pending.delete(id); reject(new Error('timeout')); }, 15000);
+   pending.set(id,{resolve,reject,timer,type});
+   try { send(type,extra,id); } catch (error) { clearTimeout(timer);pending.delete(id);reject(error); }
+  });
+ }
+ function onMessage(event) {
+  if (closed || event.source !== window.parent || event.origin !== hostOrigin) return;
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data) || data.source !== 'sub2api-plugin-host' || data.bridge_token !== token || typeof data.request_id !== 'string') return;
+  const wait = pending.get(data.request_id);
+  if (!wait || data.type !== `${wait.type}.result` || typeof data.ok !== 'boolean') return;
+  pending.delete(data.request_id); clearTimeout(wait.timer);
+  if (data.ok) wait.resolve(data); else wait.reject(new Error('host_rejected'));
+ }
+ function canonicalIDs(values) {
+  if (!Array.isArray(values) || values.length > 500 || new Set(values).size !== values.length || values.some(id => typeof id !== 'string' || !/^[1-9][0-9]{0,18}$/.test(id) || BigInt(id) > 9223372036854775807n)) throw new Error('用户 ID 必须是 1–500 个不重复的正整数，且不能超过 int64 范围。');
+  return values;
+ }
+ function showConfig(config) {
+  if (!config || typeof config !== 'object' || Array.isArray(config) || Object.keys(config).some(key => !['allowed_user_ids','timezone','page_size'].includes(key))) throw new Error('invalid_config');
+  const list = canonicalIDs(config.allowed_user_ids ?? []);
+  if (config.timezone !== undefined && typeof config.timezone !== 'string') throw new Error('invalid_config');
+  if (config.page_size !== undefined && (!Number.isInteger(config.page_size) || config.page_size < 1 || config.page_size > 500)) throw new Error('invalid_config');
+  ids.value = list.join('\n'); timezone.value = config.timezone || 'Asia/Shanghai'; page.value = config.page_size === undefined ? '' : String(config.page_size);
+ }
+ function readForm() {
+  const list = canonicalIDs(ids.value.trim().split(/[\s,，]+/).filter(Boolean));
+  if (!list.length) throw new Error('请填写至少一个授权用户 ID；默认无范围不能启用。');
+  const zone = timezone.value.trim() || 'Asia/Shanghai';
+  try { new Intl.DateTimeFormat('zh-CN',{timeZone:zone}); } catch (_) { throw new Error('请填写有效的 IANA 时区。'); }
+  const config = {allowed_user_ids:list,timezone:zone};
+  if (page.value !== '') { const size = Number(page.value); if (!Number.isInteger(size) || size < 1 || size > 500) throw new Error('每页用户数必须为 1–500。'); config.page_size = size; }
+  return config;
+ }
+ async function load() {
+  if (busy) return; setBusy(true);message('正在加载已保存配置…');
+  try { const data = await request('config.load');showConfig(data.config);message(ids.value ? '已加载配置。' : '已加载默认配置；请先设置授权用户范围。'); }
+  catch (error) { message(error.message === 'secure_random_unavailable' ? '当前环境缺少安全随机数能力，无法建立配置请求；请使用支持安全随机数的浏览器。' : '加载失败或宿主响应超时，请重试。','error'); }
+  finally { setBusy(false); resize(); }
+ }
+ async function save(test) {
+  if (busy) return;
+  let config; try { config = readForm(); } catch (error) { message(error.message,'error'); return; }
+  setBusy(true);message('正在保存配置，请完成宿主验证…');
+  let saved = false;
+  try {
+   const data = await request('config.save',{config});showConfig(data.config);saved = true;
+   if (test) { message('配置已保存，正在测试只读数据能力…'); const tested = await request('config.test'); if (!tested.result || tested.result.success !== true) throw new Error('test_failed'); message('配置已保存，测试通过。'); }
+   else message('配置已保存。');
+   send('ui.notify',{level:'success',message:test ? '用户数据配置已保存，测试通过。' : '用户数据配置已保存。'});
+  } catch (_) { message(saved ? '配置已保存，但测试未通过或响应超时；请确认插件已启用且宿主支持只读数据能力。' : '未确认保存成功（宿主拒绝或响应超时）；请重新加载核对后再重试。','error'); }
+  finally { setBusy(false);resize(); }
+ }
+ function resize() { if (!closed) send('ui.resize',{height:Math.min(1600,Math.ceil(document.documentElement.scrollHeight))}); }
+ function cleanup() {
+  closed = true; window.removeEventListener('message',onMessage);window.removeEventListener('resize',resize);
+  for (const wait of pending.values()) {clearTimeout(wait.timer);wait.reject(new Error('closed'));}pending.clear();setBusy(true);
+ }
+ window.addEventListener('message',onMessage);window.addEventListener('resize',resize);window.addEventListener('pagehide',cleanup,{once:true});
+ document.getElementById('save').addEventListener('click',() => {void save(false);});
+ document.getElementById('test').addEventListener('click',() => {void save(true);});document.getElementById('load').addEventListener('click',() => {void load();});
+ send('sub2api.plugin.ready');resize();void load();
+})();
+</script>
+</body>
+</html>
diff --git a/backend/internal/handler/admin/plugin_user_telemetry.go b/backend/internal/handler/admin/plugin_user_telemetry.go
new file mode 100644
index 000000000..eea9a9a0a
--- /dev/null
+++ b/backend/internal/handler/admin/plugin_user_telemetry.go
@@ -0,0 +1,283 @@
+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"github.com/gin-gonic/gin"
+	"golang.org/x/time/rate"
+)
+
+// ReadUserTelemetry is admin-only; ReadUserTelemetryExternal accepts no admin or model credentials.
+func (h *PluginHandler) ReadUserTelemetry(c *gin.Context) {
+	id, ok := telemetryPluginID(c)
+	if !ok {
+		return
+	}
+	allowed, err := h.manager.GetTelemetryAllowedUsers(c.Request.Context(), id)
+	if err != nil {
+		response.Error(c, 503, "telemetry plugin unavailable")
+		return
+	}
+	h.readTelemetry(c, id, allowed)
+}
+func (h *PluginHandler) ReadUserTelemetryExternal(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	c.Header("Vary", "Authorization")
+	id, ok := telemetryPluginID(c)
+	if !ok {
+		return
+	}
+	if c.Query("token") != "" || c.Query("api_key") != "" {
+		response.Error(c, 400, "credentials must use Authorization header")
+		return
+	}
+	auth := strings.Fields(c.GetHeader("Authorization"))
+	if len(auth) != 2 || !strings.EqualFold(auth[0], "Bearer") || !strings.HasPrefix(auth[1], "s2ut_") || len(auth[1]) != 48 || h.telemetryCredentials == nil {
+		response.Error(c, 401, "invalid telemetry credential")
+		return
+	}
+	// Bound unauthenticated database work as well as successful exports. This
+	// per-host budget is deliberately independent of admin/model credentials.
+	if !telemetryAuthenticationBudget.begin() {
+		response.Error(c, 429, "too many telemetry authentication requests")
+		return
+	}
+	defer telemetryAuthenticationBudget.end()
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 5*time.Second)
+	defer cancel()
+	cred, err := h.telemetryCredentials.Authenticate(ctx, id, service.UserTelemetrySecretHash(auth[1]))
+	if err != nil {
+		if errors.Is(err, service.ErrTelemetryUnauthorized) {
+			response.Error(c, 401, "invalid telemetry credential")
+		} else {
+			response.Error(c, 503, "telemetry authentication unavailable")
+		}
+		return
+	}
+	// Clamp old issued scopes to the installation's current approval. Revoking a user takes effect immediately.
+	allowed, err := h.manager.GetTelemetryAllowedUsers(ctx, id)
+	if err != nil {
+		response.Error(c, 503, "telemetry plugin unavailable")
+		return
+	}
+	current := map[string]bool{}
+	for _, s := range allowed {
+		current[s] = true
+	}
+	scope := make([]string, 0)
+	for _, s := range cred.UserIDs {
+		if current[s] {
+			scope = append(scope, s)
+		}
+	}
+	if len(scope) == 0 {
+		response.Error(c, 403, "credential scope no longer approved")
+		return
+	}
+	h.readTelemetry(c, id, scope)
+}
+
+type telemetryAuthGuard struct {
+	inFlight atomic.Int32
+	limiter  *rate.Limiter
+}
+
+func newTelemetryAuthGuard() *telemetryAuthGuard {
+	return &telemetryAuthGuard{limiter: rate.NewLimiter(20, 40)}
+}
+func (g *telemetryAuthGuard) begin() bool {
+	if !g.limiter.Allow() {
+		return false
+	}
+	if g.inFlight.Add(1) > 16 {
+		g.inFlight.Add(-1)
+		return false
+	}
+	return true
+}
+func (g *telemetryAuthGuard) end() { g.inFlight.Add(-1) }
+
+var telemetryAuthenticationBudget = newTelemetryAuthGuard()
+
+// Limit concurrent export queries per host. DB timeouts bound abandoned/slow calls.
+var telemetryExportInFlight atomic.Int32
+
+func (h *PluginHandler) readTelemetry(c *gin.Context, id int64, scope []string) {
+	c.Header("Cache-Control", "no-store")
+	c.Header("Vary", "Authorization")
+	if telemetryExportInFlight.Add(1) > 8 {
+		telemetryExportInFlight.Add(-1)
+		response.Error(c, 429, "too many telemetry queries")
+		return
+	}
+	defer telemetryExportInFlight.Add(-1)
+	q := usertelemetry.Query{Start: c.Query("start"), End: c.Query("end"), Timezone: c.Query("timezone"), Cursor: c.Query("cursor")}
+	if s := c.Query("user_ids"); s != "" {
+		q.UserIDs = strings.Split(s, ",")
+	}
+	if s := c.Query("page_size"); s != "" {
+		v, e := strconv.Atoi(s)
+		if e != nil || v < 1 || v > usertelemetry.MaxPageSize {
+			response.Error(c, 400, "invalid page_size")
+			return
+		}
+		q.PageSize = v
+	}
+	q, err := q.Restrict(scope)
+	if err != nil {
+		response.Error(c, 403, "user outside authorized scope")
+		return
+	}
+	// Validate HTTP input without replacing omitted defaults. The manager freezes
+	// the window using the persisted timezone/page_size before crossing RPC.
+	_, _, _, err = q.Normalize(time.Now())
+	if err != nil {
+		response.Error(c, 400, err.Error())
+		return
+	}
+	raw, err := json.Marshal(q)
+	if err != nil {
+		response.Error(c, 400, "invalid query")
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 5*time.Second)
+	defer cancel()
+	result, err := h.manager.UserTelemetry(ctx, id, raw)
+	if err != nil {
+		response.Error(c, 503, "telemetry query unavailable")
+		return
+	}
+	// Return direct versioned JSON, unlike the admin-management envelope.
+	c.Data(http.StatusOK, "application/json; charset=utf-8", result)
+}
+func (h *PluginHandler) CreateTelemetryCredential(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	id, ok := telemetryPluginID(c)
+	if !ok {
+		return
+	}
+	var req struct {
+		Name      string   `json:"name"`
+		UserIDs   []string `json:"user_ids"`
+		ExpiresIn int64    `json:"expires_in_seconds"`
+	}
+	dec := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 16384))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&req); err != nil || strings.TrimSpace(req.Name) == "" || len(req.Name) > 100 || req.ExpiresIn < 60 || req.ExpiresIn > 31*86400 || len(req.UserIDs) == 0 || len(req.UserIDs) > usertelemetry.MaxPageSize {
+		response.Error(c, 400, "name, approved user_ids and expiry 60..2678400 seconds required")
+		return
+	}
+	if err := dec.Decode(new(any)); err != io.EOF {
+		response.Error(c, 400, "exactly one credential JSON object required")
+		return
+	}
+	if h.telemetryCredentials == nil {
+		response.Error(c, 503, "credential store unavailable")
+		return
+	}
+	scope, err := h.manager.GetTelemetryAllowedUsers(c.Request.Context(), id)
+	if err != nil {
+		response.Error(c, 503, "telemetry plugin unavailable")
+		return
+	}
+	q, err := (usertelemetry.Query{UserIDs: req.UserIDs}).Restrict(scope)
+	if err != nil {
+		response.Error(c, 403, "user outside approved scope")
+		return
+	}
+	if _, _, _, err = q.Normalize(time.Now()); err != nil {
+		response.Error(c, 400, "invalid scope")
+		return
+	}
+	token, hash, err := service.NewUserTelemetrySecret()
+	if err != nil {
+		response.Error(c, 500, "credential generation failed")
+		return
+	}
+	credential := &service.UserTelemetryCredential{PluginID: id, Name: req.Name, UserIDs: q.UserIDs, TokenHash: hash, ExpiresAt: time.Now().Add(time.Duration(req.ExpiresIn) * time.Second)}
+	if err = h.telemetryCredentials.Create(c.Request.Context(), credential); err != nil {
+		response.Error(c, 503, "credential store unavailable")
+		return
+	}
+	// The raw token is disclosed once to the authenticated issuing administrator; never logged or persisted.
+	response.Created(c, gin.H{"credential": credential, "token": token})
+}
+func (h *PluginHandler) ListTelemetryCredentials(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	id, ok := telemetryPluginID(c)
+	if !ok {
+		return
+	}
+	if h.telemetryCredentials == nil {
+		response.Error(c, 503, "credential store unavailable")
+		return
+	}
+	var cursor int64
+	if value := c.Query("cursor"); value != "" {
+		var err error
+		cursor, err = usertelemetry.ParseID(value)
+		if err != nil {
+			response.Error(c, 400, "invalid credential cursor")
+			return
+		}
+	}
+	pageSize := 100
+	if value := c.Query("page_size"); value != "" {
+		var err error
+		pageSize, err = strconv.Atoi(value)
+		if err != nil || pageSize < 1 || pageSize > 500 {
+			response.Error(c, 400, "credential page_size must be 1..500")
+			return
+		}
+	}
+	list, err := h.telemetryCredentials.List(c.Request.Context(), id, cursor, pageSize)
+	if err != nil {
+		response.Error(c, 503, "credential store unavailable")
+		return
+	}
+	response.Success(c, list)
+}
+func (h *PluginHandler) RevokeTelemetryCredential(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	id, ok := telemetryPluginID(c)
+	if !ok {
+		return
+	}
+	credID, err := strconv.ParseInt(c.Param("credential_id"), 10, 64)
+	if err != nil || credID <= 0 {
+		response.Error(c, 400, "invalid credential id")
+		return
+	}
+	if h.telemetryCredentials == nil {
+		response.Error(c, 503, "credential store unavailable")
+		return
+	}
+	if err = h.telemetryCredentials.Revoke(c.Request.Context(), id, credID); err != nil {
+		if errors.Is(err, service.ErrTelemetryCredentialNotFound) {
+			response.Error(c, 404, "credential not found")
+		} else {
+			response.Error(c, 503, "credential store unavailable")
+		}
+		return
+	}
+	response.Success(c, gin.H{"revoked": true})
+}
+func telemetryPluginID(c *gin.Context) (int64, bool) {
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || id <= 0 {
+		response.Error(c, 400, "invalid plugin id")
+		return 0, false
+	}
+	return id, true
+}
diff --git a/backend/internal/handler/admin/plugin_user_telemetry_test.go b/backend/internal/handler/admin/plugin_user_telemetry_test.go
new file mode 100644
index 000000000..bb9faf167
--- /dev/null
+++ b/backend/internal/handler/admin/plugin_user_telemetry_test.go
@@ -0,0 +1,177 @@
+package admin
+
+import (
+	"context"
+	"errors"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"golang.org/x/time/rate"
+)
+
+type telemetryCredentialStub struct {
+	calls    int
+	authErr  error
+	page     *service.UserTelemetryCredentialPage
+	cursor   int64
+	pageSize int
+}
+
+func (s *telemetryCredentialStub) Create(context.Context, *service.UserTelemetryCredential) error {
+	s.calls++
+	return errors.New("not implemented")
+}
+func (s *telemetryCredentialStub) Authenticate(context.Context, int64, []byte) (*service.UserTelemetryCredential, error) {
+	s.calls++
+	return nil, s.authErr
+}
+func (s *telemetryCredentialStub) List(_ context.Context, _ int64, cursor int64, pageSize int) (*service.UserTelemetryCredentialPage, error) {
+	s.calls++
+	s.cursor = cursor
+	s.pageSize = pageSize
+	return s.page, nil
+}
+func (s *telemetryCredentialStub) Revoke(context.Context, int64, int64) error { s.calls++; return nil }
+func telemetryTestRequest(h *PluginHandler, method, path, body, auth string, handler gin.HandlerFunc) *httptest.ResponseRecorder {
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	r.Handle(method, "/plugins/:id/user-telemetry", handler)
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	req.Header.Set("Authorization", auth)
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(w, req)
+	return w
+}
+func TestUserTelemetryRejectsOrdinaryCredentials(t *testing.T) {
+	store := &telemetryCredentialStub{authErr: service.ErrTelemetryUnauthorized}
+	h := &PluginHandler{telemetryCredentials: store}
+	for _, auth := range []string{"", "Bearer admin-jwt", "Bearer sk-model-key", "Basic abc", "Bearer s2ut_short"} {
+		w := telemetryTestRequest(h, "GET", "/plugins/1/user-telemetry", "", auth, h.ReadUserTelemetryExternal)
+		if w.Code != 401 {
+			t.Fatalf("ordinary credential accepted: code %d", w.Code)
+		}
+	}
+	if store.calls != 0 {
+		t.Fatal("ordinary credential caused an authentication query")
+	}
+}
+func TestUserTelemetryRejectsURLCredential(t *testing.T) {
+	store := &telemetryCredentialStub{authErr: service.ErrTelemetryUnauthorized}
+	h := &PluginHandler{telemetryCredentials: store}
+	for _, key := range []string{"token", "api_key"} {
+		w := telemetryTestRequest(h, "GET", "/plugins/1/user-telemetry?"+key+"=secret", "", "Bearer s2ut_"+strings.Repeat("a", 43), h.ReadUserTelemetryExternal)
+		if w.Code != 400 {
+			t.Fatal("URL credential accepted")
+		}
+	}
+	if store.calls != 0 {
+		t.Fatal("URL credential caused a query")
+	}
+}
+func TestUserTelemetryAuthenticationFailureIsNotEmptySuccess(t *testing.T) {
+	for _, tc := range []struct {
+		err  error
+		code int
+	}{{service.ErrTelemetryUnauthorized, 401}, {errors.New("database unavailable"), 503}} {
+		store := &telemetryCredentialStub{authErr: tc.err}
+		h := &PluginHandler{telemetryCredentials: store}
+		w := telemetryTestRequest(h, "GET", "/plugins/1/user-telemetry", "", "Bearer s2ut_"+strings.Repeat("a", 43), h.ReadUserTelemetryExternal)
+		if w.Code != tc.code || store.calls != 1 || w.Header().Get("Cache-Control") != "no-store" {
+			t.Fatalf("auth failure: %d calls %d", w.Code, store.calls)
+		}
+	}
+}
+func TestUserTelemetryCredentialRequiresExplicitScope(t *testing.T) {
+	store := &telemetryCredentialStub{}
+	h := &PluginHandler{telemetryCredentials: store}
+	for _, body := range []string{`{"name":"consumer","expires_in_seconds":3600}`, `{"name":"consumer","user_ids":[],"expires_in_seconds":3600}`, `{"name":"consumer","user_ids":null,"expires_in_seconds":3600}`, `{"name":"consumer","user_ids":["42"],"expires_in_seconds":3600} {}`} {
+		w := telemetryTestRequest(h, "POST", "/plugins/1/user-telemetry", body, "", h.CreateTelemetryCredential)
+		if w.Code != 400 {
+			t.Fatalf("ambiguous credential scope accepted: %d", w.Code)
+		}
+	}
+	if store.calls != 0 {
+		t.Fatal("invalid issue request caused a write")
+	}
+}
+func TestUserTelemetryAuthenticationBudgetBoundsBeforeDatabase(t *testing.T) {
+	g := newTelemetryAuthGuard()
+	g.limiter = rate.NewLimiter(rate.Inf, 40)
+	for range 16 {
+		if !g.begin() {
+			t.Fatal("budget rejected below limit")
+		}
+	}
+	if g.begin() {
+		t.Fatal("auth in-flight work not bounded")
+	}
+	if g.inFlight.Load() != 16 {
+		t.Fatal("overload leaked a slot")
+	}
+	g.end()
+	if !g.begin() {
+		t.Fatal("slot release not reusable")
+	}
+	for range 16 {
+		g.end()
+	}
+	if g.inFlight.Load() != 0 {
+		t.Fatal("budget leaked slots")
+	}
+	g = newTelemetryAuthGuard()
+	g.limiter = rate.NewLimiter(0, 2)
+	for range 2 {
+		if !g.begin() {
+			t.Fatal("rate burst rejected")
+		}
+		g.end()
+	}
+	if g.begin() {
+		t.Fatal("auth rate unbounded")
+	}
+}
+func TestUserTelemetryCredentialListHasExplicitPage(t *testing.T) {
+	cursor := "77"
+	store := &telemetryCredentialStub{page: &service.UserTelemetryCredentialPage{Credentials: []service.UserTelemetryCredential{{ID: 78, UserIDs: []string{"42"}, TokenHash: []byte("not-visible")}}, NextCursor: &cursor}}
+	h := &PluginHandler{telemetryCredentials: store}
+	w := telemetryTestRequest(h, "GET", "/plugins/1/user-telemetry?cursor=80&page_size=1", "", "", h.ListTelemetryCredentials)
+	if w.Code != 200 || store.cursor != 80 || store.pageSize != 1 || !strings.Contains(w.Body.String(), `"next_cursor":"77"`) || strings.Contains(w.Body.String(), "not-visible") {
+		t.Fatalf("credential pagination failed: %d", w.Code)
+	}
+	for _, query := range []string{"cursor=01", "cursor=-1", "page_size=501", "page_size=0"} {
+		w = telemetryTestRequest(h, "GET", "/plugins/1/user-telemetry?"+query, "", "", h.ListTelemetryCredentials)
+		if w.Code != 400 {
+			t.Fatalf("invalid credential page accepted: %s", query)
+		}
+	}
+	if store.calls != 1 {
+		t.Fatal("invalid page queried store")
+	}
+}

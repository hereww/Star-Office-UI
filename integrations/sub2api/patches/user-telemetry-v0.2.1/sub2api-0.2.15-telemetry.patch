+}
+
+func TestTelemetryHostUpdateGuardRejectsUpdateAndRollbackWithoutSideEffects(t *testing.T) {
+	client := &telemetryGuardGitHubClient{
+		latest: &GitHubRelease{
+			TagName: "v0.2.15",
+			Assets: []GitHubAsset{{
+				Name:               "sub2api-darwin-arm64.tar.gz",
+				BrowserDownloadURL: "https://objects.githubusercontent.com/archive.tar.gz",
+				Size:               32,
+			}},
+		},
+		recent: []*GitHubRelease{{
+			TagName: "v0.2.13",
+			Assets: []GitHubAsset{{
+				Name:               "sub2api-darwin-arm64.tar.gz",
+				BrowserDownloadURL: "https://objects.githubusercontent.com/archive.tar.gz",
+				Size:               32,
+			}},
+		}},
+	}
+	cache := &updateServiceCacheStub{data: "unchanged"}
+	svc := NewUpdateService(cache, client, "0.2.14", "telemetry")
+
+	for name, call := range map[string]func() error{
+		"perform update": func() error { return svc.PerformUpdate(context.Background()) },
+		"specific rollback": func() error {
+			return svc.RollbackToVersion(context.Background(), "0.2.13")
+		},
+		"local rollback": func() error { return svc.Rollback() },
+		"release asset application": func() error {
+			return svc.applyReleaseAssets(context.Background(), []Asset{{
+				Name:        "sub2api-darwin-arm64.tar.gz",
+				DownloadURL: "https://objects.githubusercontent.com/archive.tar.gz",
+				Size:        32,
+			}})
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			err := call()
+			require.ErrorIs(t, err, ErrTelemetryHostUpdateRequired)
+			require.Equal(t, 409, infraerrors.Code(err))
+			require.Equal(t, "CUSTOM_PLUGIN_HOST_UPDATE_REQUIRED", infraerrors.Reason(err))
+			require.Contains(t, infraerrors.Message(err), "用户遥测扩展宿主")
+		})
+	}
+
+	require.Equal(t, "unchanged", cache.data, "blocked operations must not write the update cache")
+	require.Zero(t, client.latestCalls, "blocked update must not query a release before returning")
+	require.Zero(t, client.recentCalls, "blocked rollback must not query releases before returning")
+	require.Zero(t, client.downloads, "blocked operations must not download an archive")
+	require.Zero(t, client.checksums, "blocked operations must not fetch or verify a checksum")
+}
+
+func TestTelemetryHostCheckUpdateRemainsReadOnlyAndWarnsWithoutChangingHasUpdate(t *testing.T) {
+	client := &telemetryGuardGitHubClient{latest: &GitHubRelease{TagName: "v0.2.15"}}
+	svc := NewUpdateService(&updateServiceCacheStub{}, client, "0.2.14", "telemetry")
+
+	info, err := svc.CheckUpdate(context.Background(), true)
+
+	require.NoError(t, err)
+	require.True(t, info.HasUpdate, "CheckUpdate must still report the available version")
+	require.Equal(t, "0.2.15", info.LatestVersion)
+	require.Contains(t, info.Warning, "用户遥测扩展宿主")
+	require.Zero(t, client.downloads)
+	require.Zero(t, client.checksums)
+}
+
+func TestTelemetryWarningMergesWithExistingWarning(t *testing.T) {
+	info := &UpdateInfo{Warning: "Using cached data: upstream unavailable"}
+	svc := NewUpdateService(nil, nil, "0.2.14", "telemetry")
+
+	svc.addTelemetryWarning(info)
+
+	require.Contains(t, info.Warning, "Using cached data: upstream unavailable")
+	require.Contains(t, info.Warning, "用户遥测扩展宿主")
+	require.Equal(t, info.Warning, mergeUpdateWarnings(info.Warning, telemetryHostUpdateWarning))
+}

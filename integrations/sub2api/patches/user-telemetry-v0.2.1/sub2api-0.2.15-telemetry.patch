+package telemetry
+
+import (
+	"encoding/json"
+	public "github.com/Wei-Shaw/sub2api/pkg/usertelemetry"
+	"strings"
+	"testing"
+	"time"
+)
+
+func extensionFixture() (public.Query, public.Snapshot) {
+	q := public.Query{UserIDs: []string{"42"}, PageSize: 2, Timezone: "Asia/Shanghai", Start: "2026-10-01T00:00:00+08:00", End: "2026-10-02T00:00:00+08:00"}
+	var s public.Snapshot
+	_ = json.Unmarshal(snapshot(q), &s)
+	total, observed, upstream := "18446744073709551644", "2026-10-09T00:10:00+08:00", "actual-model"
+	s.Users[0].TokenUsage = public.TokenUsage{Total: &total, Today: &public.DailyTokenUsage{Date: "2026-10-09", Start: "2026-10-09T00:00:00+08:00", End: observed, Total: &total, Quality: "fresh", ObservedAt: &observed}, Yesterday: &public.DailyTokenUsage{Date: "2026-10-08", Start: "2026-10-08T00:00:00+08:00", End: "2026-10-09T00:00:00+08:00", Total: &total, Quality: "fresh", ObservedAt: &observed}}
+	s.Users[0].ActiveModels = &public.ActiveModelSnapshot{Models: []public.ActiveModel{{RequestedModel: "public-model", UpstreamModel: &upstream, Requests: 2}, {RequestedModel: "public-model-2", Requests: 1}}, Quality: "partial", ObservedAt: &observed}
+	return q, s
+}
+func TestExtensionRoundtripLargeNumbersAndUnknownFieldStripping(t *testing.T) {
+	q, s := extensionFixture()
+	raw, _ := json.Marshal(s)
+	raw = []byte(strings.Replace(string(raw), `"requested_model":"public-model"`, `"secret":"DO_NOT_OUTPUT","requested_model":"public-model"`, 1))
+	out, err := FilterSnapshot(raw, q)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(out), "DO_NOT_OUTPUT") || !strings.Contains(string(out), "18446744073709551644") || !strings.Contains(string(out), "actual-model") {
+		t.Fatal("allowlist or precision lost")
+	}
+}
+func TestExtensionRejectMalformedHostFields(t *testing.T) {
+	cases := map[string]func(*public.Snapshot){
+		"numeric":           func(s *public.Snapshot) { v := "-1"; s.Users[0].TokenUsage.Today.Total = &v },
+		"unknownIsNotZero":  func(s *public.Snapshot) { s.Users[0].TokenUsage.Today.Quality = "unavailable" },
+		"wrongDay":          func(s *public.Snapshot) { s.Users[0].TokenUsage.Today.Date = "2026-10-08" },
+		"wrongYesterdayEnd": func(s *public.Snapshot) { s.Users[0].TokenUsage.Yesterday.End = "2026-10-09T01:00:00+08:00" },
+		"missingPair":       func(s *public.Snapshot) { s.Users[0].TokenUsage.Yesterday = nil },
+		"controlModel":      func(s *public.Snapshot) { s.Users[0].ActiveModels.Models[0].RequestedModel = "model\nSECRET" },
+		"count":             func(s *public.Snapshot) { s.Users[0].ActiveModels.Models[0].Requests = 10001 },
+		"duplicate": func(s *public.Snapshot) {
+			s.Users[0].ActiveModels.Models = append(s.Users[0].ActiveModels.Models, s.Users[0].ActiveModels.Models[0])
+		},
+		"unknownActiveHasData": func(s *public.Snapshot) { s.Users[0].ActiveModels.Quality = "unavailable" },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			q, s := extensionFixture()
+			mutate(&s)
+			raw, _ := json.Marshal(s)
+			if _, err := FilterSnapshot(raw, q); err == nil {
+				t.Fatal("accepted malformed extension")
+			}
+		})
+	}
+}
+func TestExtensionOldHostAndUnavailableRemainCompatible(t *testing.T) {
+	q, s := extensionFixture()
+	s.Users[0].TokenUsage.Today = nil
+	s.Users[0].TokenUsage.Yesterday = nil
+	s.Users[0].ActiveModels = nil
+	raw, _ := json.Marshal(s)
+	if _, err := FilterSnapshot(raw, q); err != nil {
+		t.Fatal(err)
+	}
+	q, s = extensionFixture()
+	for _, d := range []*public.DailyTokenUsage{s.Users[0].TokenUsage.Today, s.Users[0].TokenUsage.Yesterday} {
+		d.Quality = "unavailable"
+		d.Total = nil
+		d.ObservedAt = nil
+	}
+	s.Users[0].ActiveModels = &public.ActiveModelSnapshot{Quality: "unavailable"}
+	raw, _ = json.Marshal(s)
+	if _, err := FilterSnapshot(raw, q); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestExtensionDSTCalendarUsesAddDate(t *testing.T) {
+	q, s := extensionFixture()
+	q.Timezone = "America/New_York"
+	s.Window.Timezone = q.Timezone
+	loc, _ := time.LoadLocation(q.Timezone)
+	now := time.Date(2026, 3, 9, 2, 0, 0, 0, loc)
+	start := time.Date(2026, 3, 9, 0, 0, 0, 0, loc)
+	today, yesterday := s.Users[0].TokenUsage.Today, s.Users[0].TokenUsage.Yesterday
+	today.Date = start.Format("2006-01-02")
+	today.Start = start.Format(time.RFC3339)
+	today.End = now.Format(time.RFC3339)
+	yesterday.Date = start.AddDate(0, 0, -1).Format("2006-01-02")
+	yesterday.Start = start.AddDate(0, 0, -1).Format(time.RFC3339)
+	yesterday.End = today.Start
+	raw, _ := json.Marshal(s)
+	if _, err := FilterSnapshot(raw, q); err != nil {
+		t.Fatal(err)
+	}
+}

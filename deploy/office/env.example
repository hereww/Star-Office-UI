# Place a copy OUTSIDE the release under /opt/star-office-ui/private/office.env.
# chmod 600; never commit it, print `compose config`, or include it in archives.
OFFICE_IMAGE=SET_LOCAL_IMMUTABLE_OFFICE_IMAGE
OFFICE_RELEASE_ID=SET_PACKAGED_RELEASE_ID
PYTHON_BASE=SET_ALREADY_CACHED_PYTHON_3_11_IMAGE_DIGEST
OFFICE_APP_PORT=19011
OFFICE_ADMIN_USERNAME=admin
OFFICE_ADMIN_SECRET=SET_PRIVATE_INDEPENDENT_OFFICE_SIGNING_SECRET_AT_LEAST_24_CHARS
FLASK_SECRET_KEY=SET_PRIVATE_RANDOM_SIGNING_SECRET_AT_LEAST_24_CHARS
ASSET_DRAWER_PASS=SET_PRIVATE_STRONG_LEGACY_PASSWORD
OFFICE_ADMIN_HASH_FILE=/opt/star-office-ui/private/admin-password.hash
OFFICE_CONSUMER_FILE=/opt/star-office-ui/private/office-consumer.token
# HTTPS default. HTTP is permitted ONLY for the verified same-host IP with explicit flag.
OFFICE_SUB2API_BASE_URL=https://SET_SUB2API_HTTPS_ORIGIN
OFFICE_ALLOW_HTTP=0
OFFICE_INSTALLATION_ID=1
# Approved profile ceiling. Explicit nonempty canonical subsets are allowed; never widen automatically.
# New SQLite store mapping: 4->desk-09, 7->desk-10, 8->desk-11, 1->desk-12.
# GUI authorization is not a dedicated consumer credential; provisioning remains the main-thread gate.
OFFICE_USER_IDS=1,4,7,8
OFFICE_CREDENTIAL_EXPIRES_AT=SET_UTC_ISO_EXPIRY_FROM_ISSUER
OFFICE_UPSTREAM_CA_FILE=/opt/star-office-ui/private/upstream-ca-bundle.pem
OFFICE_SERVER_CA_FILE=/opt/star-office-ui/private/office-root-ca.pem
# Main-thread deployment gates, not application options. Change only after evidence.
OFFICE_CLIENT_MIGRATION_APPROVED=0
OFFICE_FIREWALL_AUDITED=0
OFFICE_BACKUP_VERIFIED=0

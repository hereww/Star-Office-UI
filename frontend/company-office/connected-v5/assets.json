{
  "schemaVersion": 5,
  "animationMode": "full-frame-plus-screen-effects",
  "referenceAssets": "../reference-v3/assets.json",
  "reuseOriginalCharacters": true,
  "furnitureMode": "connected-benches",
  "manifestContractVersion": 2,
  "faceClockFrames": {
    "working": 60,
    "idle": 36,
    "syncing": 60,
    "error": 12
  },
  "screenOverlay": "./screen-overlay.mjs",
  "screenAnimationContract": {
    "mode": "screen-only",
    "activeStates": [
      "writing",
      "researching",
      "executing",
      "syncing",
      "error"
    ],
    "staticStates": [
      "idle"
    ],
    "fps": 12,
    "content": "code-editor-search-terminal",
    "rearScreens": "led-only",
    "keyboardInteraction": false
  },
  "roomAnimationContract": {
    "schemaVersion": 1,
    "frameSize": [
      96,
      96
    ],
    "grid": [
      4,
      3
    ],
    "frameCount": 12,
    "fps": 8,
    "transparent": true,
    "loop": true,
    "audio": false
  },
  "characterTemplate": "./character-template.json",
  "characterAnimationMode": "full-frame",
  "fullFrameContract": {
    "frameSize": [
      192,
      192
    ],
    "grid": [
      4,
      3
    ],
    "frameCount": 12,
    "fps": 12,
    "transparent": true,
    "runtimeComposition": "one-complete-character-frame"
  }
}
